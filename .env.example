# ===========================================
# 🔐 ENVIRONMENT VARIABLES - TEMPLATE
# ===========================================

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/database?schema=public"

# JWT SECRETS (CAMBIAR EN PRODUCCIÓN)
JWT_SECRET="your-super-secret-jwt-key-minimum-64-chars-for-security-purposes"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-minimum-64-characters-for-production"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"

# Rate Limiting & Security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# App Configuration
PORT=5000
NODE_ENV="development"

# Redis Configuration
REDIS_URL="redis://default:password@localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SESSION_TTL=604800

# Security Settings
BCRYPT_ROUNDS=12
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# Email Configuration
EMAIL_HOST=""
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM="noreply@localhost"
BACKEND_URL="http://localhost:3000"

# OAuth Providers (Opcional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Development Debug
DEBUG=true
LOG_LEVEL="debug"

# Grafana (Observabilidad)
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD="change-this-password"