// ════════════════════════════════════════════════════════════════════
// SORTEOS por redes sociales (F1/F2)
// Las empresas sortean productos en Facebook/TikTok/IG y hoy registran
// ganadores en papel/WhatsApp. Aquí: registro de ganadores con premio
// (vínculo a inventario OPCIONAL — solo premios valiosos descuentan
// stock) y envío trackeable (agencia + foto del ticket vía Archivo
// polimórfico entidadTipo=SORTEO_PREMIO). El ganador es una cuenta del
// app (Usuario, mismo patrón que PedidoMarketplace.compradorId) y ve
// sus premios en la sección "Mis Premios".
// F3 (venta de tickets online) NO está modelada — ver doc del proyecto.
// ════════════════════════════════════════════════════════════════════

enum EstadoSorteo {
  ABIERTO
  CERRADO
}

enum CanalSorteo {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  WHATSAPP
  OTRO
}

enum EstadoPremioSorteo {
  REGISTRADO // ganador registrado, premio por preparar
  PREPARANDO // alistando el premio
  ENVIADO // despachado (agencia) o listo para retiro en tienda
  ENTREGADO // el ganador lo tiene
  ANULADO // registro anulado (repone stock si descontó)
}

enum ModalidadEntregaPremio {
  ENVIO_AGENCIA // provincia: Shalom/Olva/etc.
  RETIRO_TIENDA // ganador local recoge en la sede
}

// SORTEO clasico (se sortea entre participantes) o DINAMICA (el
// participante paga, juega — canasta, etc. — y lo que saca YA lo gano:
// cada jugador termina registrado como ganador con su premio).
enum TipoSorteo {
  SORTEO
  DINAMICA
}

model Sorteo {
  id          String       @id @default(cuid())
  empresaId   String
  sedeId      String? // sede que organiza/despacha (stock sale de aquí)
  tipo        TipoSorteo   @default(SORTEO)
  titulo      String
  descripcion String?
  canal       CanalSorteo  @default(OTRO)
  fechaSorteo DateTime     @default(now())
  estado      EstadoSorteo @default(ABIERTO)
  // Precio de la participación ("jugada") — default para cada ganador
  // registrado; la suma de las participaciones registradas es lo
  // recaudado del sorteo. Imagen promocional via Archivo (SORTEO).
  precioParticipacion Decimal? @db.Decimal(14, 2)
  creadoPorId String

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  empresa       Empresa              @relation("SorteosEmpresa", fields: [empresaId], references: [id], onDelete: Cascade)
  premios       SorteoPremio[]
  participantes SorteoParticipante[]

  @@index([empresaId, estado])
  @@index([empresaId, fechaSorteo])
}

enum EstadoParticipanteSorteo {
  PENDIENTE_PAGO // registrado por el bot de WhatsApp, falta validar pago
  ACTIVO // pago validado por la empresa (se le asigna numeroTicket)
  RECHAZADO
}

// Participante captado por el BOT de WhatsApp (Fase A: el pago se valida
// por fuera y la empresa lo activa desde el app; el bot le confirma su
// numero de ticket). Un DNI participa una vez por sorteo.
model SorteoParticipante {
  id        String @id @default(cuid())
  empresaId String
  sorteoId  String
  // Numero de WhatsApp del participante (formato 51XXXXXXXXX, viene del
  // remitente del chat — no se le pide).
  celular String
  nombre  String
  dni     String
  estado  EstadoParticipanteSorteo @default(PENDIENTE_PAGO)
  // Correlativo por sorteo, asignado al ACTIVAR (orden de validacion).
  numeroTicket Int?
  activadoEn   DateTime?
  // Datos de envio capturados por el bot al registrarse (opcionales):
  // si gana, la entrega ya esta lista y prellenan el registro del ganador.
  agenciaNombre       String?
  destinoDepartamento String?
  destinoProvincia    String?
  agenciaDireccion    String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  sorteo Sorteo @relation(fields: [sorteoId], references: [id], onDelete: Cascade)

  @@unique([sorteoId, dni])
  @@index([empresaId, celular])
  @@index([sorteoId, estado])
}

model SorteoPremio {
  id        String @id @default(cuid())
  sorteoId  String
  empresaId String // denormalizado: listados por empresa sin join

  // Ganador = cuenta del app. El registro por DNI (Factiliza) reusa el
  // flujo de clientes que crea Persona+Usuario automáticamente.
  ganadorId String
  // Snapshot de los datos con los que se registró el premio (la Persona
  // puede editar sus datos después; el acta del sorteo no debe mutar).
  ganadorDni     String?
  ganadorNombre  String
  ganadorCelular String?

  // Premio: descripción SIEMPRE. Producto/variante OPCIONALES — solo
  // cuando la empresa quiere descontar stock (premios valiosos, ej.
  // laptop). Sorteos de "productos varios pequeños" van sin vínculo.
  descripcion       String
  productoId        String?
  varianteId        String?
  cantidad          Int     @default(1)
  // MovimientoStock de la SALIDA_SORTEO (trazabilidad kardex↔premio).
  movimientoStockId String?

  // Lo que ESTE ganador pagó por su participación (prellenado con
  // Sorteo.precioParticipacion, editable — el último puede pagar menos).
  montoParticipacion Decimal? @db.Decimal(14, 2)

  modalidad     ModalidadEntregaPremio @default(RETIRO_TIENDA)
  agenciaNombre String? // Shalom / Olva / Marvisur / ...
  // Destino desglosado como se habla: "envío a San Martín, Tarapoto".
  destinoDepartamento String?
  destinoProvincia    String?
  agenciaDireccion    String? // dirección de la oficina de la agencia destino
  // Datos que entrega la agencia al despachar — el ganador los ve en
  // Mis Premios (la CLAVE es lo que pide la agencia para entregar).
  envioNumeroOrden String?
  envioCodigo      String?
  envioClave       String?
  // Rótulo de envío ya impreso (chip "IMPRESO" en la card del premio).
  rotuloImpresoEn DateTime?
  // Ticket enviado por WhatsApp automático al ganador (chip en la card).
  whatsappEnviadoEn DateTime?

  estado        EstadoPremioSorteo @default(REGISTRADO)
  enviadoEn     DateTime?
  entregadoEn   DateTime?
  observaciones String?

  registradoPorId String
  creadoEn        DateTime @default(now())
  actualizadoEn   DateTime @updatedAt

  sorteo  Sorteo  @relation(fields: [sorteoId], references: [id], onDelete: Cascade)
  ganador Usuario @relation("PremiosGanador", fields: [ganadorId], references: [id])

  @@index([empresaId, estado])
  @@index([ganadorId])
  @@index([sorteoId])
}
