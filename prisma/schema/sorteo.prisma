// ════════════════════════════════════════════════════════════════════
// SORTEOS por redes sociales (F1/F2)
// Las empresas sortean productos en Facebook/TikTok/IG y hoy registran
// ganadores en papel/WhatsApp. Aquí: registro de ganadores con premio
// (vínculo a inventario OPCIONAL — solo premios valiosos descuentan
// stock) y envío trackeable (agencia + foto del ticket vía Archivo
// polimórfico entidadTipo=SORTEO_PREMIO). El ganador es una cuenta del
// app (Usuario, mismo patrón que PedidoMarketplace.compradorId) y ve
// sus premios en la sección "Mis Premios".
// F3 (venta de tickets online) NO está modelada — ver doc del proyecto.
// ════════════════════════════════════════════════════════════════════

enum EstadoSorteo {
  ABIERTO
  CERRADO // ventas cerradas — la rifa está JUGANDO (se sortean tickets)
  FINALIZADO // ya se jugó todo: cerrado definitivo
}

enum CanalSorteo {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  WHATSAPP
  OTRO
}

enum EstadoPremioSorteo {
  REGISTRADO // ganador registrado, premio por preparar
  PREPARANDO // alistando el premio
  ENVIADO // despachado (agencia) o listo para retiro en tienda
  ENTREGADO // el ganador lo tiene
  ANULADO // registro anulado (repone stock si descontó)
}

enum ModalidadEntregaPremio {
  ENVIO_AGENCIA // provincia: Shalom/Olva/etc.
  RETIRO_TIENDA // ganador local recoge en la sede
}

// SORTEO clasico (se sortea entre participantes) o DINAMICA (el
// participante paga, juega — canasta, etc. — y lo que saca YA lo gano:
// cada jugador termina registrado como ganador con su premio).
enum TipoSorteo {
  SORTEO
  DINAMICA
  BINGO // cartillas 5×5 B-I-N-G-O + bolillas con detección automática
}

model Sorteo {
  id          String       @id @default(cuid())
  empresaId   String
  sedeId      String? // sede que organiza/despacha (stock sale de aquí)
  tipo        TipoSorteo   @default(SORTEO)
  titulo      String
  descripcion String?
  canal       CanalSorteo  @default(OTRO)
  // Fecha en que SE JUEGA el sorteo (rifas: el día del ánfora).
  fechaSorteo DateTime     @default(now())
  // Ventana de VENTA de tickets (informativa — el cierre es manual).
  ventaDesde  DateTime?
  ventaHasta  DateTime?
  // BINGO: bolillas cantadas en orden (array de ints 1-75).
  bolillas    Json?
  // Links del LIVE (el creador los pega al arrancar la transmisión):
  // [{plataforma: 'FACEBOOK'|'TIKTOK'|..., url}] — el bot los comparte
  // para que el participante entre directo sin buscar.
  liveLinks   Json?
  estado      EstadoSorteo @default(ABIERTO)
  // true = se reabrió tras cerrarse (solo para REGULARIZAR en el app):
  // el bot de WhatsApp lo ignora por completo — no lo ofrece en el menú
  // ni notifica activaciones de sus participantes.
  reabierto   Boolean      @default(false)
  // Precio de la participación ("jugada") — default para cada ganador
  // registrado; la suma de las participaciones registradas es lo
  // recaudado del sorteo. Imagen promocional via Archivo (SORTEO).
  precioParticipacion Decimal? @db.Decimal(14, 2)
  creadoPorId String

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  empresa         Empresa                @relation("SorteosEmpresa", fields: [empresaId], references: [id], onDelete: Cascade)
  premios         SorteoPremio[]
  participantes   SorteoParticipante[]
  premiosCatalogo SorteoPremioCatalogo[]

  @@index([empresaId, estado])
  @@index([empresaId, fechaSorteo])
}

enum EstadoParticipanteSorteo {
  PENDIENTE_PAGO // registrado por el bot de WhatsApp, falta validar pago
  ACTIVO // pago validado por la empresa (se le asigna numeroTicket)
  RECHAZADO
}

// Participante captado por el BOT de WhatsApp (Fase A: el pago se valida
// por fuera y la empresa lo activa desde el app; el bot le confirma su
// numero de ticket). Un DNI participa una vez por sorteo.
model SorteoParticipante {
  id        String @id @default(cuid())
  empresaId String
  sorteoId  String
  // Numero de WhatsApp del participante (formato 51XXXXXXXXX, viene del
  // remitente del chat — no se le pide).
  celular String
  nombre  String
  dni     String
  estado  EstadoParticipanteSorteo @default(PENDIENTE_PAGO)
  // Correlativo por sorteo, asignado al ACTIVAR (orden de validacion).
  numeroTicket Int?
  activadoEn   DateTime?
  // COMPRA de tickets (tipo SORTEO): "quiero 20" crea 20 filas con el
  // mismo compraId — un solo pago, validacion en bloque (tickets
  // consecutivos) y una sola confirmacion de WhatsApp.
  compraId String?
  // BINGO: grilla 5×5 de la cartilla (matriz de ints, 0 = centro LIBRE),
  // generada al ACTIVAR; y logros ya detectados (["LINEA","BINGO"]) para
  // no re-alertar el mismo logro con cada bolilla.
  cartilla    Json?
  bingoLogros Json?
  // REGALO 🎁: quien recibe el premio si NO es el propio jugador
  // (el juega, otra persona lo recibe en otra sede de la agencia).
  recibeNombre String?
  recibeDni    String? // la agencia lo pide al entregar
  // Quién hará el YAPE si NO es el propio participante (el bot lo
  // pregunta tras las instrucciones de pago; null = paga él mismo) —
  // la empresa lo ve al validar para cuadrar la notificación de Yape.
  pagadorNombre  String?
  pagadorCelular String?
  // Datos de envio capturados por el bot al registrarse (opcionales):
  // si gana, la entrega ya esta lista y prellenan el registro del ganador.
  agenciaNombre       String?
  destinoDepartamento String?
  destinoProvincia    String?
  agenciaDireccion    String?
  // El CLIENTE confirmo/dio su direccion con el bot (opcion "1 - es la
  // misma", direccion nueva tipeada, regalo, etc.). null = la direccion
  // solo fue COPIADA de una jugada anterior (sin confirmar) o no hay.
  // Chip "Direccion confirmada" en la card del participante.
  direccionConfirmadaEn DateTime?
  // "Yape en el aire": el cliente declaro (opcion 3 del bot) que YA
  // yapeo ANTES de registrarse. Las sugerencias del admin consideran
  // pagos anteriores al registro para esta participacion — pero NUNCA
  // se auto-valida (seguridad: cualquiera pudo ver el monto en el live).
  yapeAnticipadoEn DateTime?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  sorteo Sorteo @relation(fields: [sorteoId], references: [id], onDelete: Cascade)

  // Un DNI puede participar VARIAS veces en el mismo sorteo (compra
  // multiple de tickets) — cada fila es una participacion/ticket.
  @@index([sorteoId, dni])
  @@index([empresaId, celular])
  @@index([sorteoId, estado])
  @@index([compraId])
}

model SorteoPremio {
  id        String @id @default(cuid())
  sorteoId  String
  empresaId String // denormalizado: listados por empresa sin join

  // Ganador = cuenta del app. El registro por DNI (Factiliza) reusa el
  // flujo de clientes que crea Persona+Usuario automáticamente.
  ganadorId String
  // Snapshot de los datos con los que se registró el premio (la Persona
  // puede editar sus datos después; el acta del sorteo no debe mutar).
  ganadorDni     String?
  ganadorNombre  String
  ganadorCelular String?

  // Premio: descripción SIEMPRE. Producto/variante OPCIONALES — solo
  // cuando la empresa quiere descontar stock (premios valiosos, ej.
  // laptop). Sorteos de "productos varios pequeños" van sin vínculo.
  descripcion       String
  productoId        String?
  varianteId        String?
  cantidad          Int     @default(1)
  // MovimientoStock de la SALIDA_SORTEO (trazabilidad kardex↔premio).
  movimientoStockId String?

  // Lo que ESTE ganador pagó por su participación (prellenado con
  // Sorteo.precioParticipacion, editable — el último puede pagar menos).
  montoParticipacion Decimal? @db.Decimal(14, 2)

  modalidad     ModalidadEntregaPremio @default(RETIRO_TIENDA)
  agenciaNombre String? // Shalom / Olva / Marvisur / ...
  // Destino desglosado como se habla: "envío a San Martín, Tarapoto".
  destinoDepartamento String?
  destinoProvincia    String?
  agenciaDireccion    String? // dirección de la oficina de la agencia destino
  // Datos que entrega la agencia al despachar — el ganador los ve en
  // Mis Premios (la CLAVE es lo que pide la agencia para entregar).
  envioNumeroOrden String?
  envioCodigo      String?
  envioClave       String?
  // Rótulo de envío ya impreso (chip "IMPRESO" en la card del premio).
  rotuloImpresoEn DateTime?
  // Participacion (SorteoParticipante) que origino este premio — permite
  // un premio POR PARTICIPACION cuando el mismo DNI juega varias veces.
  participanteId String? @unique
  // REGALO 🎁: quien recibe (null = el propio ganador). El rotulo y la
  // entrega en agencia usan estos datos como destinatario.
  recibeNombre String?
  recibeDni    String?
  // Premio en EFECTIVO 💸: no hay envio por agencia — se le yapea al
  // ganador. abonoNumero = numero que el ganador confirmo con el bot
  // (null = aun no confirma; default su celular de WhatsApp).
  esEfectivo  Boolean @default(false)
  abonoNumero String?
  // Ticket enviado por WhatsApp automático al ganador (chip en la card).
  whatsappEnviadoEn DateTime?

  estado        EstadoPremioSorteo @default(REGISTRADO)
  enviadoEn     DateTime?
  entregadoEn   DateTime?
  observaciones String?

  // Item del CATALOGO de premios de la rifa que se adjudico al salir
  // este ticket del anfora (null = premio registrado a mano).
  catalogoId String?

  registradoPorId String
  creadoEn        DateTime @default(now())
  actualizadoEn   DateTime @updatedAt

  sorteo   Sorteo                @relation(fields: [sorteoId], references: [id], onDelete: Cascade)
  ganador  Usuario               @relation("PremiosGanador", fields: [ganadorId], references: [id])
  catalogo SorteoPremioCatalogo? @relation(fields: [catalogoId], references: [id], onDelete: SetNull)

  @@index([empresaId, estado])
  @@index([ganadorId])
  @@index([sorteoId])
  @@index([catalogoId])
}

// Catalogo de premios de la RIFA con anfora (tipo SORTEO): se registran
// ANTES de jugar ("3× S/ 500 en efectivo", "2× celular"). Cada unidad se
// adjudica al salir un ticket ganador (SorteoPremio.catalogoId); imagen
// opcional via Archivo (SORTEO_PREMIO_CATALOGO / PRINCIPAL).
model SorteoPremioCatalogo {
  id          String @id @default(cuid())
  empresaId   String
  sorteoId    String
  descripcion String
  cantidad    Int    @default(1)
  // true = premio en EFECTIVO (se yapea, sin envio por agencia); el bot
  // le pide al ganador confirmar su numero en vez de la direccion.
  esEfectivo  Boolean @default(false)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  sorteo  Sorteo         @relation(fields: [sorteoId], references: [id], onDelete: Cascade)
  premios SorteoPremio[]

  @@index([sorteoId])
}
