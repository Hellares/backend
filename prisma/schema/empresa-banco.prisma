// =========================================
// CUENTAS BANCARIAS DE LA EMPRESA
// =========================================

model EmpresaBanco {
  id        String @id @default(cuid())
  empresaId String

  nombreBanco  String // BCP, Interbank, BBVA, Scotiabank, etc.
  tipoCuenta   TipoCuenta // Reutiliza enum de proveedor.prisma
  numeroCuenta String
  cci          String? // Código interbancario
  moneda       String     @default("PEN")
  titular      String? // Nombre del titular
  esPrincipal  Boolean    @default(false)
  isActive     Boolean    @default(true)

  // Saldo. Default 0 (NUNCA null): un `increment`/`decrement` de Prisma sobre
  // null se pierde (null + n = null), lo que hacía perder cobros del barrido
  // cuando la cuenta recién creada tenía saldo null.
  saldoActual Decimal? @default(0) @db.Decimal(12, 2)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  empresa              Empresa               @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  pagosGastoRecurrente PagoGastoRecurrente[]
  pagosCompra          PagoCompra[]
  pagosVenta           PagoVenta[]
  cuentasRecaudacion   CuentaRecaudacion[]
  ajustes              AjusteBanco[]

  @@index([empresaId])
  @@index([empresaId, isActive])
}

/// De dónde nace un ajuste manual sobre el saldo de un banco.
enum OrigenAjusteBanco {
  CONCILIACION // El usuario fijó el saldo real del extracto → se asienta el delta.
  AJUSTE_MANUAL // Comisión, interés, corrección, etc.
}

/// Historial de ajustes manuales/conciliaciones del saldo de una cuenta
/// bancaria. El saldo lo mueve el sistema (cobros +, pagos −); cualquier
/// edición manual queda registrada acá con motivo y saldo antes/después.
model AjusteBanco {
  id            String             @id @default(cuid())
  empresaId     String
  bancoId       String
  tipo          TipoMovimientoCaja // INGRESO (suma) | EGRESO (resta)
  monto         Decimal            @db.Decimal(12, 2)
  motivo        String
  origen        OrigenAjusteBanco
  saldoAnterior Decimal            @db.Decimal(12, 2)
  saldoNuevo    Decimal            @db.Decimal(12, 2)
  usuarioId     String?
  creadoEn      DateTime           @default(now())

  banco EmpresaBanco @relation(fields: [bancoId], references: [id], onDelete: Cascade)

  @@index([empresaId, bancoId])
  @@index([bancoId, creadoEn(sort: Desc)])
}

/// Cuenta bancaria donde se recauda cada método de pago digital. Al cerrar
/// caja, el total de cada método cae en su banco (Yape→BCP, Plin→Interbank…).
/// EFECTIVO no se mapea (va a la bóveda/Tesorería). Una cuenta por método.
model CuentaRecaudacion {
  id         String          @id @default(cuid())
  empresaId  String
  metodoPago MetodoPagoVenta
  bancoId    String

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  empresa Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  banco   EmpresaBanco @relation(fields: [bancoId], references: [id], onDelete: Cascade)

  @@unique([empresaId, metodoPago])
  @@index([empresaId])
  @@index([bancoId])
}
