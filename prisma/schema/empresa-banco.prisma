// =========================================
// CUENTAS BANCARIAS DE LA EMPRESA
// =========================================

model EmpresaBanco {
  id        String @id @default(cuid())
  empresaId String

  nombreBanco  String // BCP, Interbank, BBVA, Scotiabank, etc.
  tipoCuenta   TipoCuenta // Reutiliza enum de proveedor.prisma
  numeroCuenta String
  cci          String? // Código interbancario
  moneda       String     @default("PEN")
  titular      String? // Nombre del titular
  esPrincipal  Boolean    @default(false)
  isActive     Boolean    @default(true)

  // Saldo (actualización manual o por conciliación)
  saldoActual Decimal? @db.Decimal(12, 2)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  empresa              Empresa               @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  pagosGastoRecurrente PagoGastoRecurrente[]
  pagosCompra          PagoCompra[]

  @@index([empresaId])
  @@index([empresaId, isActive])
}
