/// Configuración de la integración con api-yape (validación de pagos Yape/Plin),
/// una por empresa. Cada empresa de Syncronize = una cuenta en api-yape.
model IntegracionYape {
  id            String   @id @default(cuid())
  empresaId     String   @unique
  apiBaseUrl    String // https://yape-beta.syncronize.net.pe (beta) | https://yape.syncronize.net.pe (prod)
  accountApiKey String // acc_... : key de cuenta en api-yape (para crear cobros)
  accountId     String   @unique // id de la cuenta en api-yape (mapea el webhook entrante a la empresa, 1:1)
  webhookSecret String // whsec_... : verifica la firma HMAC del webhook entrante
  habilitado    Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("integracion_yape")
}
