model Servicio {
  id                    String   @id @default(cuid())
  empresaId             String
  sedeId                String?
  empresaCategoriaId    String?
  unidadMedidaId        String? // Unidad de medida del servicio (ej: hora, día, sesión)
  codigoEmpresa         String   @unique
  codigoSistema         String   @unique
  nombre                String
  descripcion           String?
  precio                Decimal? @db.Decimal(10, 2)
  precioPorHora         Decimal? @db.Decimal(10, 2)
  duracionMinutos       Int?
  duracionHoras         Decimal? @db.Decimal(5, 2)
  requiereReserva       Boolean  @default(false)
  requiereDeposito      Boolean  @default(false)
  depositoPorcentaje    Decimal? @db.Decimal(5, 2)
  antigenciaMinimaHoras Int?
  videoUrl              String?
  impuestoPorcentaje    Decimal? @db.Decimal(5, 2)
  comisionTecnico       Decimal? @db.Decimal(5, 2)

  // Campos para Marketplace
  visibleMarketplace Boolean @default(true)
  destacado          Boolean @default(false)
  ordenMarketplace   Int?

  // Sistema de Ofertas
  enOferta          Boolean   @default(false)
  precioOferta      Decimal?  @db.Decimal(10, 2)
  fechaInicioOferta DateTime?
  fechaFinOferta    DateTime?

  isActive            Boolean                  @default(true)
  deletedAt           DateTime?
  creadoEn            DateTime                 @default(now())
  actualizadoEn       DateTime                 @updatedAt
  detallesComprobante DetalleComprobante[]     @relation("DetalleServicio")
  empresaCategoria    EmpresaCategoria?        @relation(fields: [empresaCategoriaId], references: [id])
  unidadMedida        EmpresaUnidadMedida?     @relation(fields: [unidadMedidaId], references: [id])
  empresa             Empresa                  @relation(fields: [empresaId], references: [id])
  sede                Sede?                    @relation(fields: [sedeId], references: [id])
  comprobantes        ComprobanteElectronico[] @relation("ServicioComprobante")
  cotizacionDetalles  CotizacionDetalle[]

  @@unique([empresaId, codigoEmpresa])
  @@index([empresaId])
  @@index([empresaId, codigoEmpresa])
  @@index([empresaCategoriaId])
  @@index([unidadMedidaId])
  @@index([sedeId])
  @@index([isActive])
  @@index([deletedAt])
  @@index([visibleMarketplace])
  @@index([destacado])
  @@index([ordenMarketplace])
  @@index([enOferta])
  @@index([fechaFinOferta])
}

model ConfiguracionCamposServicio {
  id            String            @id @default(cuid())
  empresaId     String
  nombre        String
  tipoCampo     TipoCampoServicio
  categoria     CategoriaCampo?
  descripcion   String?
  placeholder   String?
  esRequerido   Boolean           @default(false)
  defaultValue  String?
  opciones      Json?
  permiteOtro   Boolean           @default(false)
  isActive      Boolean           @default(true)
  orden         Int?
  creadoEn      DateTime          @default(now())
  actualizadoEn DateTime          @updatedAt
  empresa       Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, nombre])
  @@index([empresaId])
  @@index([categoria])
  @@index([isActive])
}

model TipoComponente {
  id                   String              @id @default(cuid())
  empresaId            String?
  nombre               String
  categoria            CategoriaComponente
  descripcion          String?
  datosTecnicos        Json?
  camposPersonalizados Json?
  isActive             Boolean             @default(true)
  esGlobal             Boolean             @default(false)
  creadoEn             DateTime            @default(now())
  actualizadoEn        DateTime            @updatedAt
  componentes          Componente[]
  modelosEquipos       ModeloEquipo[]
  empresa              Empresa?            @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@unique([empresaId, nombre])
  @@index([empresaId])
  @@index([categoria])
  @@index([isActive])
}

model ModeloEquipo {
  id               String          @id @default(cuid())
  empresaId        String?
  tipoComponenteId String
  marca            String
  modelo           String
  especificaciones Json?
  isActive         Boolean         @default(true)
  esGlobal         Boolean         @default(false)
  creadoEn         DateTime        @default(now())
  actualizadoEn    DateTime        @updatedAt
  empresa          Empresa?        @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  tipoComponente   TipoComponente  @relation(fields: [tipoComponenteId], references: [id])
  ordenesServicio  OrdenServicio[]

  @@unique([empresaId, marca, modelo])
  @@index([empresaId])
  @@index([tipoComponenteId])
  @@index([marca])
  @@index([isActive])
}

model Componente {
  id               String               @id @default(cuid())
  empresaId        String
  tipoComponenteId String
  codigo           String               @unique
  marca            String?
  modelo           String?
  numeroSerie      String?              @unique
  especificaciones Json?
  estado           EstadoComponente     @default(INGRESADO)
  ubicacion        String?
  costoCompra      Decimal?             @db.Decimal(10, 2)
  costoReparacion  Decimal?             @db.Decimal(10, 2)
  isActive         Boolean              @default(true)
  deletedAt        DateTime?
  creadoEn         DateTime             @default(now())
  actualizadoEn    DateTime             @updatedAt
  empresa          Empresa              @relation(fields: [empresaId], references: [id])
  tipoComponente   TipoComponente       @relation(fields: [tipoComponenteId], references: [id])
  servicios        ServicioComponente[]

  @@unique([empresaId, codigo])
  @@unique([empresaId, numeroSerie])
  @@index([empresaId])
  @@index([tipoComponenteId])
  @@index([estado])
  @@index([isActive])
  @@index([deletedAt])
}

model OrdenServicio {
  id                  String                  @id @default(cuid())
  empresaId           String
  clienteId           String
  tecnicoId           String?
  sedeId              String?
  codigo              String                  @unique
  tipoServicio        TipoServicio
  prioridad           PrioridadServicio       @default(NORMAL)
  tipoEquipo          String?
  marcaEquipo         String?
  numeroSerie         String?
  modeloEquipoId      String?
  diagnostico         Json?
  descripcionProblema String?
  sintomas            Json?
  presupuesto         Decimal?                @db.Decimal(10, 2)
  tiempoEstimado      Int?
  fechaEntrega        DateTime?
  estado              EstadoOrdenServicio     @default(RECIBIDO)
  estadoDiagnostico   EstadoDiagnostico       @default(PENDIENTE)
  notas               String?
  accesorios          Json?
  condicionEquipo     String?
  comprobanteId       String?
  creadoEn            DateTime                @default(now())
  actualizadoEn       DateTime                @updatedAt
  cliente             EmpresaPersona          @relation("OrdenServicioCliente", fields: [clienteId], references: [id])
  comprobante         ComprobanteElectronico? @relation(fields: [comprobanteId], references: [id])
  empresa             Empresa                 @relation(fields: [empresaId], references: [id])
  modeloEquipo        ModeloEquipo?           @relation(fields: [modeloEquipoId], references: [id])
  tecnico             Usuario?                @relation(fields: [tecnicoId], references: [id])
  componentes         ServicioComponente[]

  @@unique([empresaId, codigo])
  @@index([empresaId])
  @@index([clienteId])
  @@index([tecnicoId])
  @@index([estado])
  @@index([estadoDiagnostico])
  @@index([tipoServicio])
  @@index([fechaEntrega])
  // Índices compuestos para queries comunes
  @@index([empresaId, estado])
  @@index([empresaId, creadoEn])
  @@index([empresaId, estado, creadoEn])
}

model ServicioComponente {
  id                String                   @id @default(cuid())
  ordenServicioId   String
  componenteId      String
  tipoAccion        TipoAccionComponente
  estadoComponente  EstadoComponente         @default(INGRESADO)
  descripcionAccion String?
  detallesAccion    Json?
  costoAccion       Decimal?                 @db.Decimal(10, 2)
  tiempoAccion      Int?
  costoRepuestos    Decimal?                 @db.Decimal(10, 2)
  resultadoAccion   String?
  pruebaRealizada   Boolean                  @default(false)
  observaciones     String?
  garantiaMeses     Int?
  fechaGarantia     DateTime?
  creadoEn          DateTime                 @default(now())
  actualizadoEn     DateTime                 @updatedAt
  componente        Componente               @relation(fields: [componenteId], references: [id])
  ordenServicio     OrdenServicio            @relation(fields: [ordenServicioId], references: [id], onDelete: Cascade)
  comprobantes      ComprobanteElectronico[] @relation("ComprobanteComponente")

  @@index([ordenServicioId])
  @@index([componenteId])
  @@index([tipoAccion])
  @@index([estadoComponente])
}

enum TipoCampoServicio {
  TEXTO
  NUMERO
  EMAIL
  FECHA
  HORA
  TEXTO_AREA
  OPCION_SIMPLES
  OPCION_MULTIPLE
  CHECKBOX
  CHECKBOX_MULTIPLE
  ARCHIVO
  TELEFONO
  URL
}

enum CategoriaCampo {
  DIAGNOSTICO
  CLIENTE
  TECNICO
  COMPONENTE
  COSTOS
  TIEMPOS
  EQUIPO_CLIENTE
}

enum TipoServicio {
  REPARACION
  MANTENIMIENTO
  INSTALACION
  DIAGNOSTICO
  ACTUALIZACION
  LIMPIEZA
  RECUPERACION_DATOS
  CONFIGURACION
  CONSULTORIA
  FORMACION
  SOPORTE
}

enum PrioridadServicio {
  BAJA
  NORMAL
  ALTA
  URGENTE
  EMERGENCIA
}

enum EstadoOrdenServicio {
  RECIBIDO
  EN_DIAGNOSTICO
  ESPERANDO_APROBACION
  EN_REPARACION
  PENDIENTE_PIEZAS
  REPARADO
  LISTO_ENTREGA
  ENTREGADO
  CANCELADO
  FINALIZADO
}

enum EstadoDiagnostico {
  PENDIENTE
  EN_PROGRESO
  COMPLETADO
  REQUIERE_VISITA
  REQUIERE_PIEZAS
  EQUIPO_NO_REPARABLE
}

enum CategoriaComponente {
  HARDWARE
  SOFTWARE
  PERIFERICO
  ACCESORIOS
  CONSUMIBLES
}

enum EstadoComponente {
  NUEVO
  INGRESADO
  DISPONIBLE
  EN_USO
  EN_REPARACION
  DANADO
  OBSOLETO
  VENDIDO
  ELIMINADO
}

enum TipoAccionComponente {
  DIAGNOSTICAR
  REPARAR
  REEMPLAZAR
  LIMPIAR
  ACTUALIZAR
  INSTALAR
  DESMONTAR
  PROBAR
  CALIBRAR
}
