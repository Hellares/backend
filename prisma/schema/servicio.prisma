// ─── Avisos de Mantenimiento Preventivo ───

enum EstadoAviso {
  PENDIENTE
  NOTIFICADO
  ATENDIDO
  DESCARTADO
}

model ConfiguracionAvisoMantenimiento {
  id               String   @id @default(cuid())
  empresaId        String   @unique
  intervalos       Json // {"MANTENIMIENTO": 120, "REPARACION": 180, ...}
  diasAnticipacion Int      @default(7)
  habilitado       Boolean  @default(true)
  creadoEn         DateTime @default(now())
  actualizadoEn    DateTime @updatedAt
  empresa          Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
}

model AvisoMantenimiento {
  id                  String         @id @default(cuid())
  empresaId           String
  ordenServicioId     String
  clienteId           String
  tipoServicio        String
  equipoDescripcion   String?
  fechaUltimoServicio DateTime
  fechaRecomendada    DateTime
  estado              EstadoAviso    @default(PENDIENTE)
  ordenGeneradaId     String?
  notificadoEn        DateTime?
  notas               String?
  creadoEn            DateTime       @default(now())
  actualizadoEn       DateTime       @updatedAt
  empresa             Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  ordenServicio       OrdenServicio  @relation(fields: [ordenServicioId], references: [id])
  cliente             EmpresaPersona @relation(fields: [clienteId], references: [id])

  @@index([empresaId, estado])
  @@index([fechaRecomendada])
  @@index([clienteId])
  @@index([ordenServicioId])
}

// ─── Tercerización B2B de Servicios ───

enum OrigenOrden {
  CLIENTE_FINAL
  B2B_RECIBIDO
  B2B_ENVIADO
}

enum EstadoTercerizacion {
  PENDIENTE
  ACEPTADO
  RECHAZADO
  EN_PROCESO
  COMPLETADO
  CANCELADO
}

model TercerizacionServicio {
  id String @id @default(cuid())

  // Empresa que terceriza (origen)
  empresaOrigenId String
  ordenOrigenId   String        @unique
  empresaOrigen   Empresa       @relation("TercerizacionOrigen", fields: [empresaOrigenId], references: [id])
  ordenOrigen     OrdenServicio @relation("OrdenOrigen", fields: [ordenOrigenId], references: [id])

  // Empresa que ejecuta (destino)
  empresaDestinoId String
  ordenDestinoId   String?        @unique
  empresaDestino   Empresa        @relation("TercerizacionDestino", fields: [empresaDestinoId], references: [id])
  ordenDestino     OrdenServicio? @relation("OrdenDestino", fields: [ordenDestinoId], references: [id])

  // Estado del flujo
  estado EstadoTercerizacion @default(PENDIENTE)

  // Datos compartidos (snapshot al momento de tercerizar)
  datosEquipo         Json // {tipoEquipo, marcaEquipo, numeroSerie, condicionEquipo, accesorios}
  descripcionProblema String?
  sintomas            Json?
  componentesData     Json? // Snapshot de componentes a reparar
  // Datos adicionales (campos personalizados) curados, DENORMALIZADOS para que la
  // empresa destino los renderice sin tener la config CampoServicio del origen:
  // [{ etiqueta, valor, tipo }]
  datosAdicionales    Json?

  // Pricing B2B
  precioB2B     Decimal? @db.Decimal(10, 2)
  metodoPagoB2B String?
  // Pago de la empresa ORIGEN a la empresa DESTINO por el servicio (precioB2B).
  // EGRESO PAGO_PROVEEDOR en la caja del origen; la ganancia es costoTotal(orden) − precioB2B.
  pagadoB2B           Boolean   @default(false)
  fechaPagoB2B        DateTime?
  movimientoPagoB2BId String? // MovimientoCaja del egreso (no FK: módulos desacoplados)

  // Notas y comunicación
  notasOrigen   String? // Notas de la empresa que terceriza
  notasDestino  String? // Notas de la empresa que ejecuta
  motivoRechazo String?

  // Bitácora compartida (origen ↔ destino): apuntes, requerimientos, cambios de estado
  notas TercerizacionNota[]

  // Timestamps
  fechaSolicitud  DateTime  @default(now())
  fechaRespuesta  DateTime?
  fechaCompletado DateTime?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([empresaOrigenId])
  @@index([empresaDestinoId])
  @@index([estado])
  @@index([empresaOrigenId, estado])
  @@index([empresaDestinoId, estado])
}

enum TipoNotaTercerizacion {
  NOTA // apunte manual de cualquiera de las dos empresas
  REQUERIMIENTO // algo que el taller necesita/pide
  CAMBIO_ESTADO // auto-entrada al cambiar el estado de la tercerización
  SISTEMA // eventos automáticos varios
}

/// Bitácora append-only compartida entre empresa origen y destino de una tercerización.
/// Sirve como historial de requerimientos/apuntes/estados (no es chat en tiempo real).
model TercerizacionNota {
  id              String                @id @default(cuid())
  tercerizacionId String
  tercerizacion   TercerizacionServicio @relation(fields: [tercerizacionId], references: [id], onDelete: Cascade)
  empresaAutorId  String // empresa que escribió (origen o destino)
  usuarioId       String?
  tipo            TipoNotaTercerizacion @default(NOTA)
  contenido       String
  metadata        Json?
  creadoEn        DateTime              @default(now())

  @@index([tercerizacionId, creadoEn])
}
