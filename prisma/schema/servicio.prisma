model PlantillaServicio {
  id            String                       @id @default(cuid())
  empresaId     String
  nombre        String
  descripcion   String?
  isActive      Boolean                      @default(true)
  creadoEn      DateTime                     @default(now())
  actualizadoEn DateTime                     @updatedAt
  empresa       Empresa                      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  campos        ConfiguracionCamposServicio[]
  servicios     Servicio[]

  @@unique([empresaId, nombre])
  @@index([empresaId])
  @@index([isActive])
}

model Servicio {
  id                    String   @id @default(cuid())
  empresaId             String
  sedeId                String?
  empresaCategoriaId    String?
  unidadMedidaId        String? // Unidad de medida del servicio (ej: hora, día, sesión)
  plantillaServicioId   String?
  codigoEmpresa         String
  codigoSistema         String   @unique
  nombre                String
  descripcion           String?
  precio                Decimal? @db.Decimal(10, 2)
  precioPorHora         Decimal? @db.Decimal(10, 2)
  duracionMinutos       Int?
  duracionHoras         Decimal? @db.Decimal(5, 2)
  requiereReserva       Boolean  @default(false)
  requiereDeposito      Boolean  @default(false)
  depositoPorcentaje    Decimal? @db.Decimal(5, 2)
  antigenciaMinimaHoras Int?
  videoUrl              String?
  impuestoPorcentaje    Decimal? @db.Decimal(5, 2)
  comisionTecnico       Decimal? @db.Decimal(5, 2)

  // Campos para Marketplace
  visibleMarketplace Boolean @default(true)
  destacado          Boolean @default(false)
  ordenMarketplace   Int?

  // Sistema de Ofertas
  enOferta          Boolean   @default(false)
  precioOferta      Decimal?  @db.Decimal(10, 2)
  fechaInicioOferta DateTime?
  fechaFinOferta    DateTime?

  isActive            Boolean                  @default(true)
  deletedAt           DateTime?
  creadoEn            DateTime                 @default(now())
  actualizadoEn       DateTime                 @updatedAt
  detallesComprobante DetalleComprobante[]     @relation("DetalleServicio")
  empresaCategoria    EmpresaCategoria?        @relation(fields: [empresaCategoriaId], references: [id])
  unidadMedida        EmpresaUnidadMedida?     @relation(fields: [unidadMedidaId], references: [id])
  empresa             Empresa                  @relation(fields: [empresaId], references: [id])
  sede                Sede?                    @relation(fields: [sedeId], references: [id])
  plantillaServicio   PlantillaServicio?       @relation(fields: [plantillaServicioId], references: [id])
  comprobantes        ComprobanteElectronico[] @relation("ServicioComprobante")
  cotizacionDetalles  CotizacionDetalle[]
  ventaDetalles       VentaDetalle[]
  ordenesServicio     OrdenServicio[]
  citas               Cita[]

  @@unique([empresaId, codigoEmpresa])
  @@index([empresaId])
  @@index([empresaId, codigoEmpresa])
  @@index([empresaCategoriaId])
  @@index([unidadMedidaId])
  @@index([sedeId])
  @@index([plantillaServicioId])
  @@index([isActive])
  @@index([deletedAt])
  @@index([visibleMarketplace])
  @@index([destacado])
  @@index([ordenMarketplace])
  @@index([enOferta])
  @@index([fechaFinOferta])
  // GIN trigram para ILIKE '%texto%' — ver feedback_prisma_drop_gin_trgm_drift.md
  @@index([nombre(ops: raw("gin_trgm_ops"))], type: Gin, map: "Servicio_nombre_trgm_idx")
}

model ConfiguracionCamposServicio {
  id            String             @id @default(cuid())
  empresaId     String
  plantillaId   String?
  nombre        String
  tipoCampo     TipoCampoServicio
  categoria     CategoriaCampo?
  descripcion   String?
  placeholder   String?
  esRequerido   Boolean            @default(false)
  defaultValue  String?
  opciones      Json?
  permiteOtro   Boolean            @default(false)
  isActive      Boolean            @default(true)
  orden         Int?
  creadoEn      DateTime           @default(now())
  actualizadoEn DateTime           @updatedAt
  empresa       Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  plantilla     PlantillaServicio? @relation(fields: [plantillaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, plantillaId, nombre])
  @@index([empresaId])
  @@index([plantillaId])
  @@index([categoria])
  @@index([isActive])
}

model TipoComponente {
  id                   String              @id @default(cuid())
  empresaId            String?
  nombre               String
  categoria            CategoriaComponente
  descripcion          String?
  datosTecnicos        Json?
  camposPersonalizados Json?
  isActive             Boolean             @default(true)
  esGlobal             Boolean             @default(false)
  creadoEn             DateTime            @default(now())
  actualizadoEn        DateTime            @updatedAt
  componentes          Componente[]
  modelosEquipos       ModeloEquipo[]
  empresa              Empresa?            @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@unique([empresaId, nombre])
  @@index([empresaId])
  @@index([categoria])
  @@index([isActive])
}

model ModeloEquipo {
  id               String          @id @default(cuid())
  empresaId        String?
  tipoComponenteId String
  marca            String
  modelo           String
  especificaciones Json?
  isActive         Boolean         @default(true)
  esGlobal         Boolean         @default(false)
  creadoEn         DateTime        @default(now())
  actualizadoEn    DateTime        @updatedAt
  empresa          Empresa?        @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  tipoComponente   TipoComponente  @relation(fields: [tipoComponenteId], references: [id])
  ordenesServicio  OrdenServicio[]

  @@unique([empresaId, marca, modelo])
  @@index([empresaId])
  @@index([tipoComponenteId])
  @@index([marca])
  @@index([isActive])
}

model Componente {
  id               String               @id @default(cuid())
  empresaId        String
  tipoComponenteId String
  codigo           String
  marca            String?
  modelo           String?
  numeroSerie      String?
  especificaciones Json?
  estado           EstadoComponente     @default(INGRESADO)
  ubicacion        String?
  costoCompra      Decimal?             @db.Decimal(10, 2)
  costoReparacion  Decimal?             @db.Decimal(10, 2)
  isActive         Boolean              @default(true)
  deletedAt        DateTime?
  creadoEn         DateTime             @default(now())
  actualizadoEn    DateTime             @updatedAt
  empresa          Empresa              @relation(fields: [empresaId], references: [id])
  tipoComponente   TipoComponente       @relation(fields: [tipoComponenteId], references: [id])
  servicios        ServicioComponente[]

  @@unique([empresaId, codigo])
  @@unique([empresaId, numeroSerie])
  @@index([empresaId])
  @@index([tipoComponenteId])
  @@index([estado])
  @@index([isActive])
  @@index([deletedAt])
}

model OrdenServicio {
  id                  String                  @id @default(cuid())
  empresaId           String
  clienteId           String?
  clienteEmpresaId    String?
  contactoClienteEmpresaId String?
  tecnicoId           String?
  sedeId              String?
  codigo              String
  tipoServicio        TipoServicio
  prioridad           PrioridadServicio       @default(NORMAL)
  tipoEquipo          String?
  marcaEquipo         String?
  numeroSerie         String?
  modeloEquipoId      String?
  diagnostico         Json?
  descripcionProblema String?
  sintomas            Json?
  costoTotal          Decimal?                @db.Decimal(10, 2)
  adelanto            Decimal?                @db.Decimal(10, 2)
  descuento           Decimal?                @db.Decimal(10, 2)
  metodoPagoAdelanto  String?
  tiempoEstimado      Int?
  fechaEntrega        DateTime?
  estado              EstadoOrdenServicio     @default(RECIBIDO)
  estadoDiagnostico   EstadoDiagnostico       @default(PENDIENTE)
  notas               String?
  accesorios          Json?
  condicionEquipo     String?
  datosPersonalizados Json?
  servicioId          String?
  comprobanteId       String?
  incluirAvisoMantenimiento Boolean   @default(true)
  fechaAvisoPersonalizado   DateTime?
  origenOrden         OrigenOrden             @default(CLIENTE_FINAL)
  cantidadReingresos  Int                     @default(0)
  motivoReingreso     String?
  creadoEn            DateTime                @default(now())
  actualizadoEn       DateTime                @updatedAt
  cliente             EmpresaPersona?         @relation("OrdenServicioCliente", fields: [clienteId], references: [id])
  clienteEmpresa      ClienteEmpresa?         @relation(fields: [clienteEmpresaId], references: [id])
  contactoClienteEmpresa ClienteEmpresaContacto? @relation(fields: [contactoClienteEmpresaId], references: [id])
  comprobante         ComprobanteElectronico? @relation(fields: [comprobanteId], references: [id])
  empresa             Empresa                 @relation(fields: [empresaId], references: [id])
  modeloEquipo        ModeloEquipo?           @relation(fields: [modeloEquipoId], references: [id])
  servicio            Servicio?               @relation(fields: [servicioId], references: [id])
  tecnico             Usuario?                @relation(fields: [tecnicoId], references: [id])
  componentes         ServicioComponente[]
  historial           HistorialOrdenServicio[]
  avisosMantenimiento AvisoMantenimiento[]
  tercerizacionOrigen  TercerizacionServicio? @relation("OrdenOrigen")
  tercerizacionDestino TercerizacionServicio? @relation("OrdenDestino")
  citas                Cita[]
  mensajes             MensajeServicio[]

  @@unique([empresaId, codigo])
  @@index([empresaId])
  @@index([clienteId])
  @@index([clienteEmpresaId])
  @@index([contactoClienteEmpresaId])
  @@index([tecnicoId])
  @@index([estado])
  @@index([estadoDiagnostico])
  @@index([tipoServicio])
  @@index([fechaEntrega])
  // Índices compuestos para queries comunes
  @@index([empresaId, estado])
  @@index([empresaId, creadoEn])
  @@index([empresaId, estado, creadoEn])
  @@index([servicioId])
}

model ServicioComponente {
  id                String                   @id @default(cuid())
  ordenServicioId   String
  componenteId      String
  tipoAccion        TipoAccionComponente
  estadoComponente  EstadoComponente         @default(INGRESADO)
  descripcionAccion String?
  detallesAccion    Json?
  costoAccion       Decimal?                 @db.Decimal(10, 2)
  tiempoAccion      Int?
  costoRepuestos    Decimal?                 @db.Decimal(10, 2)
  resultadoAccion   String?
  pruebaRealizada   Boolean                  @default(false)
  observaciones     String?
  garantiaMeses     Int?
  fechaGarantia     DateTime?
  creadoEn          DateTime                 @default(now())
  actualizadoEn     DateTime                 @updatedAt
  componente        Componente               @relation(fields: [componenteId], references: [id])
  ordenServicio     OrdenServicio            @relation(fields: [ordenServicioId], references: [id], onDelete: Cascade)
  comprobantes      ComprobanteElectronico[] @relation("ComprobanteComponente")

  @@index([ordenServicioId])
  @@index([componenteId])
  @@index([tipoAccion])
  @@index([estadoComponente])
}

model HistorialOrdenServicio {
  id               String              @id @default(cuid())
  ordenServicioId  String
  estadoAnterior   EstadoOrdenServicio
  estadoNuevo      EstadoOrdenServicio
  notas            String?
  diagnostico      Json?
  costoTotal       Decimal?            @db.Decimal(10, 2)
  comunicarCliente Boolean             @default(false)
  creadoPor        String?
  creadoEn         DateTime            @default(now())
  ordenServicio    OrdenServicio       @relation(fields: [ordenServicioId], references: [id], onDelete: Cascade)

  @@index([ordenServicioId])
  @@index([creadoEn])
  @@index([estadoNuevo])
}

enum TipoCampoServicio {
  TEXTO
  NUMERO
  EMAIL
  FECHA
  HORA
  TEXTO_AREA
  OPCION_SIMPLES
  OPCION_MULTIPLE
  CHECKBOX
  CHECKBOX_MULTIPLE
  ARCHIVO
  TELEFONO
  URL
  OBJETO
  PATRON_DESBLOQUEO
  INSPECCION_VISUAL
}

enum CategoriaCampo {
  DIAGNOSTICO
  CLIENTE
  TECNICO
  COMPONENTE
  COSTOS
  TIEMPOS
  EQUIPO_CLIENTE
}

enum TipoServicio {
  REPARACION
  MANTENIMIENTO
  INSTALACION
  DIAGNOSTICO
  ACTUALIZACION
  LIMPIEZA
  RECUPERACION_DATOS
  CONFIGURACION
  CONSULTORIA
  FORMACION
  SOPORTE
}

enum PrioridadServicio {
  BAJA
  NORMAL
  ALTA
  URGENTE
  EMERGENCIA
}

enum EstadoOrdenServicio {
  RECIBIDO
  EN_DIAGNOSTICO
  ESPERANDO_APROBACION
  EN_REPARACION
  PENDIENTE_PIEZAS
  REPARADO
  LISTO_ENTREGA
  ENTREGADO
  CANCELADO
  FINALIZADO
  TERCERIZADO
}

enum EstadoDiagnostico {
  PENDIENTE
  EN_PROGRESO
  COMPLETADO
  REQUIERE_VISITA
  REQUIERE_PIEZAS
  EQUIPO_NO_REPARABLE
}

enum CategoriaComponente {
  HARDWARE
  SOFTWARE
  PERIFERICO
  ACCESORIOS
  CONSUMIBLES
}

enum EstadoComponente {
  NUEVO
  INGRESADO
  DISPONIBLE
  EN_USO
  EN_REPARACION
  DANADO
  OBSOLETO
  VENDIDO
  ELIMINADO
}

enum TipoAccionComponente {
  DIAGNOSTICAR
  REPARAR
  REEMPLAZAR
  LIMPIAR
  ACTUALIZAR
  INSTALAR
  DESMONTAR
  PROBAR
  CALIBRAR
}

// ─── Avisos de Mantenimiento Preventivo ───

enum EstadoAviso {
  PENDIENTE
  NOTIFICADO
  ATENDIDO
  DESCARTADO
}

model ConfiguracionAvisoMantenimiento {
  id               String   @id @default(cuid())
  empresaId        String   @unique
  intervalos       Json     // {"MANTENIMIENTO": 120, "REPARACION": 180, ...}
  diasAnticipacion Int      @default(7)
  habilitado       Boolean  @default(true)
  creadoEn         DateTime @default(now())
  actualizadoEn    DateTime @updatedAt
  empresa          Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
}

model AvisoMantenimiento {
  id                  String         @id @default(cuid())
  empresaId           String
  ordenServicioId     String
  clienteId           String
  tipoServicio        String
  equipoDescripcion   String?
  fechaUltimoServicio DateTime
  fechaRecomendada    DateTime
  estado              EstadoAviso    @default(PENDIENTE)
  ordenGeneradaId     String?
  notificadoEn        DateTime?
  notas               String?
  creadoEn            DateTime       @default(now())
  actualizadoEn       DateTime       @updatedAt
  empresa             Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  ordenServicio       OrdenServicio  @relation(fields: [ordenServicioId], references: [id])
  cliente             EmpresaPersona @relation(fields: [clienteId], references: [id])

  @@index([empresaId, estado])
  @@index([fechaRecomendada])
  @@index([clienteId])
  @@index([ordenServicioId])
}

// ─── Tercerización B2B de Servicios ───

enum OrigenOrden {
  CLIENTE_FINAL
  B2B_RECIBIDO
  B2B_ENVIADO
}

enum EstadoTercerizacion {
  PENDIENTE
  ACEPTADO
  RECHAZADO
  EN_PROCESO
  COMPLETADO
  CANCELADO
}

model TercerizacionServicio {
  id                 String                @id @default(cuid())

  // Empresa que terceriza (origen)
  empresaOrigenId    String
  ordenOrigenId      String                @unique
  empresaOrigen      Empresa               @relation("TercerizacionOrigen", fields: [empresaOrigenId], references: [id])
  ordenOrigen        OrdenServicio         @relation("OrdenOrigen", fields: [ordenOrigenId], references: [id])

  // Empresa que ejecuta (destino)
  empresaDestinoId   String
  ordenDestinoId     String?               @unique
  empresaDestino     Empresa               @relation("TercerizacionDestino", fields: [empresaDestinoId], references: [id])
  ordenDestino       OrdenServicio?        @relation("OrdenDestino", fields: [ordenDestinoId], references: [id])

  // Estado del flujo
  estado             EstadoTercerizacion   @default(PENDIENTE)

  // Datos compartidos (snapshot al momento de tercerizar)
  datosEquipo        Json                  // {tipoEquipo, marcaEquipo, numeroSerie, condicionEquipo, accesorios}
  descripcionProblema String?
  sintomas           Json?
  componentesData    Json?                 // Snapshot de componentes a reparar

  // Pricing B2B
  precioB2B          Decimal?              @db.Decimal(10, 2)
  metodoPagoB2B      String?

  // Notas y comunicación
  notasOrigen        String?               // Notas de la empresa que terceriza
  notasDestino       String?               // Notas de la empresa que ejecuta
  motivoRechazo      String?

  // Timestamps
  fechaSolicitud     DateTime              @default(now())
  fechaRespuesta     DateTime?
  fechaCompletado    DateTime?

  creadoEn           DateTime              @default(now())
  actualizadoEn      DateTime              @updatedAt

  @@index([empresaOrigenId])
  @@index([empresaDestinoId])
  @@index([estado])
  @@index([empresaOrigenId, estado])
  @@index([empresaDestinoId, estado])
}
