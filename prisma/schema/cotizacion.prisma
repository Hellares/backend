model Cotizacion {
  id               String  @id @default(cuid())
  empresaId        String
  sedeId           String
  clienteId        String?
  clienteEmpresaId String?
  vendedorId       String

  // Identificacion
  codigo String
  nombre String?

  // Datos del cliente (snapshot al momento de crear)
  nombreCliente    String
  documentoCliente String?
  emailCliente     String?
  telefonoCliente  String?
  direccionCliente String?

  // Moneda
  moneda     String   @default("PEN")
  tipoCambio Decimal? @db.Decimal(10, 6)

  // Montos
  subtotal  Decimal @db.Decimal(10, 2)
  descuento Decimal @default(0) @db.Decimal(10, 2)
  impuestos Decimal @default(0) @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)

  // Vigencia
  fechaEmision     DateTime  @default(now())
  fechaVencimiento DateTime?

  // Estado
  estado EstadoCotizacion @default(BORRADOR)

  // Referencia a comprobante (si se convierte)
  comprobanteId String?

  // Referencia a venta (cuando se convierte a venta)
  ventaId String?

  // Reserva de stock + pago adelantado.
  // - Si algún `CotizacionDetalle` tiene `reservaEstado = ACTIVA`, esta
  //   cotización está "apartando" stock. Se calcula en runtime vía
  //   detalles (no flag global, evita desincronización).
  // - `adelantoMonto` es el pago que dejó el cliente al crear la
  //   cotización; se registra como MovimientoCaja(ADELANTO_COTIZACION).
  // - Al convertir a venta, ese adelanto se aplica como pago parcial.
  // - Al anular, se libera el stock y se devuelve el adelanto vía
  //   MovimientoCaja(DEVOLUCION_ADELANTO).
  adelantoMonto    Decimal? @db.Decimal(10, 2)
  movimientoCajaId String?  // FK al INGRESO del adelanto (si aplica)
  // Adelanto que la empresa PIDE para separar (marketplace): el cliente lo
  // paga con Yape automático al aceptar la cotización → se vuelve
  // `adelantoMonto` + reserva de stock. Null = no se ofrece separación.
  adelantoRequerido Decimal? @db.Decimal(10, 2)

  // Observaciones
  observaciones String?
  condiciones   String?

  // Auditoria
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // Relaciones
  empresa            Empresa               @relation(fields: [empresaId], references: [id])
  sede               Sede                  @relation(fields: [sedeId], references: [id])
  cliente            EmpresaPersona?       @relation(fields: [clienteId], references: [id])
  clienteEmpresa     ClienteEmpresa?       @relation(fields: [clienteEmpresaId], references: [id])
  vendedor           Usuario               @relation("CotizacionVendedor", fields: [vendedorId], references: [id])
  venta              Venta?                @relation("CotizacionVenta", fields: [ventaId], references: [id])
  ventasOrigen       Venta[]               @relation("VentaCotizacion") // Back-relation: ventas created from this cotizacion
  detalles           CotizacionDetalle[]
  solicitudOrigen    SolicitudCotizacion[] @relation("SolicitudCotizacionRespuesta")
  movimientosCaja    MovimientoCaja[]      @relation("MovimientoCajaCotizacion") // ADELANTO_COTIZACION + DEVOLUCION_ADELANTO_COTIZACION

  @@unique([empresaId, codigo])
  @@index([empresaId])
  @@index([sedeId])
  @@index([vendedorId])
  @@index([clienteId])
  @@index([clienteEmpresaId])
  @@index([estado])
  @@index([ventaId])
  @@index([fechaEmision])
  @@index([empresaId, estado])
  @@index([empresaId, sedeId, estado])
  // GIN trigram para ILIKE '%texto%' — ver feedback_prisma_drop_gin_trgm_drift.md
  @@index([nombreCliente(ops: raw("gin_trgm_ops"))], type: Gin, map: "Cotizacion_nombreCliente_trgm_idx")
  @@index([documentoCliente(ops: raw("gin_trgm_ops"))], type: Gin, map: "Cotizacion_documentoCliente_trgm_idx")
}

model CotizacionDetalle {
  id           String  @id @default(cuid())
  cotizacionId String
  productoId   String?
  varianteId   String?
  servicioId   String?

  // Datos del item (snapshot)
  descripcion    String
  cantidad       Decimal @db.Decimal(10, 2)
  precioUnitario Decimal @db.Decimal(14, 4)
  descuento      Decimal @default(0) @db.Decimal(10, 2)

  // Impuesto
  tipoAfectacion String  @default("10") // SUNAT Cat.07: 10=Gravado, 20=Exonerado, 30=Inafecto
  porcentajeIGV  Decimal @default(18.00) @db.Decimal(5, 2)
  igv            Decimal @default(0) @db.Decimal(10, 2)
  icbper         Decimal @default(0) @db.Decimal(10, 2)

  // Totales
  subtotal Decimal @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  // Orden
  orden Int @default(0)

  // Reserva de stock por item. Solo aplica a items con producto/variante
  // (los items manuales o de servicio no reservan stock).
  // - `productoStockId`: FK a la fila de stock concreta por sede.
  // - `cantidadReservada`: cantidad apartada por esta cotización.
  // - `reservaEstado`: ACTIVA mientras el stock está apartado,
  //   LIBERADA si se anula o vence, CONVERTIDA al convertir a venta.
  productoStockId    String?
  cantidadReservada  Int?
  reservaEstado      ReservaCotizacionEstado?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // Relaciones
  cotizacion    Cotizacion        @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  producto      Producto?         @relation(fields: [productoId], references: [id])
  variante      ProductoVariante? @relation(fields: [varianteId], references: [id])
  servicio      Servicio?         @relation(fields: [servicioId], references: [id])
  productoStock ProductoStock?    @relation(fields: [productoStockId], references: [id])

  @@index([cotizacionId])
  @@index([productoId])
  @@index([varianteId])
  @@index([servicioId])
  @@index([productoStockId])
  // Para el EXISTS rápido de "cotizaciones con reserva activa"
  @@index([cotizacionId, reservaEstado])
}

enum EstadoCotizacion {
  BORRADOR
  PENDIENTE
  APROBADA
  RECHAZADA
  VENCIDA
  CONVERTIDA
}

enum ReservaCotizacionEstado {
  ACTIVA      // El stock está apartado actualmente
  LIBERADA    // La cotización fue anulada o venció (stock devuelto)
  CONVERTIDA  // La cotización se convirtió en venta (stock consumido)
}
