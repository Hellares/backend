enum TipoDocumento {
  COTIZACION
  FACTURA
  BOLETA
  NOTA_CREDITO
  NOTA_DEBITO
  GUIA_REMISION
  TICKET_VENTA
  ORDEN_SERVICIO
}

enum FormatoPapel {
  A4
  TICKET_80MM
  TICKET_58MM
}

/// Configuracion global de identidad de la empresa para documentos
model ConfiguracionDocumentos {
  id        String @id @default(cuid())
  empresaId String @unique

  // Marca/visual para documentos
  logoUrl         String? // Logo de la empresa
  nombreComercial String? // Nombre comercial (marca que ve el cliente)
  // Datos fiscales (ruc, dirección, teléfono, email) se leen de Empresa/Sede dinámicamente

  // Colores para documentos
  colorPrimario   String @default("#1565C0")
  colorSecundario String @default("#1E88E5")
  colorTexto      String @default("#333333")

  // Pie de pagina
  textoPiePagina    String  @default("Gracias por su preferencia")
  /// Texto del pie SOLO para tickets de VENTA (ej. política de devoluciones);
  /// null = usa textoPiePagina.
  textoPieVenta     String?
  /// Términos al pie SOLO para tickets/documentos de SERVICIO;
  /// null = usa textoPiePagina.
  textoPieServicio  String?
  mostrarPaginacion Boolean @default(true)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  empresa    Empresa              @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  plantillas PlantillaDocumento[]

  @@index([empresaId])
}

/// Plantilla por tipo de documento — controla layout, secciones visibles, margenes
model PlantillaDocumento {
  id                 String        @id @default(cuid())
  empresaId          String
  configuracionDocId String
  tipoDocumento      TipoDocumento
  formatoPapel       FormatoPapel  @default(A4)
  nombre             String

  // Margenes (mm)
  margenSuperior  Decimal @default(10.00) @db.Decimal(5, 2)
  margenInferior  Decimal @default(10.00) @db.Decimal(5, 2)
  margenIzquierdo Decimal @default(10.00) @db.Decimal(5, 2)
  margenDerecho   Decimal @default(10.00) @db.Decimal(5, 2)

  // Secciones visibles
  mostrarLogo          Boolean @default(true)
  mostrarDatosEmpresa  Boolean @default(true)
  mostrarDatosCliente  Boolean @default(true)
  mostrarDetalles      Boolean @default(true)
  mostrarTotales       Boolean @default(true)
  mostrarObservaciones Boolean @default(true)
  mostrarCondiciones   Boolean @default(true)
  mostrarFirma         Boolean @default(true)
  mostrarCodigoQR      Boolean @default(false)
  mostrarPiePagina     Boolean @default(true)

  // Colores override por plantilla (null = usa los de ConfiguracionDocumentos)
  colorEncabezado String?
  colorCuerpo     String?

  /// Texto de condiciones con el que nace un documento nuevo de este tipo.
  ///
  /// Es un DEFAULT del formulario, no algo que se inyecte al imprimir: lo que
  /// se guarda en la cotización es su propio texto, así que cambiarlo acá NO
  /// reescribe las cotizaciones ya emitidas.
  condicionesPorDefecto String?

  /// Logo propio de ESTE tipo de documento. null = usa el de la marca.
  ///
  /// Un logo cuadrado se ve bien en un ticket de 80 mm y se pierde en la
  /// cabecera de una cotización A4, que pide uno apaisado. Por eso el logo
  /// puede diversificarse por plantilla en vez de ser uno solo para todo.
  logoUrl String?

  /// Dónde va el logo en la hoja: IZQUIERDA | CENTRO | DERECHA.
  ///
  /// String y no enum a propósito: es una perilla de layout que va a ganar
  /// valores (arriba/abajo, marca de agua) y agregar valores a un enum de
  /// Postgres es mucho más caro que validar en el DTO.
  posicionLogo String @default("DERECHA")

  isActive     Boolean @default(true)
  esPorDefecto Boolean @default(true)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  empresa          Empresa                 @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  configuracionDoc ConfiguracionDocumentos @relation(fields: [configuracionDocId], references: [id], onDelete: Cascade)

  @@unique([empresaId, tipoDocumento, formatoPapel])
  @@index([empresaId])
  @@index([tipoDocumento])
}
