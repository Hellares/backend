/// Comunicación de Baja (Resumen tipo RA SUNAT) — anulación oficial de
/// Facturas (01), NC sobre Factura (07 con prefijo FC) y ND sobre Factura
/// (08 con prefijo FD) ya ACEPTADAS por SUNAT. Plazo: 7 días desde la
/// fechaEmision del documento.
/// Boletas y notas con prefijo BC/BD NO van por aquí — se anulan vía Resumen Diario.
model ComunicacionBaja {
  id                 String               @id @default(cuid())
  empresaId          String
  sedeId             String
  // Identificación SUNAT
  numeroCompleto     String // "RA-20260426-001"
  serie              String // "RA-20260426"
  correlativo        String // "001"
  fechaEmision       DateTime             @default(now())
  fechaReferencia    DateTime // fecha de los documentos a anular
  motivoBaja         String               @db.VarChar(500)
  // Estado
  estadoSunat        EstadoSunat          @default(PENDIENTE)
  ticket             String?
  hashCdr            String?
  errorProveedor     String?
  cdrResponse        Json?
  sunatXmlUrl        String?
  sunatCdrUrl        String?
  // Tracking del proveedor
  proveedorEmisor    ProveedorFacturacion
  proveedorBajaId    String? // ID en el proveedor (Syncrofact)
  enviadoAProveedor  Boolean              @default(false)
  intentosEnvio      Int                  @default(0)
  ultimoIntentoEnvio DateTime?
  // Auditoría
  usuarioCreacionId  String?
  creadoEn           DateTime             @default(now())
  actualizadoEn      DateTime             @updatedAt

  empresa  Empresa                   @relation(fields: [empresaId], references: [id])
  sede     Sede                      @relation(fields: [sedeId], references: [id])
  detalles DetalleComunicacionBaja[]

  @@unique([empresaId, numeroCompleto])
  @@index([empresaId])
  @@index([sedeId])
  @@index([empresaId, estadoSunat])
  @@index([empresaId, fechaReferencia])
  @@index([empresaId, fechaEmision])
}

model DetalleComunicacionBaja {
  id                 String   @id @default(cuid())
  comunicacionBajaId String
  comprobanteId      String // FK al ComprobanteElectronico anulado
  motivoEspecifico   String   @db.VarChar(250)
  creadoEn           DateTime @default(now())

  comunicacionBaja ComunicacionBaja       @relation(fields: [comunicacionBajaId], references: [id], onDelete: Cascade)
  comprobante      ComprobanteElectronico @relation("ComprobanteBajas", fields: [comprobanteId], references: [id])

  @@unique([comunicacionBajaId, comprobanteId])
  @@index([comprobanteId])
}

enum EstadoSunat {
  PENDIENTE
  ACEPTADO
  RECHAZADO
  ERROR_COMUNICACION
  PROCESANDO
}

/// Resumen Diario (tipo RC) — mecanismo SUNAT para anular boletas (`03`) y
/// notas vinculadas a boletas (`BC` / `BD`) ya ACEPTADAS. Plazo: **3 días** desde
/// la fechaEmision del documento (más estricto que CDB).
/// Facturas y notas `FC` / `FD` NO van por aquí — se anulan vía Comunicación de Baja.
///
/// Todas las boletas dentro de un mismo RC deben compartir `fechaEmision`
/// (regla SUNAT). Si hay boletas de fechas distintas, se generan RCs separados.
model ResumenDiario {
  id                 String               @id @default(cuid())
  empresaId          String
  sedeId             String
  // Identificación SUNAT
  numeroCompleto     String // "RC-20260429-001"
  serie              String // "RC-20260429"
  correlativo        String // "001"
  fechaEmision       DateTime             @default(now())
  fechaReferencia    DateTime // fecha de las boletas a anular
  motivoAnulacion    String               @db.VarChar(500)
  // Estado
  estadoSunat        EstadoSunat          @default(PENDIENTE)
  ticket             String?
  hashCdr            String?
  errorProveedor     String?
  cdrResponse        Json?
  sunatXmlUrl        String?
  sunatCdrUrl        String?
  // Tracking del proveedor
  proveedorEmisor    ProveedorFacturacion
  proveedorResumenId String? // ID en el proveedor (Syncrofact)
  enviadoAProveedor  Boolean              @default(false)
  intentosEnvio      Int                  @default(0)
  ultimoIntentoEnvio DateTime?
  // Auditoría
  usuarioCreacionId  String?
  creadoEn           DateTime             @default(now())
  actualizadoEn      DateTime             @updatedAt

  empresa  Empresa                @relation(fields: [empresaId], references: [id])
  sede     Sede                   @relation(fields: [sedeId], references: [id])
  detalles DetalleResumenDiario[]

  @@unique([empresaId, numeroCompleto])
  @@index([empresaId])
  @@index([sedeId])
  @@index([empresaId, estadoSunat])
  @@index([empresaId, fechaReferencia])
  @@index([empresaId, fechaEmision])
}

model DetalleResumenDiario {
  id               String   @id @default(cuid())
  resumenDiarioId  String
  comprobanteId    String // FK al ComprobanteElectronico anulado (BOLETA)
  motivoEspecifico String   @db.VarChar(250)
  creadoEn         DateTime @default(now())

  resumenDiario ResumenDiario          @relation(fields: [resumenDiarioId], references: [id], onDelete: Cascade)
  comprobante   ComprobanteElectronico @relation("ComprobanteResumenes", fields: [comprobanteId], references: [id])

  @@unique([resumenDiarioId, comprobanteId])
  @@index([comprobanteId])
}

/**
 * Proveedor de facturación electrónica que emitió un comprobante.
 * Se guarda en cada ComprobanteElectronico para enrutar envío/consulta/anulación
 * al provider correcto, aunque el proveedor activo de la empresa cambie después.
 * Agregar nuevos proveedores (ej. EFACT, BIZLINKS) requiere añadirlos aquí.
 */
enum ProveedorFacturacion {
  NUBEFACT
  SYNCROFACT
}

enum Moneda {
  PEN
  USD
  EUR
  GBP
  JPY
}

enum OrigenTransaccion {
  WEB
  MOVIL
  PRESENCIAL
  WHATSAPP
  TELEMARKETING
  API
  LINK_PAGO
}
