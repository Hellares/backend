model MetodoPago {
  id                      String            @id @default(cuid())
  empresaId               String
  tipo                    TipoMetodoPago
  nombre                  String
  esActivo                Boolean           @default(true)
  apiKey                  String?
  secretKey               String?
  webhookSecret           String?
  merchantId              String?
  comision                Decimal?          @db.Decimal(5, 2)
  comisionFija            Decimal?          @db.Decimal(10, 2)
  limiteMinimo            Decimal?          @db.Decimal(10, 2)
  limiteMaximo            Decimal?          @db.Decimal(10, 2)
  modoPrueba              Boolean           @default(false)
  requiere3DS             Boolean           @default(false)
  tiempoExpiracionMinutos Int               @default(30)
  configExtra             Json?
  configuradoPorId        String?
  creadoEn                DateTime          @default(now())
  actualizadoEn           DateTime          @updatedAt
  configuradoPor          Usuario?          @relation("MetodoPagoUsuario", fields: [configuradoPorId], references: [id])
  empresa                 Empresa           @relation(fields: [empresaId], references: [id])
  transacciones           TransaccionPago[]

  @@unique([empresaId, tipo])
  @@index([empresaId])
  @@index([tipo])
  @@index([esActivo])
}

model TransaccionPago {
  id               String            @id @default(cuid())
  metodoPagoId     String?
  usuarioId        String?
  empresaId        String?
  monto            Decimal           @db.Decimal(10, 2)
  moneda           String            @default("PEN")
  tipoCambio       Decimal?          @db.Decimal(10, 6)
  montoOriginal    Decimal?          @db.Decimal(10, 2)
  estado           EstadoPago
  idExterno        String?
  descripcion      String?
  datosCliente     Json?
  errorMensaje     String?
  fechaAprobacion  DateTime?
  fechaReembolso   DateTime?
  expiraEn         DateTime?
  metadata         Json?
  origen           String?
  creadoEn         DateTime          @default(now())
  actualizadoEn    DateTime          @updatedAt
  pagosComprobante PagoComprobante[] @relation("PagoComprobanteTransaccion")
  empresa          Empresa?          @relation(fields: [empresaId], references: [id])
  metodoPago       MetodoPago?       @relation(fields: [metodoPagoId], references: [id])
  usuario          Usuario?          @relation(fields: [usuarioId], references: [id])

  @@index([metodoPagoId])
  @@index([usuarioId])
  @@index([empresaId])
  @@index([estado])
  @@index([moneda])
  @@index([idExterno])
  @@index([creadoEn])
  @@index([expiraEn])
  @@index([empresaId, estado, creadoEn])
}

model ConfiguracionFacturacion {
  id                 String               @id @default(cuid())
  empresaId          String               @unique
  // Datos fiscales ahora viven en Empresa (ruc, razonSocial, direccionFiscal)
  // Datos de marca/logo viven en ConfiguracionDocumentos (nombreComercial, logoUrl)
  emailFacturacion   String? // Email específico para facturación (puede diferir del email general)
  certificadoDigital String?
  claveCertificado   String?
  usuarioSol         String?
  claveSol           String?
  entorno            String               @default("BETA")
  // Proveedor de facturación electrónica (Nubefact, Syncrofact, Efact, etc.)
  proveedorActivo    ProveedorFacturacion @default(SYNCROFACT) // Proveedor que emitirá nuevos comprobantes
  proveedorRuta      String? // URL API del proveedor (base URL)
  proveedorToken     String? // Token/credencial del proveedor
  proveedorConfig    Json? // Config extra específica del proveedor (ej. Syncrofact: { companyId, branchId })
  facturacionActiva  Boolean              @default(false) // Switch maestro
  resolucionSunat    String? // Ej: "No.034-005-0005315"
  textoPiePagina     String               @default("Gracias por su compra")
  incluirIGV         Boolean              @default(true)
  incluirDetalles    Boolean              @default(true)
  formatoPapel       String               @default("A4")
  porcentajeIGV      Decimal              @default(18.00) @db.Decimal(5, 2) // Fuente de verdad para IGV
  creadoEn           DateTime             @default(now())
  actualizadoEn      DateTime             @updatedAt
  empresa            Empresa              @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
}

model ComprobanteElectronico {
  id                  String                    @id @default(cuid())
  empresaId           String
  sedeId              String?
  clienteId           String?
  clienteEmpresaId    String?
  // Proveedor que emitió este comprobante. Se graba al crear y nunca cambia
  // para garantizar que envío/consulta/anulación usen el mismo proveedor.
  proveedorEmisor     ProveedorFacturacion?
  // RUC con el que se emitió (multi-RUC): rucSede de la sede-socio o el RUC
  // de la empresa. Serie+correlativo son únicos POR EMISOR ante SUNAT, no por
  // empresa — el socio puede usar F001 aunque el principal también la tenga.
  rucEmisor           String?
  tipoComprobante     TipoComprobante
  serie               String
  correlativo         String
  codigoGenerado      String
  tipoDocumento       String?
  numeroDocumento     String?
  nombreCliente       String
  direccionCliente    String?
  emailCliente        String?
  fechaEmision        DateTime                  @default(now())
  fechaVencimiento    DateTime?
  moneda              String                    @default("PEN")
  tipoCambio          Decimal?                  @db.Decimal(10, 6)
  gravada             Decimal                   @default(0) @db.Decimal(10, 2)
  inafecta            Decimal                   @default(0) @db.Decimal(10, 2)
  exonerada           Decimal                   @default(0) @db.Decimal(10, 2)
  // Σ valores referenciales (sin IGV) de líneas GRATUITAS (regalos convertidos
  // por precio 0 — catálogo 07: 15/21/31). Informativo: NO suma al total.
  gratuitas           Decimal                   @default(0) @db.Decimal(10, 2)
  igv                 Decimal                   @default(0) @db.Decimal(10, 2)
  icbper              Decimal                   @default(0) @db.Decimal(10, 2)
  total               Decimal                   @default(0) @db.Decimal(10, 2)
  totalIgv            Decimal                   @default(0) @db.Decimal(10, 2)
  cdrResponse         Json?
  sunatStatus         EstadoSunat               @default(PENDIENTE)
  sunatHash           String?
  sunatXmlUrl         String?
  sunatPdfUrl         String?
  sunatCdrUrl         String?
  cadenaQR            String?
  enlaceProveedor     String?
  enviadoAProveedor   Boolean                   @default(false)
  errorProveedor      String?
  // Código de error de SUNAT (ej. "2335", "0103") cuando hay rechazo. Null si es
  // error de validación del proveedor (sin código SUNAT) o si fue aceptado.
  sunatCodigo         String?
  intentosEnvio       Int                       @default(0)
  ultimoIntentoEnvio  DateTime?
  estado              EstadoComprobante         @default(BORRADOR)
  anulado             Boolean                   @default(false)
  motivoAnulacion     String?
  // Notas de crédito/débito: referencia al comprobante original
  comprobanteOrigenId String?
  tipoNotaCredito     Int?
  tipoNotaDebito      Int?
  motivoNota          String?
  creadoEn            DateTime                  @default(now())
  actualizadoEn       DateTime                  @updatedAt
  cliente             EmpresaPersona?           @relation("ComoCliente", fields: [clienteId], references: [id])
  clienteEmpresa      ClienteEmpresa?           @relation("ComprobanteClienteEmpresa", fields: [clienteEmpresaId], references: [id])
  empresa             Empresa                   @relation(fields: [empresaId], references: [id])
  sede                Sede?                     @relation(fields: [sedeId], references: [id])
  detalles            DetalleComprobante[]
  ordenesServicio     OrdenServicio[]
  pagos               PagoComprobante[]
  componentes         ServicioComponente[]      @relation("ComprobanteComponente")
  productos           Producto[]                @relation("ProductoComprobante")
  servicios           Servicio[]                @relation("ServicioComprobante")
  // Notas: self-relation
  comprobanteOrigen   ComprobanteElectronico?   @relation("NotasRelacionadas", fields: [comprobanteOrigenId], references: [id])
  notasRelacionadas   ComprobanteElectronico[]  @relation("NotasRelacionadas")
  // Comunicaciones de Baja en las que este comprobante fue anulado
  bajas               DetalleComunicacionBaja[] @relation("ComprobanteBajas")
  // Resúmenes Diarios (RC) en los que este comprobante fue anulado (boletas)
  resumenes           DetalleResumenDiario[]    @relation("ComprobanteResumenes")
  // Relación con Venta (1:1 opcional)
  ventaId             String?                   @unique
  venta               Venta?                    @relation(fields: [ventaId], references: [id])

  @@unique([empresaId, rucEmisor, tipoComprobante, serie, correlativo], map: "ComprobanteElectronico_empresa_emisor_tipo_serie_corr_key")
  @@unique([empresaId, rucEmisor, codigoGenerado], map: "ComprobanteElectronico_empresa_emisor_codigo_key")
  // FK indexes
  @@index([empresaId])
  @@index([sedeId])
  @@index([comprobanteOrigenId])
  @@index([ventaId])
  // Queries frecuentes
  @@index([tipoComprobante])
  @@index([fechaEmision])
  @@index([estado])
  @@index([sunatStatus])
  // Compuestos: monitor de facturación, reportes, reenvíos
  @@index([empresaId, estado])
  @@index([empresaId, fechaEmision])
  @@index([empresaId, estado, fechaEmision])
  @@index([empresaId, sunatStatus])
  @@index([empresaId, tipoComprobante, fechaEmision])
  // Reenvío de pendientes: busca por status + estado + intentos
  @@index([sunatStatus, estado, intentosEnvio])
  // Reporte correlativos: busca por empresa + serie
  @@index([empresaId, serie])
  // Búsqueda por documento cliente
  @@index([empresaId, numeroDocumento])
  // Filtrar por proveedor emisor
  @@index([empresaId, proveedorEmisor])
}

model DetalleComprobante {
  id              String                 @id @default(cuid())
  comprobanteId   String
  productoId      String?
  servicioId      String?
  unidadMedidaId  String? // Relación a EmpresaUnidadMedida
  descripcion     String
  unidadMedida    String                 @default("NIU") // Código SUNAT directo (para compatibilidad)
  cantidad        Decimal                @db.Decimal(12, 2)
  valorUnitario   Decimal                @db.Decimal(14, 4)
  precioUnitario  Decimal                @db.Decimal(14, 4)
  tipoAfectacion  String                 @default("10")
  porcentajeIGV   Decimal                @default(18.00) @db.Decimal(5, 2)
  igv             Decimal                @default(0) @db.Decimal(12, 2)
  icbper          Decimal                @default(0) @db.Decimal(12, 2)
  valorVenta      Decimal                @default(0) @db.Decimal(12, 2)
  descuentoItem   Decimal?               @db.Decimal(12, 2)
  cargoItem       Decimal?               @db.Decimal(12, 2)
  subtotal        Decimal                @db.Decimal(12, 2)
  total           Decimal                @db.Decimal(12, 2)
  creadoEn        DateTime               @default(now())
  actualizadoEn   DateTime               @updatedAt
  comprobante     ComprobanteElectronico @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)
  producto        Producto?              @relation("DetalleProducto", fields: [productoId], references: [id])
  servicio        Servicio?              @relation("DetalleServicio", fields: [servicioId], references: [id])
  unidadMedidaRef EmpresaUnidadMedida?   @relation(fields: [unidadMedidaId], references: [id])

  @@index([comprobanteId])
  @@index([productoId])
  @@index([servicioId])
  @@index([unidadMedidaId])
}

model PlantillaComprobante {
  id              String          @id @default(cuid())
  empresaId       String
  tipoComprobante TipoComprobante
  nombre          String
  descripcion     String?
  htmlTemplate    String?
  cssStyles       String?
  margenSuperior  Decimal         @default(10.00) @db.Decimal(5, 2)
  margenInferior  Decimal         @default(10.00) @db.Decimal(5, 2)
  margenIzquierdo Decimal         @default(10.00) @db.Decimal(5, 2)
  margenDerecho   Decimal         @default(10.00) @db.Decimal(5, 2)
  mostrarLogo     Boolean         @default(true)
  mostrarCodigoQR Boolean         @default(true)
  mostrarFirma    Boolean         @default(true)
  mostrarDetalles Boolean         @default(true)
  mostrarTotales  Boolean         @default(true)
  colorEncabezado String          @default("#000000")
  colorCuerpo     String          @default("#333333")
  colorPiePagina  String          @default("#666666")
