model Sede {
  id        String   @id @default(cuid())
  empresaId String
  codigo    String   @default("SEDE-001") // Código único de la sede (ej: "SEDE-001", "LIMA-CENTRO")
  nombre    String
  telefono  String?
  email     String?
  tipoSede  TipoSede @default(OPERATIVA_COMPLETA) // Tipo de operación de la sede

  // Ubicación completa
  direccion    String?
  referencia   String?
  stand        String? // Número o nombre de stand (ej: "Stand 45", "Puesto A-12")
  distrito     String?
  provincia    String?
  departamento String?
  ubigeo       String? // Código ubigeo SUNAT 6 dígitos (ej: "150131")
  pais         String?  @default("PERU")
  coordenadas  Json? // {lat: -12.0464, lon: -77.0428} para geolocalización
  imagenes     String[] // URLs de imágenes referenciales de la sede

  // Configuración operativa
  horarioAtencion Json? // {"lunes": {"inicio": "09:00", "fin": "18:00"}, ...}
  configuracion   Json? // Configuraciones específicas de la sede

  // Facturación electrónica (override por sede, si null usa ConfiguracionFacturacion de empresa)
  rucSede               String? // RUC propio de la sede (si difiere del de la empresa)
  razonSocialSede       String? // Razón social del contribuyente
  direccionFiscalSede   String? // Dirección fiscal SUNAT
  proveedorActivo       ProveedorFacturacion? // null = usa proveedorActivo de ConfiguracionFacturacion
  proveedorRuta         String? // URL API proveedor facturación (base URL)
  proveedorToken        String? // Token proveedor facturación
  proveedorConfig       Json? // Config extra específica del proveedor (override de sede)
  facturacionActiva     Boolean? // null = usa config global
  resolucionSunat       String?
  seriesSincronizadasEn DateTime? // Última sincronización de series con el proveedor

  // Series de comprobantes por sede
  // SUNAT diferencia las series según el documento afectado por NC/ND:
  //   serieNotaCredito       → NC sobre Factura  (prefijo FC, ej. "FC01")
  //   serieNotaCreditoBoleta → NC sobre Boleta   (prefijo BC, ej. "BC01")
  //   serieNotaDebito        → ND sobre Factura  (prefijo FD, ej. "FD01")
  //   serieNotaDebitoBoleta  → ND sobre Boleta   (prefijo BD, ej. "BD01")
  serieFactura           String  @default("F001")
  serieBoleta            String  @default("B001")
  serieNotaCredito       String  @default("NC01")
  serieNotaCreditoBoleta String  @default("BC01")
  serieNotaDebito        String  @default("ND01")
  serieNotaDebitoBoleta  String  @default("BD01")
  serieGuiaRemision      String? @default("GR01")

  // Contadores de documentos por sede
  ultimoNumeroFactura           Int @default(0)
  ultimoNumeroBoleta            Int @default(0)
  ultimoNumeroNotaCredito       Int @default(0)
  ultimoNumeroNotaCreditoBoleta Int @default(0)
  ultimoNumeroNotaDebito        Int @default(0)
  ultimoNumeroNotaDebitoBoleta  Int @default(0)
  ultimoNumeroGuiaRemision      Int @default(0)

  // Estado
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  esPrincipal Boolean   @default(false)

  // Auditoría
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // Relaciones
  direcciones DireccionSede[]
  productos   Producto[]
  empresa     Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  servicios   Servicio[]
  usuarios    UsuarioSedeRol[]

  // Relaciones para sistema de descuentos
  historialDescuentos DescuentoUsoHistorial[]

  // Relaciones para inventario por sede
  stocksProductos       ProductoStock[]
  movimientosStock      MovimientoStock[]
  transferenciasOrigen  TransferenciaStock[]          @relation("TransferenciasOrigen")
  transferenciasDestino TransferenciaStock[]          @relation("TransferenciasDestino")
  historialPreciosSede  ProductoPrecioHistorialSede[] @relation("SedeCambiosPrecios")
  reservacionesCombos   ComboReservacion[]

  // Relaciones para devoluciones
  devoluciones Devolucion[]

  // Relaciones para reportes de incidencias
  reportesIncidencia     ReporteIncidencia[]
  itemsReporteIncidencia ReporteIncidenciaItem[]

  // Relaciones para inventarios
  inventarios     Inventario[]
  itemsInventario InventarioItem[]

  // Relaciones para cotizaciones
  cotizaciones Cotizacion[]

  // Relaciones para ventas
  ventas Venta[]

  // Relaciones para módulo de compras
  ordenesCompra OrdenCompra[]
  compras       Compra[]
  lotes         Lote[]

  // Relaciones para módulo de citas
  citas Cita[]

  // Relaciones para pedidos marketplace (retiro en tienda)
  pedidosRetiro PedidoMarketplace[]

  // Relaciones para módulo de caja
  cajas            Caja[]
  cajasFacturacion Caja[] @relation("CajaSedeFacturacion")

  // Relaciones para módulo de caja chica
  cajasChicas CajaChica[]

  // Ubicaciones de almacén
  ubicacionesAlmacen UbicacionAlmacen[]

  // Agentes bancarios
  agentesBancarios AgenteBancario[]

  // RRHH
  empleados        Empleado[]
  asistencias      Asistencia[]
  periodosPlanilla PeriodoPlanilla[]

  // Comprobantes electrónicos emitidos desde esta sede
  comprobantes ComprobanteElectronico[]

  // Comunicaciones de baja emitidas desde esta sede
  comunicacionesBaja ComunicacionBaja[]

  // Resúmenes diarios (RC) emitidos desde esta sede
  resumenesDiarios ResumenDiario[]

  // Guías de remisión
  guiasRemision GuiaRemision[]

  // Gastos recurrentes
  gastosRecurrentes GastoRecurrente[]

  @@unique([empresaId, codigo])
  @@index([empresaId])
  @@index([codigo])
  @@index([isActive])
  @@index([esPrincipal])
  @@index([deletedAt])
  @@index([tipoSede])
  @@index([empresaId, isActive])
  @@index([empresaId, deletedAt])
  @@index([empresaId, isActive, deletedAt])
}

model DireccionSede {
  id            String    @id @default(cuid())
  sedeId        String
  direccion     String
  referencia    String?
  distrito      String?
  provincia     String?
  departamento  String?
  pais          String?   @default("PERU")
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt
  sede          Sede      @relation(fields: [sedeId], references: [id])

  @@index([sedeId])
  @@index([deletedAt])
}

model PlanSuscripcion {
  id                        String             @id @default(cuid())
  nombre                    String             @unique
  descripcion               String
  precio                    Decimal            @db.Decimal(10, 2)
  periodo                   PeriodoSuscripcion
  limiteProductos           Int?
  limiteServicios           Int?
  limiteUsuarios            Int?
  limiteSedes               Int?
  limitePlantillasAtributos Int? // Límite de plantillas personalizadas
  limiteCotizaciones        Int? // Límite de cotizaciones
  limiteAlmacenamientoMB    Int? // null = ilimitado, en megabytes
  precioSemestral           Decimal?           @db.Decimal(10, 2)
  precioAnual               Decimal?           @db.Decimal(10, 2)
  tieneWebPermanente        Boolean            @default(false) // false = web solo trial 2 meses
  tienePersonalizacion      Boolean            @default(false)
  tieneDominioPropio        Boolean            @default(false)
  tieneApi                  Boolean            @default(false)
  tieneReportesAvanzados    Boolean            @default(false)
  caracteristicas           Json
  isActive                  Boolean            @default(true)
  creadoEn                  DateTime           @default(now())
  actualizadoEn             DateTime           @updatedAt
  empresas                  Empresa[]
  pagosSuscripcion          PagoSuscripcion[]

  @@index([isActive])
  @@index([precio])
}

model PersonalizacionEmpresa {
  id                   String   @id @default(cuid())
  empresaId            String
  webConfig            Json?
  bannerPrincipalUrl   String?
  bannerPrincipalTexto String?
  banners              Json? // [{url, texto, link, orden}]
  bannerColor          String?  @default("#000000")
  colorPrimario        String?  @default("#007bff")
  colorSecundario      String?  @default("#6c757d")
  colorAcento          String?  @default("#28a745")
  mostrarPrecios       Boolean  @default(true)
  productosDestacados  String[]
  serviciosDestacados  String[]
  mostrarContacto      Boolean  @default(true)
  mostrarRedesSociales Boolean  @default(false)
  permitirRegistro     Boolean  @default(true)
  appConfig            Json?
  appSplashScreenUrl   String?
  appColorTema         String?  @default("#007bff")
  dominioPersonalizado String?  @unique
  creadoEn             DateTime @default(now())
  actualizadoEn        DateTime @updatedAt
  empresa              Empresa  @relation(fields: [empresaId], references: [id])

  @@index([empresaId])
  @@index([dominioPersonalizado])
}

model ConfiguracionEmpresa {
  id                        String   @id @default(cuid())
  empresaId                 String   @unique
  impuestoDefaultPorcentaje Float    @default(18.0)
  nombreImpuesto            String   @default("IGV")
  monedaPrincipal           String   @default("PEN")
  simboloMoneda             String   @default("S/")
  monedasPermitidas         String[] @default(["PEN", "USD"])
  diasVigenciaCotizacion    Int      @default(30)
  condicionesDefault        String?

  // Etiquetas personalizables para sección equipo en órdenes de servicio
  etiquetaSeccionEquipo   String? // "EQUIPO", "VEHICULO", "SERVICIO", etc.
  etiquetaTipoEquipo      String? // "Tipo de equipo", "Tipo de vehículo", etc.
  etiquetaMarcaEquipo     String? // "Marca", "Marca/Modelo", etc.
  etiquetaNumeroSerie     String? // "Número de serie", "Placa", "N° Chasis", etc.
  etiquetaCondicionEquipo String? // "Condición del equipo", "Estado del vehículo", etc.
  mostrarSeccionEquipo    Boolean @default(true) // Permite ocultar la sección completa

  // Configuración de venta a crédito
  ventaCreditoHabilitada   Boolean  @default(false)
  interesHabilitado        Boolean  @default(false)
  porcentajeInteresDefault Decimal? @default(0) @db.Decimal(5, 2) // 5.00 = 5%
  interesEsEditable        Boolean  @default(true) // Vendedor puede cambiar %

  // Configuración de RRHH / Planilla
  horasJornadaDefault  Float  @default(8.0)
  horasExtraPorcentaje Float  @default(25.0) // % adicional por hora extra
  dominicalPorcentaje  Float  @default(100.0) // % adicional por trabajo dominical
  feriadoPorcentaje    Float  @default(100.0) // % adicional por trabajo en feriado
  essaludPorcentaje    Float  @default(9.0) // % aporte EsSalud empleador
  // Pensiones (descuento al empleado según su régimen)
  onpPorcentaje         Float @default(13.0) // % descuento ONP
  afpAportePorcentaje   Float @default(10.0) // % aporte obligatorio AFP
  afpComisionPorcentaje Float @default(1.6) // % comisión AFP sobre flujo
  afpPrimaPorcentaje    Float @default(1.35) // % prima de seguro AFP
  periodoPlanillaTipo  String @default("MENSUAL") // MENSUAL o QUINCENAL

  // Configuración de mora para cuotas vencidas
  moraHabilitada       Boolean  @default(false)
  porcentajeMoraDiario Decimal? @default(0.05) @db.Decimal(5, 4) // 0.05% diario por defecto
  moraMaximaPorcentaje Decimal? @default(30.0) @db.Decimal(5, 2) // Tope máximo 30% del monto cuota
  diasGraciaMora       Int      @default(0) // Días de gracia antes de aplicar mora

  // QR de cobro Yape/Plin: imagen ESTÁTICA del comercio que se muestra en la
  // hoja de cobro para que el cliente la escanee. El monto (con céntimos) se
  // teclea aparte (el QR estático no lleva monto). Independiente de api-yape.
  qrYapeUrl String?
  qrPlinUrl String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  empresa       Empresa  @relation(fields: [empresaId], references: [id])

  @@index([empresaId])
}

// Tipos de sede según su función operativa
enum TipoSede {
  OPERATIVA_COMPLETA // Ventas + Almacén + Servicios (sede completa)
  SOLO_ALMACEN // Solo inventario y transferencias (sin ventas directas)
  PUNTO_VENTA // Solo ventas (recibe stock por transferencia)
  OFICINA_ADMINISTRATIVA // Solo administración (sin operaciones comerciales)
  TALLER_LABORATORIO // Taller de reparación o laboratorio de servicios
}

enum PeriodoSuscripcion {
  MENSUAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
  PERSONALIZADO
}

enum EstadoSuscripcion {
  ACTIVA
  VENCIDA
  CANCELADA
  SUSPENDIDA
  EN_PROBATION
}

enum RubroEmpresa {
  TECNOLOGIA
  GASTRONOMIA
  MODA
  HOGAR
  SALUD
  AUTOMOTRIZ
  DEPORTES
  CONSTRUCCION
  EDUCACION
  OTRO
}
