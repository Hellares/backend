model Empresa {
  id                     String            @id @default(cuid())
  nombre                 String
  ruc                    String?           @unique
  subdominio             String?           @unique
  logo                   String?
  rubro                  RubroEmpresa      @default(TECNOLOGIA)
  isActive               Boolean           @default(true)
  deletedAt              DateTime?
  descripcion            String?
  web                    String?
  telefono               String?
  email                  String?

  // Datos SUNAT
  razonSocial            String?
  tipoContribuyente      String?
  estadoContribuyente    String?   // "ACTIVO", "SUSPENSION TEMPORAL", "BAJA"
  condicionContribuyente String?   // "HABIDO", "NO HABIDO"
  direccionFiscal        String?
  departamento           String?
  provincia              String?
  distrito               String?
  ubigeo                 String?

  planSuscripcionId      String?
  fechaInicioSuscripcion DateTime?
  fechaVencimiento       DateTime?
  estadoSuscripcion      EstadoSuscripcion @default(ACTIVA)
  usuariosActuales       Int               @default(0)

  // Campos para Marketplace
  visibleEnMarketplace Boolean @default(true)
  destacadoMarketplace Boolean @default(false)
  ordenMarketplace     Int?
  vistasMarketplace    Int     @default(0)

  // SEO y Metadata
  metaTitle       String?
  metaDescription String?
  keywords        String?

  // Redes Sociales
  facebook  String?
  instagram String?
  twitter   String?
  linkedin  String?

  creadoEn                 DateTime                      @default(now())
  actualizadoEn            DateTime                      @updatedAt
  componentes              Componente[]
  comprobantes             ComprobanteElectronico[]
  configuracionCampos      ConfiguracionCamposServicio[]
  configuracionCodigos     ConfiguracionCodigos?
  configuracionFacturacion ConfiguracionFacturacion?
  planSuscripcion          PlanSuscripcion?              @relation(fields: [planSuscripcionId], references: [id])
  personasAsociadas        EmpresaPersona[]
  usuarios                 EmpresaUsuarioRol[]
  metodosPago              MetodoPago[]
  modelosEquipos           ModeloEquipo[]
  ordenesServicio          OrdenServicio[]
  personalizaciones        PersonalizacionEmpresa[]
  plantillasComprobantes   PlantillaComprobante[]
  plantillasServicio       PlantillaServicio[]
  productos                Producto[]
  sedes                    Sede[]
  servicios                Servicio[]
  tiposComponentes         TipoComponente[]
  transaccionesRecibidas   TransaccionPago[]
  archivos                 Archivo[]
  empresaCategorias        EmpresaCategoria[]
  empresaMarcas            EmpresaMarca[]
  empresasUnidades         EmpresaUnidadMedida[]
  productoVariantes        ProductoVariante[]
  productoAtributos        ProductoAtributo[]
  plantillasAtributos      ProductoAtributoPlantilla[]
  configuracionesPrecios   ConfiguracionPrecio[]

  // Relaciones para sistema de descuentos
  politicasDescuento   PoliticaDescuento[]
  usuariosConDescuento UsuarioDescuento[]
  historialDescuentos  DescuentoUsoHistorial[]

  // Relaciones para inventario por sede
  stocksProductos               ProductoStock[]
  movimientosStock              MovimientoStock[]
  transferenciasStock           TransferenciaStock[]
  itemsTransferenciaStock       TransferenciaStockItem[]
  incidenciasTransferenciaStock TransferenciaStockIncidencia[]

  // Relaciones para reportes de incidencias
  reportesIncidencia     ReporteIncidencia[]
  itemsReporteIncidencia ReporteIncidenciaItem[]

  // Relaciones para inventarios
  inventarios     Inventario[]
  itemsInventario InventarioItem[]

  // Relaciones para devoluciones
  devoluciones    Devolucion[]
  devolucionItems DevolucionItem[]

  // Relaciones para módulo de clientes empresa
  clientesEmpresa ClienteEmpresa[]

  // Relaciones para módulo de proveedores
  proveedores           Proveedor[]
  proveedorEvaluaciones ProveedorEvaluacion[]
  proveedorProductos    ProveedorProducto[]

  // Relaciones para motor de compatibilidad
  reglasCompatibilidad ReglaCompatibilidad[]

  // Relaciones para cotizaciones
  cotizaciones Cotizacion[]

  // Relaciones para módulo de compras
  ordenesCompra OrdenCompra[]
  compras       Compra[]
  lotes         Lote[]

  configuracionEmpresa ConfiguracionEmpresa?

  // Relaciones para tercerización B2B
  aceptaTercerizacion           Boolean  @default(false)
  descripcionTercerizacion      String?
  tiposServicioTercerizacion    Json?    // ["REPARACION","MANTENIMIENTO",...]
  tercerizacionesEnviadas       TercerizacionServicio[] @relation("TercerizacionOrigen")
  tercerizacionesRecibidas      TercerizacionServicio[] @relation("TercerizacionDestino")

  // Relaciones para vinculación B2B
  vinculacionesSolicitadas   VinculacionEmpresa[] @relation("VinculacionesSolicitadas")
  vinculacionesRecibidas     VinculacionEmpresa[] @relation("VinculacionesRecibidas")
  clientesEmpresaVinculados  ClienteEmpresa[]     @relation("EmpresaVinculadaClientes")

  // Relaciones para avisos de mantenimiento
  configuracionAvisoMantenimiento ConfiguracionAvisoMantenimiento?
  avisosMantenimiento             AvisoMantenimiento[]

  // Relaciones para configuracion de documentos PDF
  configuracionDocumentos  ConfiguracionDocumentos?
  plantillasDocumentos     PlantillaDocumento[]

  // Relaciones para módulo de citas
  citas Cita[]

  // Relaciones para notificaciones
  notificaciones Notificacion[]

  @@index([subdominio])
  @@index([isActive])
  @@index([ruc])
  @@index([planSuscripcionId])
  @@index([fechaVencimiento])
  @@index([estadoSuscripcion])
  @@index([deletedAt])
  @@index([visibleEnMarketplace])
  @@index([destacadoMarketplace])
  @@index([ordenMarketplace])
  @@index([aceptaTercerizacion])
}

model ConfiguracionCodigos {
  id                    String   @id @default(cuid())
  empresaId             String   @unique
  productoCodigo        String   @default("PROD")
  productoSeparador     String   @default("-")
  productoLongitud      Int      @default(6)
  productoIncluirSede   Boolean  @default(false)
  servicioCodigo        String   @default("SERV")
  servicioSeparador     String   @default("-")
  servicioLongitud      Int      @default(6)
  servicioIncluirSede   Boolean  @default(false)
  varianteCodigo        String   @default("VAR")
  varianteSeparador     String   @default("-")
  varianteLongitud      Int      @default(6)
  ventaCodigo           String   @default("VTA")
  ventaSeparador        String   @default("-")
  ventaLongitud         Int      @default(8)
  ventaIncluirSede      Boolean  @default(true)
  facturaCodigo         String   @default("FAC")
  boletaCodigo          String   @default("BOL")
  notaCreditoCodigo     String   @default("NCR")
  notaDebitoCodigo      String   @default("NDB")
  documentoSeparador    String   @default("-")
  documentoLongitud     Int      @default(8)
  ultimoProducto        Int      @default(0)
  ultimoServicio        Int      @default(0)
  ultimaVariante        Int      @default(0)
  ultimaVenta           Int      @default(0)
  componenteCodigo      String   @default("COMP")
  componenteSeparador   String   @default("-")
  componenteLongitud    Int      @default(5)
  ultimoComponente      Int      @default(0)
  cotizacionCodigo      String   @default("COT")
  cotizacionSeparador   String   @default("-")
  cotizacionLongitud    Int      @default(6)
  cotizacionIncluirSede Boolean  @default(true)
  ultimaCotizacion      Int      @default(0)
  ordenServicioCodigo       String   @default("OS")
  ordenServicioSeparador    String   @default("-")
  ordenServicioLongitud     Int      @default(5)
  ultimaOrdenServicio       Int      @default(0)
  proveedorCodigo           String   @default("PROV")
  proveedorSeparador        String   @default("-")
  proveedorLongitud         Int      @default(3)
  ultimoProveedor           Int      @default(0)
  transferenciaCodigo       String   @default("TRANS")
  transferenciaSeparador    String   @default("-")
  transferenciaLongitud     Int      @default(5)
  ultimaTransferencia       Int      @default(0)
  ordenCompraCodigo         String   @default("OC")
  ordenCompraSeparador      String   @default("-")
  ordenCompraLongitud       Int      @default(5)
  ultimaOrdenCompra         Int      @default(0)
  compraCodigo              String   @default("COMPRA")
  compraSeparador           String   @default("-")
  compraLongitud            Int      @default(5)
  ultimaCompra              Int      @default(0)
  loteCodigo                String   @default("LOTE")
  loteSeparador             String   @default("-")
  loteLongitud              Int      @default(5)
  ultimoLote                Int      @default(0)
  sedeCodigo                String   @default("SEDE")
  sedeSeparador             String   @default("-")
  sedeLongitud              Int      @default(3)
  ultimaSede                Int      @default(0)
  reporteIncidenciaCodigo   String   @default("RPI")
  reporteIncidenciaSeparador String  @default("-")
  reporteIncidenciaLongitud Int      @default(4)
  ultimoReporteIncidencia   Int      @default(0)
  inventarioCodigo          String   @default("INV")
  inventarioSeparador       String   @default("-")
  inventarioLongitud        Int      @default(4)
  ultimoInventario          Int      @default(0)
  clienteEmpresaCodigo    String   @default("CE")
  clienteEmpresaSeparador String   @default("-")
  clienteEmpresaLongitud  Int      @default(3)
  ultimoClienteEmpresa    Int      @default(0)
  citaCodigo              String   @default("CITA")
  citaSeparador           String   @default("-")
  citaLongitud            Int      @default(5)
  ultimaCita              Int      @default(0)
  ultimoFactura         Int      @default(0)
  ultimaBoleta          Int      @default(0)
  ultimaNotaCredito     Int      @default(0)
  ultimaNotaDebito      Int      @default(0)
  creadoEn              DateTime @default(now())
  actualizadoEn         DateTime @updatedAt
  empresa               Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
}

model Sede {
  id        String   @id @default(cuid())
  empresaId String
  codigo    String   @default("SEDE-001") // Código único de la sede (ej: "SEDE-001", "LIMA-CENTRO")
  nombre    String
  telefono  String?
  email     String?
  tipoSede  TipoSede @default(OPERATIVA_COMPLETA) // Tipo de operación de la sede

  // Ubicación completa
  direccion    String?
  referencia   String?
  distrito     String?
  provincia    String?
  departamento String?
  pais         String? @default("PERU")
  coordenadas  Json? // {lat: -12.0464, lon: -77.0428} para geolocalización

  // Configuración operativa
  horarioAtencion Json? // {"lunes": {"inicio": "09:00", "fin": "18:00"}, ...}
  configuracion   Json? // Configuraciones específicas de la sede

  // Series de comprobantes por sede
  serieFactura      String  @default("F001")
  serieBoleta       String  @default("B001")
  serieNotaCredito  String  @default("NC01")
  serieNotaDebito   String  @default("ND01")
  serieGuiaRemision String? @default("GR01")

  // Contadores de documentos por sede
  ultimoNumeroFactura      Int @default(0)
  ultimoNumeroBoleta       Int @default(0)
  ultimoNumeroNotaCredito  Int @default(0)
  ultimoNumeroNotaDebito   Int @default(0)
  ultimoNumeroGuiaRemision Int @default(0)

  // Estado
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  esPrincipal Boolean   @default(false)

  // Auditoría
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // Relaciones
  direcciones DireccionSede[]
  productos   Producto[]
  empresa     Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  servicios   Servicio[]
  usuarios    UsuarioSedeRol[]

  // Relaciones para sistema de descuentos
  historialDescuentos DescuentoUsoHistorial[]

  // Relaciones para inventario por sede
  stocksProductos       ProductoStock[]
  movimientosStock      MovimientoStock[]
  transferenciasOrigen  TransferenciaStock[]          @relation("TransferenciasOrigen")
  transferenciasDestino TransferenciaStock[]          @relation("TransferenciasDestino")
  historialPreciosSede  ProductoPrecioHistorialSede[] @relation("SedeCambiosPrecios")
  reservacionesCombos   ComboReservacion[]

  // Relaciones para devoluciones
  devoluciones Devolucion[]

  // Relaciones para reportes de incidencias
  reportesIncidencia     ReporteIncidencia[]
  itemsReporteIncidencia ReporteIncidenciaItem[]

  // Relaciones para inventarios
  inventarios     Inventario[]
  itemsInventario InventarioItem[]

  // Relaciones para cotizaciones
  cotizaciones Cotizacion[]

  // Relaciones para módulo de compras
  ordenesCompra OrdenCompra[]
  compras       Compra[]
  lotes         Lote[]

  // Relaciones para módulo de citas
  citas Cita[]

  // Relaciones futuras (descomentar cuando se implementen)
  // ventas      Venta[]
  // cajas       Caja[]

  @@unique([empresaId, codigo])
  @@index([empresaId])
  @@index([codigo])
  @@index([isActive])
  @@index([esPrincipal])
  @@index([deletedAt])
  @@index([tipoSede])
  @@index([empresaId, isActive])
  @@index([empresaId, deletedAt])
  @@index([empresaId, isActive, deletedAt])
}

model DireccionSede {
  id            String    @id @default(cuid())
  sedeId        String
  direccion     String
  referencia    String?
  distrito      String?
  provincia     String?
  departamento  String?
  pais          String?   @default("PERU")
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt
  sede          Sede      @relation(fields: [sedeId], references: [id])

  @@index([sedeId])
  @@index([deletedAt])
}

model PlanSuscripcion {
  id                        String             @id @default(cuid())
  nombre                    String             @unique
  descripcion               String
  precio                    Decimal            @db.Decimal(10, 2)
  periodo                   PeriodoSuscripcion
  limiteProductos           Int?
  limiteServicios           Int?
  limiteUsuarios            Int?
  limiteSedes               Int?
  limitePlantillasAtributos Int? // Límite de plantillas personalizadas
  limiteCotizaciones        Int? // Límite de cotizaciones
  tienePersonalizacion      Boolean            @default(false)
  tieneDominioPropio        Boolean            @default(false)
  tieneApi                  Boolean            @default(false)
  tieneReportesAvanzados    Boolean            @default(false)
  caracteristicas           Json
  isActive                  Boolean            @default(true)
  creadoEn                  DateTime           @default(now())
  actualizadoEn             DateTime           @updatedAt
  empresas                  Empresa[]

  @@index([isActive])
  @@index([precio])
}

model PersonalizacionEmpresa {
  id                   String   @id @default(cuid())
  empresaId            String
  webConfig            Json?
  bannerPrincipalUrl   String?
  bannerPrincipalTexto String?
  bannerColor          String?  @default("#000000")
  colorPrimario        String?  @default("#007bff")
  colorSecundario      String?  @default("#6c757d")
  colorAcento          String?  @default("#28a745")
  mostrarPrecios       Boolean  @default(true)
  productosDestacados  String[]
  serviciosDestacados  String[]
  mostrarContacto      Boolean  @default(true)
  mostrarRedesSociales Boolean  @default(false)
  permitirRegistro     Boolean  @default(true)
  appConfig            Json?
  appSplashScreenUrl   String?
  appColorTema         String?  @default("#007bff")
  dominioPersonalizado String?  @unique
  creadoEn             DateTime @default(now())
  actualizadoEn        DateTime @updatedAt
  empresa              Empresa  @relation(fields: [empresaId], references: [id])

  @@index([empresaId])
  @@index([dominioPersonalizado])
}

model ConfiguracionEmpresa {
  id                        String   @id @default(cuid())
  empresaId                 String   @unique
  impuestoDefaultPorcentaje Float    @default(18.0)
  nombreImpuesto            String   @default("IGV")
  monedaPrincipal           String   @default("PEN")
  simboloMoneda             String   @default("S/")
  monedasPermitidas         String[] @default(["PEN", "USD"])
  diasVigenciaCotizacion    Int      @default(30)
  condicionesDefault        String?

  // Etiquetas personalizables para sección equipo en órdenes de servicio
  etiquetaSeccionEquipo     String?  // "EQUIPO", "VEHICULO", "SERVICIO", etc.
  etiquetaTipoEquipo        String?  // "Tipo de equipo", "Tipo de vehículo", etc.
  etiquetaMarcaEquipo       String?  // "Marca", "Marca/Modelo", etc.
  etiquetaNumeroSerie       String?  // "Número de serie", "Placa", "N° Chasis", etc.
  etiquetaCondicionEquipo   String?  // "Condición del equipo", "Estado del vehículo", etc.
  mostrarSeccionEquipo      Boolean  @default(true)  // Permite ocultar la sección completa

  creadoEn                  DateTime @default(now())
  actualizadoEn             DateTime @updatedAt
  empresa                   Empresa  @relation(fields: [empresaId], references: [id])

  @@index([empresaId])
}

// Tipos de sede según su función operativa
enum TipoSede {
  OPERATIVA_COMPLETA // Ventas + Almacén + Servicios (sede completa)
  SOLO_ALMACEN // Solo inventario y transferencias (sin ventas directas)
  PUNTO_VENTA // Solo ventas (recibe stock por transferencia)
  OFICINA_ADMINISTRATIVA // Solo administración (sin operaciones comerciales)
  TALLER_LABORATORIO // Taller de reparación o laboratorio de servicios
}

enum PeriodoSuscripcion {
  MENSUAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
  PERSONALIZADO
}

enum EstadoSuscripcion {
  ACTIVA
  VENCIDA
  CANCELADA
  SUSPENDIDA
  EN_PROBATION
}

enum RubroEmpresa {
  TECNOLOGIA
  GASTRONOMIA
  MODA
  HOGAR
  SALUD
  AUTOMOTRIZ
  DEPORTES
  CONSTRUCCION
  EDUCACION
  OTRO
}
