// ═══════════════════════════════════════════════════════════════════
// DELIVERY LOCAL — repartidores propios de la empresa (F1)
//
// Regla de plata (decisión 07-23): el PRODUCTO se paga completo ANTES
// (gate: venta PAGADA_COMPLETA — el repartidor jamás cobra el producto);
// el repartidor cobra SOLO su tarifa de delivery al entregar, en
// efectivo. En F1 esa tarifa es informativa (sin caja/tesorería — la
// liquidación del repartidor es F3).
// ═══════════════════════════════════════════════════════════════════

enum EstadoDeliveryLocal {
  SOLICITADO // pagado y publicado — visible en el pool de repartidores
  TOMADO // un repartidor lo reclamó (asignación atómica)
  EN_CAMINO // recogió el paquete y va al destino
  ENTREGADO // entregado y tarifa cobrada por el repartidor
  CANCELADO
}

enum EstadoOfertaDelivery {
  PENDIENTE
  ACEPTADA
  RECHAZADA // la empresa eligió otra oferta
  RETIRADA // el propio repartidor la dio de baja
}

// Subasta estilo inDrive: la empresa NO puede saber cuánto sale llegar a
// cada zona — el que lo sabe es el repartidor. En vez de decretar la
// tarifa, la empresa publica (con precio sugerido o sin nada) y los
// repartidores ofertan; la empresa elige y ahí recién se asigna.
//
// ⚠️ VENCIMIENTO: una oferta vieja no sirve — el repartidor ya puede estar
// ocupado. Vencen a los 10 min y NO hay job que las marque: se derivan
// comparando `expiraEn` contra ahora. Todo lo que lea ofertas PENDIENTES
// tiene que filtrar por `expiraEn > now()`, y aceptar tiene que revalidarlo.
model OfertaDelivery {
  id           String @id @default(cuid())
  deliveryId   String
  // Usuario del repartidor (freelance o empleado): mismo criterio que
  // DeliveryLocal.repartidorId.
  repartidorId String

  monto      Decimal @db.Decimal(10, 2)
  comentario String? // "esa zona son 20 min de ida"

  estado EstadoOfertaDelivery @default(PENDIENTE)

  creadoEn   DateTime  @default(now())
  expiraEn   DateTime
  resueltoEn DateTime?

  delivery   DeliveryLocal @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  repartidor Usuario       @relation("OfertaRepartidor", fields: [repartidorId], references: [id])

  // Una oferta viva por repartidor y delivery: re-ofertar pisa la anterior.
  @@unique([deliveryId, repartidorId])
  @@index([deliveryId, estado])
  @@index([repartidorId, estado])
  // Histórico de tarifas: filtra ACEPTADA + ventana de 90 días y ordena por
  // `resueltoEn`. Sin esto, cada consulta de tarifa sugerida escanea toda
  // la tabla de ofertas.
  @@index([estado, resueltoEn])
  @@map("oferta_delivery")
}

// Geocoder PROPIO (Fase 1): cada dirección CONFIRMADA con pin (delivery
// creado) alimenta la búsqueda local del picker — los lugares reales de la
// zona ("Mz B Lt 5", mercados, referencias) que los geocoders externos no
// conocen. La base crece sola con el uso; Fase 2 agrega Google como
// fallback y sus confirmaciones también aterrizan aquí.
model DireccionFrecuente {
  id               String   @id @default(cuid())
  empresaId        String
  // Texto tal como lo confirmó el usuario + normalizado (minúsculas, sin
  // tildes) para la búsqueda por similitud/trigram.
  texto            String
  textoNormalizado String
  referencia       String?
  distrito         String?
  lat              Decimal  @db.Decimal(10, 7)
  lon              Decimal  @db.Decimal(10, 7)
  // Celular del destinatario: habilita "direcciones recientes del cliente".
  telefonoCliente  String?
  usos             Int      @default(1)
  ultimoUsoEn      DateTime @default(now())
  creadoEn         DateTime @default(now())
  empresa          Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, textoNormalizado])
  @@index([empresaId, telefonoCliente])
}

model DeliveryLocal {
  id        String @id @default(cuid())
  empresaId String
  sedeId    String

  // Origen: venta (bot IA / POS / online). Única por venta.
  ventaId             String? @unique
  // Reservado para F2 (pedido web directo, aún sin FK).
  pedidoMarketplaceId String? @unique

  estado EstadoDeliveryLocal @default(SOLICITADO)

  destinatarioNombre  String
  destinatarioCelular String?
  direccion           String
  referencia          String?
  distrito            String?
  coordenadas         Json? // {lat, lon} — F2: ubicación compartida por WhatsApp

  // Delivery INTERNO: lo lleva un empleado de la empresa — se cobra la
  // tarifa igual, pero NO se publica al pool ni se notifica repartidores;
  // el staff avanza los estados (SOLICITADO → EN_CAMINO → ENTREGADO, sin
  // PIN — es personal de confianza).
  esInterno        Boolean @default(false)
  encargadoInterno String? // nombre del empleado que lo lleva (informativo)

  // Tarifa que cobra el REPARTIDOR al entregar (default: Sede.tarifaDeliveryLocal).
  costoDelivery Decimal @default(0) @db.Decimal(10, 2)

  repartidorId      String?
  tomadoEn          DateTime?
  enCaminoEn        DateTime?
  entregadoEn       DateTime?
  canceladoEn       DateTime?
  motivoCancelacion String?

  // Seguimiento público del cliente (sin login): /tracking/<token>.
  trackingToken String @unique @default(cuid())

  // PIN de ENTREGA (prueba de entrega): se genera al salir EN_CAMINO y le
  // llega SOLO al cliente (WhatsApp + su tracking). El repartidor debe
  // ingresarlo para marcar ENTREGADO — sin PIN correcto no hay entrega.
  pinEntrega String?

  // GPS en vivo (F3): última posición del repartidor {lat, lon}. Solo se
  // reporta/expone mientras EN_CAMINO; al ENTREGADO se deja de emitir.
  ultimaPosicion Json?
  posicionEn     DateTime?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // Subasta: mientras `modoOferta` esté activo el delivery NO se puede
  // tomar directo — solo por oferta aceptada. Si conviven las dos vías, el
  // primero que acepta el precio base gana siempre y la subasta nunca pasa.
  modoOferta    Boolean  @default(false)
  // Ancla opcional para el repartidor. Puede ir vacío: la empresa
  // justamente puede no saber cuánto vale llegar a esa zona.
  costoSugerido Decimal? @db.Decimal(10, 2)

  venta      Venta?           @relation(fields: [ventaId], references: [id])
  repartidor Usuario?         @relation("DeliveryRepartidor", fields: [repartidorId], references: [id])
  ofertas    OfertaDelivery[]

  @@index([empresaId, estado])
  @@index([sedeId, estado])
  @@index([repartidorId, estado])
  @@map("delivery_local")
}
