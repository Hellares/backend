// Vinculación de WhatsApp por empresa vía Evolution API (no oficial,
// container interno `evolution-api`). La instancia en Evolution se llama
// `<prefijo>_<empresaId>` — prefijo beta|prod (EVOLUTION_INSTANCE_PREFIX)
// para compartir un solo Evolution entre ambientes.

enum EstadoWhatsappInstancia {
  PENDIENTE_QR // instancia creada, falta escanear el QR
  CONECTADO
  DESCONECTADO
}

model IntegracionWhatsapp {
  id           String                  @id @default(cuid())
  empresaId    String                  @unique
  instanceName String                  @unique
  estado       EstadoWhatsappInstancia @default(PENDIENTE_QR)
  // Número conectado (ownerJid sin sufijo) — informativo, llega al conectar.
  numero       String?
  // Plantilla del mensaje "premio enviado" (null = default del sistema).
  // Variables: {saludo} {ganador} {premio} {agencia} {destino} {orden}
  // {codigo} {clave} {empresa}. Las líneas cuyas variables queden todas
  // vacías se eliminan del mensaje final.
  plantillaPremio String?   @db.Text
  // Plantillas de las instrucciones de pago del BOT, una por tipo de
  // sorteo (null = default del sistema). Variables: {monto} {numero}
  // {empresa}. Misma regla de líneas vacías.
  plantillaPagoSorteo   String? @db.Text
  plantillaPagoDinamica String? @db.Text
  // Cabecera del mensaje de confirmación al VALIDAR el pago, por tipo
  // (null = default). Variables: {nombre} {titulo} {ticket} {empresa}.
  plantillaConfirmacionSorteo   String? @db.Text
  plantillaConfirmacionDinamica String? @db.Text
  // Agencia con la que la empresa hace TODOS los envíos: el bot la
  // informa ("los envíos se hacen por X") y no pregunta cuál.
  agenciaEnvio    String    @default("SHALOM")
  habilitado      Boolean   @default(true)
  conectadoEn     DateTime?
  creadoEn        DateTime  @default(now())
  actualizadoEn   DateTime  @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("integracion_whatsapp")
}

// Estado de la conversación del BOT con cada número que le escribe al
// WhatsApp de la empresa (máquina de estados: MENU, ESPERANDO_NOMBRE,
// ESPERANDO_DNI, ESPERANDO_AGENCIA…). contexto guarda datos parciales
// (sorteoId elegido, nombre ya capturado, premioId del ganador).
model ConversacionWhatsapp {
  id        String  @id @default(cuid())
  empresaId String
  celular   String
  estado    String  @default("MENU")
  contexto  Json?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@unique([empresaId, celular])
  @@map("conversacion_whatsapp")
}
