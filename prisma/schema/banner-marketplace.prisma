/// Catálogo de fondos animados (Lottie) para el banner del marketplace.
/// Los carga la PLATAFORMA (super admin); la empresa solo elige uno.
model LottieFondo {
  id       String   @id @default(cuid())
  nombre   String // ej. "Rayito", "Luz", "Confeti"
  url      String // .json/.lottie público (Contabo/CDN) o asset local del app
  /// Presentación en el banner: {fit: "cover"|"contain", alignment:
  /// "centerLeft"|"center"|"centerRight", widthFactor: 0-1, opacity: 0-1}.
  /// null = cover a pantalla completa. Editable sin APK (PATCH admin).
  config   Json?
  isActive Boolean  @default(true)
  orden    Int      @default(0)
  creadoEn DateTime @default(now())

  banners           BannerMarketplace[]
  avisosPlataforma  BannerPlataforma[]
}

/// Avisos del DUEÑO de la plataforma en el slider del home del marketplace
/// (festividades, promoción del propio app). Sin gating por empresa; con
/// vigencia programada (ej. banner de Navidad del 20 al 26 de diciembre).
model BannerPlataforma {
  id            String    @id @default(cuid())
  titulo        String? // línea inferior (rol de "nombre de empresa"); null = "Syncronize"
  texto         String // el aviso, ej. "¡FELIZ NAVIDAD! ENVÍOS GRATIS TODA LA SEMANA"
  colorFondo    String    @default("#C62828")
  colorTexto    String? // null = contraste automático
  colorBrillo   String? // null = default del app
  lottieFondoId String? // fondo animado del catálogo
  logoUrl       String? // icono opcional (null = ícono del app en el card)
  link          String? // al tocar: ruta interna ("/ofertas") o URL https; null = sin acción
  vigenciaDesde DateTime? // null = desde ya
  vigenciaHasta DateTime? // null = sin vencimiento
  isActive      Boolean   @default(true)
  orden         Int       @default(0)
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt

  lottieFondo LottieFondo? @relation(fields: [lottieFondoId], references: [id], onDelete: SetNull)

  @@index([isActive])
}

/// Banner promocional de empresa en el home del marketplace (slider 60px,
/// entre categorías y ofertas). Visible al público SOLO si la empresa tiene
/// la característica premium BANNER_MARKETPLACE vigente (gate runtime, no FK).
model BannerMarketplace {
  id            String   @id @default(cuid())
  empresaId     String   @unique // 1 banner por empresa
  texto         String // ej. "POR COMPRAS MAYORES A S/25 UNA MICA GRATIS"
  colorFondo    String   @default("#1565C0") // hex elegido por la empresa
  colorTexto    String? // hex; null = contraste automático según el fondo
  colorBrillo   String? // hex de la luz que recorre el texto; null = default app
  lottieFondoId String? // fondo animado opcional (del catálogo)
  isActive      Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  empresa     Empresa               @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  lottieFondo LottieFondo?          @relation(fields: [lottieFondoId], references: [id], onDelete: SetNull)
  metricas    BannerMetricaDiaria[]

  @@index([isActive])
}

/// Métricas diarias del banner (impresiones y taps) — la base para vender el
/// espacio publicitario: "tu banner se mostró X veces y recibió Y taps".
/// Un row por (banner, día zona Lima); se incrementa vía endpoints públicos.
model BannerMetricaDiaria {
  id          String   @id @default(cuid())
  bannerId    String
  fecha       DateTime @db.Date // día calendario en zona Lima (UTC-5)
  impresiones Int      @default(0)
  taps        Int      @default(0)

  banner BannerMarketplace @relation(fields: [bannerId], references: [id], onDelete: Cascade)

  @@unique([bannerId, fecha])
}
