// =========================================
// MÓDULO DE VENTAS
// =========================================

enum EstadoVenta {
  BORRADOR
  CONFIRMADA
  PAGADA_PARCIAL
  PAGADA_COMPLETA
  ANULADA
}

enum CanalVenta {
  POS // Punto de venta físico — requiere caja abierta
  COTIZACION // Desde cotización (atención presencial) — requiere caja abierta
  ONLINE // Tienda online / marketplace — no requiere caja
}

enum MetodoPagoVenta {
  EFECTIVO
  TARJETA
  YAPE
  PLIN
  TRANSFERENCIA
  CREDITO
  /// Venta con >1 método distinto en sus PagoVenta. Solo etiqueta UX —
  /// la fuente de verdad para reportería es la tabla PagoVenta.
  MIXTO
}

/// Venta a cliente
model Venta {
  id               String     @id @default(cuid())
  empresaId        String
  sedeId           String
  clienteId        String?
  clienteEmpresaId String?
  vendedorId       String
  cajeroId         String? // Usuario que procesó el cobro (POS)
  cotizacionId     String? // Cotización origen (si se creó desde una)
  canalVenta       CanalVenta @default(POS)

  // Identificación
  codigo String

  // Datos del cliente (snapshot al momento de crear)
  nombreCliente    String
  documentoCliente String?
  emailCliente     String?
  telefonoCliente  String?
  direccionCliente String?

  // Moneda
  moneda     String   @default("PEN")
  tipoCambio Decimal? @db.Decimal(10, 6)

  // Montos
  subtotal  Decimal @db.Decimal(10, 2)
  descuento Decimal @default(0) @db.Decimal(10, 2)
  impuestos Decimal @default(0) @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)

  // Descuento global (aplicado sobre el total, no por item)
  descuentoGlobal           Decimal?  @db.Decimal(10, 2)
  descuentoGlobalPorcentaje Decimal?  @db.Decimal(5, 2)
  descuentoAutorizadoPorId  String?
  descuentoAutorizadoEn     DateTime?

  // Autorización de venta bajo costo (margen negativo) — distinto del descuento global.
  // Requerido cuando alguna línea tiene margenSnapshot < 0 y el producto NO está
  // en liquidación activa. Solo GERENTE_SEDE / ADMINISTRADOR puede autorizar.
  ventaBajoCostoAutorizadaPorId String?
  ventaBajoCostoAutorizadaEn    DateTime?
  perdidaTotalLineas            Decimal?  @db.Decimal(10, 2) // Suma de márgenes negativos (snapshot)

  // Pago
  estado        EstadoVenta      @default(BORRADOR)
  metodoPago    MetodoPagoVenta?
  montoRecibido Decimal?         @db.Decimal(10, 2)
  montoCambio   Decimal?         @db.Decimal(10, 2)

  // Bancarización (Ley 28194) — el cajero confirmó la advertencia legal cuando
  // el efectivo de la venta excede el límite permitido (cliente asume riesgo
  // de no poder deducir IGV / sustento de gasto).
  bancarizacionAdvertida Boolean @default(false)

  // Crédito
  esCredito           Boolean  @default(false)
  plazoCredito        Int? // Días de crédito
  numeroCuotas        Int? // Número de cuotas
  montoCreditoInicial Decimal? @db.Decimal(10, 2) // Monto de la porción crédito (ventas mixtas)

  // Interés por crédito
  porcentajeInteres Decimal? @db.Decimal(5, 2) // % aplicado (null = 0%)
  montoInteres      Decimal? @db.Decimal(10, 2) // Monto calculado del interés
  totalConInteres   Decimal? @db.Decimal(10, 2) // montoCreditoInicial + montoInteres

  fechaVencimientoPago DateTime?

  // Fechas
  fechaVenta    DateTime @default(now())
  observaciones String?

  // Anulacion
  motivoAnulacion String?
  anuladoPorId    String?
  autorizadoPorId String?
  fechaAnulacion  DateTime?

  // Auditoría
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // Relaciones
  empresa                     Empresa                 @relation(fields: [empresaId], references: [id])
  sede                        Sede                    @relation(fields: [sedeId], references: [id])
  cliente                     EmpresaPersona?         @relation(fields: [clienteId], references: [id])
  clienteEmpresa              ClienteEmpresa?         @relation(fields: [clienteEmpresaId], references: [id])
  vendedor                    Usuario                 @relation("VentaVendedor", fields: [vendedorId], references: [id])
  cajero                      Usuario?                @relation("VentaCajero", fields: [cajeroId], references: [id])
  anuladoPor                  Usuario?                @relation("VentaAnuladaPor", fields: [anuladoPorId], references: [id])
  autorizadoPorAnulacion      Usuario?                @relation("VentaAutorizadaAnulacion", fields: [autorizadoPorId], references: [id])
  ventaBajoCostoAutorizadaPor Usuario?                @relation("VentaBajoCostoAutorizadaPor", fields: [ventaBajoCostoAutorizadaPorId], references: [id])
  cotizacion                  Cotizacion?             @relation("VentaCotizacion", fields: [cotizacionId], references: [id])
  cotizacionesOrigen          Cotizacion[]            @relation("CotizacionVenta") // Back-relation for cotizacion.ventaId
  detalles                    VentaDetalle[]
  pagos                       PagoVenta[]
  cuotas                      CuotaVenta[]
  movimientos                 MovimientoStock[]
  devoluciones                Devolucion[]
  movimientosCaja             MovimientoCaja[]        @relation("MovimientoCajaVenta")
  comprobante                 ComprobanteElectronico?
  guiasRemision               GuiaRemision[]

  @@unique([empresaId, codigo])
  // FK indexes
  @@index([empresaId])
  @@index([sedeId])
  @@index([vendedorId])
  @@index([cajeroId])
  @@index([clienteId])
  @@index([clienteEmpresaId])
  @@index([cotizacionId])
  // Queries frecuentes
  @@index([estado])
  @@index([fechaVenta])
  @@index([empresaId, estado])
  @@index([empresaId, sedeId, estado])
  // Reportes y analytics (fecha + empresa + sede)
  @@index([empresaId, fechaVenta])
  @@index([empresaId, sedeId, fechaVenta])
  // Créditos: listado de ventas a crédito pendientes
  @@index([empresaId, esCredito, estado])
  // Canal de venta (POS/ONLINE/COTIZACION)
  @@index([empresaId, canalVenta, fechaVenta])
  // Búsqueda por documento del cliente
  @@index([empresaId, documentoCliente])
}

/// Detalle/línea de una venta
model VentaDetalle {
  id         String  @id @default(cuid())
  ventaId    String
  productoId String?
  varianteId String?
  servicioId String?
  comboId    String?

  // Datos del item (snapshot)
  descripcion    String
  cantidad       Decimal @db.Decimal(10, 2)
  precioUnitario Decimal @db.Decimal(10, 2)
  descuento      Decimal @default(0) @db.Decimal(10, 2)

  // Snapshot del costo unitario al momento de la venta (deuda técnica
  // necesaria para reportería histórica de margen). Si cambia el
  // precioCosto después, el margen ya vendido queda preservado.
  precioCostoSnapshot       Decimal            @default(0) @db.Decimal(10, 2)
  // Margen unitario = (precioUnitario - descuentoUnitario) - precioCostoSnapshot.
  // Negativo cuando se vende bajo costo (liquidación o autorización).
  margenSnapshot            Decimal            @default(0) @db.Decimal(10, 2)
  // Si el item se vendió en estado liquidación, copia del motivo
  // (snapshot) para reportería. Null cuando margen no fue negativo o
  // cuando la venta bajo costo se autorizó manualmente sin liquidación.
  motivoLiquidacionSnapshot MotivoLiquidacion?

  // Impuesto
  tipoAfectacion String  @default("10") // SUNAT Cat.07: 10=Gravado, 20=Exonerado, 30=Inafecto
  porcentajeIGV  Decimal @default(18.00) @db.Decimal(5, 2)
  igv            Decimal @default(0) @db.Decimal(10, 2)
  icbper         Decimal @default(0) @db.Decimal(10, 2)

  // Totales
  subtotal Decimal @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  // Orden
  orden Int @default(0)

  // Trazabilidad de combo: cuando un VentaDetalle es un componente vendido
  // como parte de un combo expandido, estos campos identifican el combo
  // de origen. El combo es un Producto con esCombo=true (la FK reusa la
  // misma tabla Producto). Snapshot del nombre para no perderlo si luego
  // se renombra el combo. Null cuando el item se vendió suelto.
  origenComboId     String?
  origenComboNombre String? @db.VarChar(120)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // Relaciones
  venta        Venta             @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  producto     Producto?         @relation(fields: [productoId], references: [id])
  variante     ProductoVariante? @relation(fields: [varianteId], references: [id])
  servicio     Servicio?         @relation(fields: [servicioId], references: [id])
  origenCombo  Producto?         @relation("VentaDetalleOrigenCombo", fields: [origenComboId], references: [id])
  devoluciones DevolucionItem[]

  @@index([ventaId])
  @@index([productoId])
  @@index([varianteId])
  @@index([servicioId])
  @@index([origenComboId])
  @@index([motivoLiquidacionSnapshot]) // Reportería de liquidaciones por motivo
}

/// Registro de pagos de una venta (soporta pagos parciales/múltiples)
model PagoVenta {
  id           String          @id @default(cuid())
  ventaId      String
  cuotaVentaId String? // Cuota específica a la que aplica este pago
  metodoPago   MetodoPagoVenta
  monto        Decimal         @db.Decimal(10, 2) // Monto en soles (siempre PEN)
  referencia   String? // Número de operación, voucher, etc.
  banco        String?         @db.VarChar(50) // Entidad financiera (TARJETA/TRANSFERENCIA)
  fechaPago    DateTime        @default(now())

  // Desglose del pago (principal, interés, mora)
  montoPrincipal Decimal? @db.Decimal(10, 2) // Porción aplicada a principal
  montoInteres   Decimal? @db.Decimal(10, 2) // Porción aplicada a interés
  montoMora      Decimal? @db.Decimal(10, 2) // Porción aplicada a mora

  // Pago en moneda extranjera
  monedaOriginal String? // PEN o USD (null = PEN)
  montoOriginal  Decimal? @db.Decimal(10, 2) // Monto en moneda original
  tipoCambio     Decimal? @db.Decimal(10, 4) // Tipo de cambio usado

  creadoEn DateTime @default(now())

  // Relaciones
  venta      Venta       @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  cuotaVenta CuotaVenta? @relation(fields: [cuotaVentaId], references: [id])

  @@index([ventaId])
  @@index([fechaPago])
  @@index([cuotaVentaId])
}

// =========================================
// CUOTAS DE VENTA (CRÉDITO)
// =========================================

enum EstadoCuota {
  PENDIENTE
  PAGADA_PARCIAL
  PAGADA
  VENCIDA
  ANULADA // Cuota cancelada por reversión total de la venta (comprobante anulado)
}

/// Cuota individual de una venta a crédito
model CuotaVenta {
  id      String @id @default(cuid())
  ventaId String
  numero  Int // 1, 2, 3...

  monto          Decimal @db.Decimal(10, 2) // Total cuota = montoPrincipal + montoInteres
  montoPagado    Decimal @default(0) @db.Decimal(10, 2) // Total pagado (principal + interés)
  saldoPendiente Decimal @db.Decimal(10, 2)

  // Desglose principal / interés
  montoPrincipal Decimal @default(0) @db.Decimal(10, 2) // Porción del capital
  montoInteres   Decimal @default(0) @db.Decimal(10, 2) // Porción del interés por crédito

  // Tracking de pagos por componente
  montoPagadoPrincipal Decimal @default(0) @db.Decimal(10, 2)
  montoPagadoInteres   Decimal @default(0) @db.Decimal(10, 2)
  montoPagadoMora      Decimal @default(0) @db.Decimal(10, 2)

  fechaVencimiento DateTime
  estado           EstadoCuota @default(PENDIENTE)

  // Mora por vencimiento
  montoMora        Decimal?  @db.Decimal(10, 2)
  diasVencido      Int       @default(0)
  fechaCalculoMora DateTime?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // Relaciones
  venta Venta       @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  pagos PagoVenta[]

  @@unique([ventaId, numero])
  @@index([ventaId])
  @@index([estado])
  @@index([fechaVencimiento])
  @@index([ventaId, estado])
}
