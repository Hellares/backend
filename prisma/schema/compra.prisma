// =========================================
// MÓDULO DE COMPRAS - ÓRDENES, RECEPCIONES Y LOTES
// =========================================

// ========== ENUMS ==========

enum EstadoOrdenCompra {
  BORRADOR
  PENDIENTE
  APROBADA
  PARCIAL
  COMPLETADA
  CANCELADA
}

enum EstadoCompra {
  BORRADOR
  CONFIRMADA
  ANULADA
}

enum EstadoLote {
  ACTIVO
  AGOTADO
  VENCIDO
  BLOQUEADO
}

// ========== ORDEN DE COMPRA ==========

/// Orden de Compra a proveedor (PO)
/// Documento que formaliza el pedido de mercancía a un proveedor
model OrdenCompra {
  id          String @id @default(cuid())
  empresaId   String
  sedeId      String
  proveedorId String

  // Identificación
  codigo String // OC-2026-00001 (único por empresa)

  // Snapshot del proveedor al momento de crear la OC
  nombreProveedor    String
  documentoProveedor String?
  emailProveedor     String?
  telefonoProveedor  String?
  direccionProveedor String?

  // Términos comerciales
  terminosPago TerminosPago?
  diasCredito  Int?

  // Moneda
  moneda     String   @default("PEN")
  tipoCambio Decimal? @db.Decimal(10, 4)

  // Montos calculados
  subtotal  Decimal @default(0) @db.Decimal(12, 2)
  descuento Decimal @default(0) @db.Decimal(12, 2)
  impuestos Decimal @default(0) @db.Decimal(12, 2)
  total     Decimal @default(0) @db.Decimal(12, 2)

  // Fechas
  fechaEmision         DateTime  @default(now())
  fechaEntregaEsperada DateTime?
  fechaAprobacion      DateTime?

  // Estado
  estado EstadoOrdenCompra @default(BORRADOR)

  // Observaciones
  observaciones String?
  condiciones   String?

  // Auditoría
  creadoPor      String
  aprobadoPor    String?
  actualizadoPor String?
  creadoEn       DateTime @default(now())
  actualizadoEn  DateTime @updatedAt

  // Relaciones
  empresa   Empresa              @relation(fields: [empresaId], references: [id])
  sede      Sede                 @relation(fields: [sedeId], references: [id])
  proveedor Proveedor            @relation(fields: [proveedorId], references: [id])
  detalles  OrdenCompraDetalle[]
  compras   Compra[]

  @@unique([empresaId, codigo])
  @@index([empresaId, estado])
  @@index([empresaId, sedeId, estado])
  @@index([empresaId, proveedorId])
  @@index([empresaId, estado, creadoEn(sort: Desc)])
  @@index([creadoEn])
  // GIN trigram para ILIKE '%texto%' — ver feedback_prisma_drop_gin_trgm_drift.md
  @@index([nombreProveedor(ops: raw("gin_trgm_ops"))], type: Gin, map: "OrdenCompra_nombreProveedor_trgm_idx")
  @@index([codigo(ops: raw("gin_trgm_ops"))], type: Gin, map: "OrdenCompra_codigo_trgm_idx")
}

/// Detalle de una Orden de Compra
model OrdenCompraDetalle {
  id            String  @id @default(cuid())
  ordenCompraId String
  productoId    String?
  varianteId    String?

  // Descripción y cantidades.
  // `cantidad` y `precioUnitario` SIEMPRE en unidad atómica (de venta/
  // stock del producto). Si la línea se cargó en unidad de compra
  // (PAQUETE/KG/...), el service convierte antes de persistir.
  descripcion    String
  cantidad       Int
  precioUnitario Decimal @db.Decimal(14, 6)
  descuento      Decimal @default(0) @db.Decimal(12, 2)

  // ─── Snapshot Unidad de Compra ────────────────────────────────
  // Idem CompraDetalle. Se propaga al CompraDetalle cuando se recibe
  // la mercadería para mantener trazabilidad de "cómo se compró".
  usaUnidadCompra       Boolean  @default(false)
  cantidadOriginal      Decimal? @db.Decimal(12, 4)
  unidadOriginalSimbolo String?
  factorAplicado        Decimal? @db.Decimal(12, 4)

  // IGV
  porcentajeIGV Decimal @default(18) @db.Decimal(5, 2)
  igv           Decimal @default(0) @db.Decimal(12, 2)

  // Totales
  subtotal Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)

  // Tracking de recepción
  cantidadRecibida  Int @default(0)
  cantidadPendiente Int

  // Orden de la línea
  orden Int @default(0)

  // Relaciones
  ordenCompra    OrdenCompra       @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)
  producto       Producto?         @relation(fields: [productoId], references: [id])
  variante       ProductoVariante? @relation(fields: [varianteId], references: [id])
  compraDetalles CompraDetalle[]

  @@index([ordenCompraId])
  @@index([ordenCompraId, cantidadPendiente])
  @@index([productoId])
  @@index([varianteId])
}

// ========== COMPRA (RECEPCIÓN DE MERCANCÍA) ==========

/// Compra / Recepción de mercancía
/// Registra la entrada física de productos al almacén
model Compra {
  id            String  @id @default(cuid())
  empresaId     String
  sedeId        String
  proveedorId   String
  ordenCompraId String?

  // Identificación
  codigo String // COMP-2026-00001

  // Snapshot del proveedor
  nombreProveedor    String
  documentoProveedor String?

  // Documento del proveedor (factura/boleta del proveedor)
  tipoDocumentoProveedor   String?
  serieDocumentoProveedor  String?
  numeroDocumentoProveedor String?

  // Términos comerciales
  terminosPago         TerminosPago?
  diasCredito          Int?
  fechaVencimientoPago DateTime?

  // Moneda
  moneda     String   @default("PEN")
  tipoCambio Decimal? @db.Decimal(10, 4)

  // Convención de IGV en los precios ingresados. Default true porque
  // en Perú el proveedor típicamente factura con precios YA incluido
  // IGV. Si true → calcularDetalle EXTRAE el IGV del precio ingresado.
  // Si false → el precio ingresado es la base y el IGV se suma encima.
  precioIncluyeIgv Boolean @default(true)

  // Montos calculados.
  // SUNAT/contable: subtotal = SIEMPRE base imponible (sin IGV);
  // impuestos = IGV total; total = lo efectivamente pagado.
  subtotal  Decimal @default(0) @db.Decimal(12, 2)
  descuento Decimal @default(0) @db.Decimal(12, 2)
  impuestos Decimal @default(0) @db.Decimal(12, 2)
  total     Decimal @default(0) @db.Decimal(12, 2)

  // Fechas
  fechaRecepcion DateTime @default(now())

  // Estado
  estado EstadoCompra @default(BORRADOR)

  // Marca que la compra entró al flujo de PAGOS (CxP): true para crédito, y
  // para contado cuando NO se pagó al confirmar (se paga después). false si se
  // pagó al confirmar (contado pagado). Define qué aparece en Cuentas por Pagar.
  pagoPendiente Boolean @default(false)

  // Observaciones
  observaciones String?

  // Auditoría
  creadoPor      String
  confirmadoPor  String?
  actualizadoPor String?
  creadoEn       DateTime  @default(now())
  confirmadoEn   DateTime?
  actualizadoEn  DateTime  @updatedAt

  // Relaciones
  empresa         Empresa           @relation(fields: [empresaId], references: [id])
  sede            Sede              @relation(fields: [sedeId], references: [id])
  proveedor       Proveedor         @relation(fields: [proveedorId], references: [id])
  ordenCompra     OrdenCompra?      @relation(fields: [ordenCompraId], references: [id])
  detalles        CompraDetalle[]
  lotes           Lote[]
  movimientos     MovimientoStock[]
  devoluciones    Devolucion[]
  movimientosCaja MovimientoCaja[]  @relation("MovimientoCajaCompra")
  pagos           PagoCompra[]
  guiasRemision   GuiaRemision[]

  @@unique([empresaId, codigo])
  @@index([empresaId, estado])
  @@index([empresaId, sedeId])
  @@index([empresaId, sedeId, estado])
  @@index([empresaId, proveedorId])
  @@index([empresaId, estado, creadoEn(sort: Desc)])
  @@index([ordenCompraId])
  @@index([creadoEn])
  // GIN trigram para ILIKE '%texto%' — ver feedback_prisma_drop_gin_trgm_drift.md
  @@index([nombreProveedor(ops: raw("gin_trgm_ops"))], type: Gin, map: "Compra_nombreProveedor_trgm_idx")
  @@index([codigo(ops: raw("gin_trgm_ops"))], type: Gin, map: "Compra_codigo_trgm_idx")
}

/// Detalle de una Compra
model CompraDetalle {
  id                   String  @id @default(cuid())
  compraId             String
  ordenCompraDetalleId String?
  productoId           String?
  varianteId           String?

  // Descripción y cantidades.
  // `cantidad` y `precioUnitario` SIEMPRE están en la unidad atómica
  // (= unidad de venta/stock del producto). Si la línea se cargó
  // originalmente en unidad de compra (PAQUETE/KG/DOCENA), el service
  // convierte antes de persistir y guarda los snapshots para que la
  // UI muestre la doble vista.
  descripcion    String
  cantidad       Int
  precioUnitario Decimal @db.Decimal(14, 6)
  descuento      Decimal @default(0) @db.Decimal(12, 2)

  // ─── Snapshot Unidad de Compra ────────────────────────────────
  // Trazabilidad de cómo se ingresó originalmente la línea cuando se
  // usó la unidad de compra del producto. Cero impacto en cálculos:
  // los totales y stock siguen tomando `cantidad` y `precioUnitario`.
  usaUnidadCompra       Boolean  @default(false)
  cantidadOriginal      Decimal? @db.Decimal(12, 4) // Ej: 10 (paquetes)
  unidadOriginalSimbolo String?  // Ej: "PAQ" (snapshot del símbolo)
  factorAplicado        Decimal? @db.Decimal(12, 4) // Ej: 100 (snapshot del factor en el momento de la compra)

  // ─── Ajuste de precio venta al confirmar ──────────────────────
  // Opcional. Si la línea trae un nuevo precio de venta, al confirmar
  // la compra se actualiza también el `precio` del ProductoStock y se
  // registra en `ProductoPrecioHistorialSede` con origenModulo=COMPRA.
  // Si la compra queda en BORRADOR o se anula, no se aplica.
  nuevoPrecioVenta Decimal? @db.Decimal(14, 6)

  // IGV
  porcentajeIGV Decimal @default(18) @db.Decimal(5, 2)
  igv           Decimal @default(0) @db.Decimal(12, 2)

  // Totales
  subtotal Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)

  // Lote asignado al confirmar
  loteId String?

  // Orden de la línea
  orden Int @default(0)

  // Relaciones
  compra             Compra              @relation(fields: [compraId], references: [id], onDelete: Cascade)
  ordenCompraDetalle OrdenCompraDetalle? @relation(fields: [ordenCompraDetalleId], references: [id])
  producto           Producto?           @relation(fields: [productoId], references: [id])
  variante           ProductoVariante?   @relation(fields: [varianteId], references: [id])
  lote               Lote?               @relation(fields: [loteId], references: [id])

  @@index([compraId])
  @@index([ordenCompraDetalleId])
  @@index([productoId])
  @@index([varianteId])
  @@index([loteId])
}

// ========== LOTE (BATCH DE PRODUCTO) ==========

/// Lote/Batch de producto
/// Cada recepción de mercancía genera un lote con su propio costo
model Lote {
  id              String  @id @default(cuid())
  empresaId       String
  sedeId          String
  productoStockId String
  productoId      String?
  varianteId      String?
  compraId        String?

  // Identificación
  codigo     String // LOTE-2026-00001
  numeroLote String? // Número de lote del fabricante

  // Costo unitario de ESTE lote
  precioCosto Decimal @db.Decimal(14, 6)
  moneda      String  @default("PEN")

  // Cantidades
  cantidadInicial   Int
  cantidadActual    Int
  cantidadReservada Int @default(0)

  // Fechas
  fechaIngreso     DateTime  @default(now())
  fechaProduccion  DateTime?
  fechaVencimiento DateTime?

  // Estado
  estado EstadoLote @default(ACTIVO)

  // Proveedor referencia
  proveedorId     String?
  nombreProveedor String?

  // Auditoría
  observaciones String?
  creadoPor     String
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // Relaciones
  empresa        Empresa           @relation(fields: [empresaId], references: [id])
  sede           Sede              @relation(fields: [sedeId], references: [id])
  productoStock  ProductoStock     @relation(fields: [productoStockId], references: [id])
  producto       Producto?         @relation(fields: [productoId], references: [id])
  variante       ProductoVariante? @relation(fields: [varianteId], references: [id])
  compra         Compra?           @relation(fields: [compraId], references: [id])
  proveedor      Proveedor?        @relation(fields: [proveedorId], references: [id])
  detallesCompra CompraDetalle[]

  @@unique([empresaId, codigo])
  @@index([productoStockId, estado])
  @@index([productoStockId, fechaIngreso])
  @@index([empresaId, fechaVencimiento])
  @@index([empresaId, estado])
  @@index([empresaId, sedeId, estado])
  @@index([empresaId, estado, creadoEn(sort: Desc)])
  @@index([sedeId])
  @@index([compraId])
  @@index([proveedorId])
  // GIN trigram para ILIKE '%texto%' — ver feedback_prisma_drop_gin_trgm_drift.md
  // NOTA: Lote_nombreProveedor_trgm_idx y Lote_numeroLote_trgm_idx existen
  // en la BD como índices parciales (WHERE col IS NOT NULL). Prisma 7 no
  // soporta WHERE en @@index, así que se mantienen vía SQL crudo en la
  // migración `20260512000000_restore_trigram_indexes`. Riesgo conocido:
  // un `prisma migrate dev` puede dropearlos otra vez.
  @@index([codigo(ops: raw("gin_trgm_ops"))], type: Gin, map: "Lote_codigo_trgm_idx")
}

/// De dónde sale el dinero al pagar una compra a proveedor (CxP).
enum FuentePagoCompra {
  TESORERIA // Caja Central de la sede (default para efectivo) → MovimientoCaja EGRESO
  CAJA // Caja operativa abierta del usuario → MovimientoCaja EGRESO
  BANCO // Cuenta bancaria de la empresa → decrementa EmpresaBanco.saldoActual
}

/// Pagos realizados a proveedores por compras
model PagoCompra {
  id            String          @id @default(cuid())
  compraId      String
  metodoPago    MetodoPagoVenta
  monto         Decimal         @db.Decimal(10, 2)
  referencia    String? // Número de operación, voucher
  bancoDestino  String? // Nombre del banco del proveedor
  cuentaDestino String? // Número de cuenta destino
  comprobanteUrl String? // Foto/PDF del voucher (Yape/Plin/transferencia) en S3
  fechaPago     DateTime        @default(now())
  creadoEn      DateTime        @default(now())

  // Origen del dinero (Tesorería/Caja/Banco). Se setea bancoId si BANCO y
  // movimientoCajaId si TESORERIA/CAJA, para poder revertir al anular.
  fuente           FuentePagoCompra?
  bancoId          String? // FK EmpresaBanco (requerido si fuente=BANCO)
  movimientoCajaId String?           @unique // FK MovimientoCaja (set si TESORERIA/CAJA)

  // Anulación (soft-delete): al anular se revierte el egreso (caja: marca el
  // movimiento anulado; banco: devuelve el saldo) y se marca el pago. Los pagos
  // anulados NO cuentan para el saldo de la compra.
  anulado         Boolean   @default(false)
  motivoAnulacion String?
  anuladoPorId    String?
  fechaAnulacion  DateTime?

  compra         Compra          @relation(fields: [compraId], references: [id], onDelete: Cascade)
  banco          EmpresaBanco?   @relation(fields: [bancoId], references: [id])
  movimientoCaja MovimientoCaja? @relation(fields: [movimientoCajaId], references: [id])

  @@index([compraId])
  @@index([fechaPago])
  @@index([bancoId])
}
