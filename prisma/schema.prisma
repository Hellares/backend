  transacciones           TransaccionPago[]

  @@unique([empresaId, tipo])
  @@index([empresaId])
  @@index([tipo])
  @@index([esActivo])
}

model TransaccionPago {
  id               String            @id @default(cuid())
  metodoPagoId     String?
  usuarioId        String?
  empresaId        String?
  monto            Decimal           @db.Decimal(10, 2)
  moneda           String            @default("PEN")
  tipoCambio       Decimal?          @db.Decimal(10, 6)
  montoOriginal    Decimal?          @db.Decimal(10, 2)
  estado           EstadoPago
  idExterno        String?
  descripcion      String?
  datosCliente     Json?
  errorMensaje     String?
  fechaAprobacion  DateTime?
  fechaReembolso   DateTime?
  expiraEn         DateTime?
  metadata         Json?
  origen           String?
  creadoEn         DateTime          @default(now())
  actualizadoEn    DateTime          @updatedAt
  pagosComprobante PagoComprobante[] @relation("PagoComprobanteTransaccion")
  empresa          Empresa?          @relation(fields: [empresaId], references: [id])
  metodoPago       MetodoPago?       @relation(fields: [metodoPagoId], references: [id])
  usuario          Usuario?          @relation(fields: [usuarioId], references: [id])

  @@index([metodoPagoId])
  @@index([usuarioId])
  @@index([empresaId])
  @@index([estado])
  @@index([moneda])
  @@index([idExterno])
  @@index([creadoEn])
  @@index([expiraEn])
  @@index([empresaId, estado, creadoEn])
}

model ConfiguracionFacturacion {
