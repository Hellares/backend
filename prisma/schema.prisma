}

enum EstadoDevolucion {
  PENDIENTE // Creada, esperando aprobación
  APROBADA // Aprobada, lista para procesar
  PROCESADA // Ya se procesó el stock
  RECHAZADA // Rechazada
  CANCELADA // Cancelada
}

enum MotivoDevolucion {
  DEFECTUOSO // Producto defectuoso/dañado
  DANADO_TRANSPORTE // Dañado durante el envío
  ERROR_ENVIO // Error en el pedido (producto incorrecto)
  CAMBIO_OPINION // Cliente cambió de opinión
  GARANTIA // Reclamo de garantía
  PRODUCTO_VENCIDO // Producto caducado
  NO_CONFORME // No cumple expectativas
  OTRO // Otro motivo
