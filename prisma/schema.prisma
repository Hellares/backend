// =========================================
// 💰 SISTEMA DE PRECIOS POR VOLUMEN
// =========================================

/// Niveles de precios según cantidad (precios por mayor/menor)
/// Permite configurar diferentes precios según la cantidad comprada
/// Ejemplo: 1-5 unidades = precio retail, 6-11 = precio por mayor, 12+ = distribuidor
model PrecioNivel {
  id String @id @default(cuid())

  // Puede aplicar a producto base O a variante específica
  productoId String?
  varianteId String?

  // Definición del nivel
  nombre         String // "Retail", "Por Mayor", "Distribuidor"
  cantidadMinima Int // Cantidad mínima para aplicar este precio
  cantidadMaxima Int? // Cantidad máxima (null = sin límite superior)

  // Precio o descuento
  tipoPrecio     TipoPrecioNivel // PRECIO_FIJO o PORCENTAJE_DESCUENTO
  precio         Decimal?        @db.Decimal(10, 2) // Si es PRECIO_FIJO
  porcentajeDesc Decimal?        @db.Decimal(5, 2) // Si es PORCENTAJE_DESCUENTO (0-100)

  // Metadata
  orden       Int     @default(0) // Orden de visualización
  isActive    Boolean @default(true)
  descripcion String? // Descripción opcional para el usuario

  // Auditoría
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // Relaciones
  producto Producto?         @relation(fields: [productoId], references: [id], onDelete: Cascade)
  variante ProductoVariante? @relation(fields: [varianteId], references: [id], onDelete: Cascade)

  @@unique([productoId, cantidadMinima])
  @@unique([varianteId, cantidadMinima])
  @@index([productoId])
  @@index([varianteId])
  @@index([cantidadMinima])
  @@index([isActive])
}

/// Tipo de precio para niveles de volumen
enum TipoPrecioNivel {
  PRECIO_FIJO // Precio específico para este nivel
  PORCENTAJE_DESCUENTO // Descuento porcentual sobre precio base
}

// =========================================
// 🎁 SISTEMA DE DESCUENTOS POR USUARIO
// =========================================

/// Tipo de descuento aplicable
enum TipoDescuento {
  TRABAJADOR // Descuento para trabajadores de la empresa
  FAMILIAR_TRABAJADOR // Descuento para familiares de trabajadores
  VIP // Clientes VIP
  PROMOCIONAL // Promociones temporales
  LEALTAD // Programa de lealtad
  CUMPLEANIOS // Descuento de cumpleaños
}

/// Tipo de cálculo del descuento
enum TipoCalculoDescuento {
  PORCENTAJE // Descuento en porcentaje (15%)
  MONTO_FIJO // Descuento de monto fijo (S/50)
}

/// Parentesco familiar para descuentos
enum Parentesco {
  CONYUGE
  HIJO
  HIJA
  PADRE
  MADRE
  HERMANO
  HERMANA
  ABUELO
  ABUELA
  NIETO
  NIETA
  TIO
  TIA
  SOBRINO
  SOBRINA
  PRIMO
  PRIMA
}

/// Configuración/Plantilla de precios reutilizable
model ConfiguracionPrecio {
  id          String  @id @default(cuid())
  empresaId   String
  nombre      String // "Estándar 3 Niveles", "Solo Mayoreo", etc.
  descripcion String? // Descripción de cuándo usar esta configuración
  isActive    Boolean @default(true)

  // Auditoría
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // Relaciones
  empresa   Empresa                    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  niveles   ConfiguracionPrecioNivel[] // Los niveles de esta configuración
  productos Producto[] // Productos que usan esta configuración

  @@unique([empresaId, nombre])
  @@index([empresaId])
  @@index([isActive])
}

/// Nivel de precio dentro de una configuración
model ConfiguracionPrecioNivel {
  id              String @id @default(cuid())
  configuracionId String

  // Definición del nivel (similar a PrecioNivel pero sin precio fijo)
  nombre         String // "Retail", "Por Mayor", "Distribuidor"
  cantidadMinima Int // Cantidad mínima para aplicar
  cantidadMaxima Int? // Cantidad máxima (null = sin límite)

  // Solo guardamos porcentaje de descuento (el precio se calcula en tiempo real)
  tipoPrecio     TipoPrecioNivel // PRECIO_FIJO o PORCENTAJE_DESCUENTO
  porcentajeDesc Decimal?        @db.Decimal(5, 2) // Porcentaje de descuento (0-100)

  // Metadata
  orden       Int     @default(0)
  descripcion String? // Descripción del nivel

  // Relaciones
  configuracion ConfiguracionPrecio @relation(fields: [configuracionId], references: [id], onDelete: Cascade)

  @@unique([configuracionId, cantidadMinima])
  @@index([configuracionId])
  @@index([cantidadMinima])
}

/// Política de descuento configurable
/// Permite crear descuentos especiales para trabajadores, familiares, VIP, etc.
model PoliticaDescuento {
  id          String  @id @default(cuid())
  empresaId   String
  nombre      String // "Descuento Trabajadores", "Descuento Familiares"
  descripcion String?

  // Tipo de descuento
  tipoDescuento TipoDescuento // TRABAJADOR, FAMILIAR, VIP, etc.

  // Configuración del descuento
  tipoCalculo    TipoCalculoDescuento // PORCENTAJE, MONTO_FIJO
  valorDescuento Decimal              @db.Decimal(10, 2) // 15.00 = 15% o S/15.00

  // Límites y restricciones
  descuentoMaximo Decimal? @db.Decimal(10, 2) // Descuento máximo permitido en monto
  montoMinCompra  Decimal? @db.Decimal(10, 2) // Monto mínimo de compra requerido
  cantidadMaxUsos Int? // Límite de usos por usuario (opcional)

  // Vigencia temporal
  fechaInicio DateTime?
  fechaFin    DateTime?

  // Aplicabilidad
  aplicarATodos Boolean @default(false) // Si true, aplica a todos los productos

  // Prioridad cuando hay múltiples descuentos aplicables
  prioridad Int @default(0) // Mayor número = mayor prioridad

  // Control de familiares (solo para FAMILIAR_TRABAJADOR)
  maxFamiliaresPorTrabajador Int? // Límite de familiares por trabajador

  // Control
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt

  // Relaciones
  empresa              Empresa                      @relation(fields: [empresaId], references: [id])
  usuariosConDescuento UsuarioDescuento[] // Usuarios que tienen este descuento
  productosAplicables  PoliticaDescuentoProducto[] // Productos donde aplica
  categoriasAplicables PoliticaDescuentoCategoria[] // Categorías donde aplica
  usosHistorial        DescuentoUsoHistorial[] // Historial de usos

  @@index([empresaId])
  @@index([tipoDescuento])
  @@index([isActive])
  @@index([fechaInicio, fechaFin])
  @@index([empresaId, tipoDescuento])
  @@index([empresaId, isActive])
}

/// Asignación de políticas de descuento a usuarios
/// Controla qué usuarios tienen acceso a qué descuentos
model UsuarioDescuento {
  id         String @id @default(cuid())
  usuarioId  String
  politicaId String
  empresaId  String

  // Relación con trabajador (si es familiar)
  esFamiliar   Boolean     @default(false)
  trabajadorId String? // ID del trabajador principal (si es familiar)
  parentesco   Parentesco? // CONYUGE, HIJO, PADRE, etc.

  // Límites personalizados (override de la política)
  limiteMensualUsos Int? // Límite de usos por mes para este usuario
  usosDisponibles   Int? // Usos restantes en el período actual

  // Documentación de verificación
  documentoVerificacion String? // Path al documento que verifica el parentesco
  aprobadoPor           String? // ID del usuario que aprobó este descuento
  fechaAprobacion       DateTime?

  // Control
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt

  // Relaciones
  usuario    Usuario           @relation("UsuarioConDescuento", fields: [usuarioId], references: [id])
  politica   PoliticaDescuento @relation(fields: [politicaId], references: [id])
  empresa    Empresa           @relation(fields: [empresaId], references: [id])
  trabajador Usuario?          @relation("FamiliarDe", fields: [trabajadorId], references: [id])

  @@unique([usuarioId, politicaId])
  @@index([usuarioId])
  @@index([empresaId])
  @@index([politicaId])
  @@index([trabajadorId])
  @@index([isActive])
  @@index([esFamiliar])
}

/// Relación M2M entre políticas de descuento y productos
/// Define en qué productos específicos aplica cada política
model PoliticaDescuentoProducto {
  id         String @id @default(cuid())
  politicaId String
  productoId String

  // Override de descuento para este producto específico
  descuentoOverride Decimal? @db.Decimal(10, 2)

  creadoEn DateTime @default(now())

  // Relaciones
  politica PoliticaDescuento @relation(fields: [politicaId], references: [id], onDelete: Cascade)
  producto Producto          @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@unique([politicaId, productoId])
  @@index([politicaId])
  @@index([productoId])
}

/// Relación M2M entre políticas de descuento y categorías
/// Permite aplicar descuentos a toda una categoría de productos
model PoliticaDescuentoCategoria {
  id          String @id @default(cuid())
  politicaId  String
  categoriaId String

  // Override de descuento para esta categoría
  descuentoOverride Decimal? @db.Decimal(10, 2)

  creadoEn DateTime @default(now())

  // Relaciones
  politica  PoliticaDescuento @relation(fields: [politicaId], references: [id], onDelete: Cascade)
  categoria EmpresaCategoria  @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@unique([politicaId, categoriaId])
  @@index([politicaId])
  @@index([categoriaId])
}

/// Historial de uso de descuentos
/// Auditoría completa de cuándo y cómo se aplicaron los descuentos
model DescuentoUsoHistorial {
  id         String @id @default(cuid())
  politicaId String
  usuarioId  String
  empresaId  String

  // Información de la venta/cotización (futuro)
  ventaId      String? // ID de la venta (cuando se implemente)
  cotizacionId String? // ID de la cotización (cuando se implemente)

  // Productos con descuento aplicado
  productoId String?
  varianteId String?
  cantidad   Int

  // Precios
  precioOriginal    Decimal @db.Decimal(10, 2) // Precio antes del descuento
  descuentoAplicado Decimal @db.Decimal(10, 2) // Monto del descuento
  precioFinal       Decimal @db.Decimal(10, 2) // Precio después del descuento

  // Detalles del descuento aplicado
  tipoCalculo    TipoCalculoDescuento
  valorDescuento Decimal              @db.Decimal(10, 2)

  // Contexto de la operación
  sedeId   String? // Sede donde se realizó la operación
  cajeroId String? // Usuario que procesó la venta

  creadoEn DateTime @default(now())

  // Relaciones
  politica PoliticaDescuento @relation(fields: [politicaId], references: [id])
  usuario  Usuario           @relation("UsuarioUsaDescuento", fields: [usuarioId], references: [id])
  empresa  Empresa           @relation(fields: [empresaId], references: [id])
  producto Producto?         @relation(fields: [productoId], references: [id])
  variante ProductoVariante? @relation(fields: [varianteId], references: [id])
  sede     Sede?             @relation(fields: [sedeId], references: [id])
  cajero   Usuario?          @relation("CajeroDescuentos", fields: [cajeroId], references: [id])

  @@index([politicaId])
  @@index([usuarioId])
  @@index([empresaId])
  @@index([ventaId])
  @@index([cotizacionId])
  @@index([productoId])
  @@index([varianteId])
  @@index([creadoEn])
  @@index([sedeId])
}

// =========================================
// 🏢 MODELOS FUTUROS - SISTEMA MULTI-SEDE
// =========================================
//
// Los siguientes modelos serán implementados en las próximas fases
// del sistema multi-sede. Se documentan aquí como referencia y roadmap.
//
// IMPORTANTE: Descomentar y adaptar cuando se implementen los módulos
// correspondientes (Ventas, Cotizaciones, Inventario por Sede)
//
// =========================================

/**
 * // =========================================
 * // 💰 MÓDULO DE VENTAS POR SEDE (Notas de Venta)
 * // =========================================
 * ///
 * /// IMPORTANTE - FLUJO DE NEGOCIO:
 * /// ==============================
 * ///
 * /// La Venta (Nota de Venta) es el REGISTRO COMERCIAL de la operación de venta.
 * /// El ComprobanteElectronico (Factura/Boleta) es solo DOCUMENTACIÓN FISCAL.
 * ///
 * /// FLUJO:
 * /// 1. Día 1: Cliente compra → Se crea VENTA (VTA-00001)
 * ///           - Se descuenta stock
 * ///           - Se registra pago
 * ///           - Se genera nota de venta interna
 * ///
 * /// 2. Día 2: Cliente pide factura → Se crea COMPROBANTE ELECTRONICO (FAC-00001)
 * ///           - NO se descuenta stock (ya descontado en venta)
 * ///           - NO se registra pago (ya registrado en venta)
 * ///           - Solo se emite documentación fiscal
 * ///           - Se linkea: venta.comprobanteId = comprobante.id
 * ///
 * /// REGLAS CRÍTICAS:
 * /// ================
 * /// - El STOCK solo se descuenta en Venta, NUNCA en Comprobante
 * /// - El PAGO solo se registra en Venta, NUNCA en Comprobante
 * /// - Una Venta puede existir sin Comprobante (cliente no lo solicita)
 * /// - Un Comprobante SIEMPRE está vinculado a una Venta previa
 * /// - EVITAR DOBLE DESCUENTO: usar campo stockDescontado = true
 * /// - EVITAR DOBLE PAGO: validar tieneComprobante antes de crear comprobante
 * ///
 * /// Ventas realizadas en una sede específica (Notas de Venta internas)
 * model Venta {
 * id        String   @id @default(cuid())
 * sedeId    String   // REQUERIDO: Toda venta pertenece a una sede
 * empresaId String
 * // Identificación de la venta
 * codigo           String   // VTA-SEDE001-00001 (generado por ConfiguracionCodigos)
 * numeroComprobante String? // Número de comprobante interno adicional (opcional)
 * // Cliente
 * clienteId String?
 * nombreCliente String
 * documentoCliente String?
 * // Vendedor y caja
 * vendedorId String // Usuario que realizó la venta
 * cajaId     String? // Caja donde se registró (si aplica)
 * // Montos (registrados UNA SOLA VEZ aquí)
 * subtotal  Decimal @db.Decimal(10, 2)
 * descuento Decimal @db.Decimal(10, 2) @default(0)
 * impuestos Decimal @db.Decimal(10, 2) @default(0)
 * total     Decimal @db.Decimal(10, 2)
 * // Estado
 * estado EstadoVenta @default(COMPLETADA)
 * // ⚠️ CAMPOS CRÍTICOS PARA EVITAR DUPLICACIÓN ⚠️
 * comprobanteId    String?  // ID del comprobante electrónico si fue emitido
 * tieneComprobante Boolean  @default(false) // true si ya se emitió factura/boleta
 * stockDescontado  Boolean  @default(false) // true cuando se descuenta stock (en creación de venta)
 * // Auditoría
 * creadoEn      DateTime @default(now())
 * actualizadoEn DateTime @updatedAt
 * // Relaciones
 * sede        Sede                    @relation(fields: [sedeId], references: [id])
 * empresa     Empresa                 @relation(fields: [empresaId], references: [id])
 * comprobante ComprobanteElectronico? @relation(fields: [comprobanteId], references: [id])
 * // cliente   Cliente?         @relation(fields: [clienteId], references: [id])
 * // vendedor  Usuario          @relation("VentasRealizadas", fields: [vendedorId], references: [id])
 * // caja      Caja?            @relation(fields: [cajaId], references: [id])
 * detalles  VentaDetalle[]
 * pagos     VentaPago[]
 * @@unique([sedeId, codigo])
 * @@index([sedeId])
 * @@index([empresaId])
 * @@index([vendedorId])
 * @@index([cajaId])
 * @@index([estado])
 * @@index([comprobanteId])
 * @@index([tieneComprobante])
 * @@index([creadoEn])
 * }
 * /// Detalle de items vendidos
 * /// IMPORTANTE: Stock se descuenta cuando se crea la venta, NO cuando se crea comprobante
 * model VentaDetalle {
 * id       String @id @default(cuid())
 * ventaId  String
 * // Puede ser producto o variante
 * productoId String?
 * varianteId String?
 * descripcion    String
 * cantidad       Decimal @db.Decimal(10, 2)
 * precioUnitario Decimal @db.Decimal(10, 2)
 * descuento      Decimal @db.Decimal(10, 2) @default(0)
 * subtotal       Decimal @db.Decimal(10, 2)
 * venta Venta @relation(fields: [ventaId], references: [id], onDelete: Cascade)
 * @@index([ventaId])
 * @@index([productoId])
 * @@index([varianteId])
 * }
 * /// Pagos asociados a una venta
 * /// IMPORTANTE: Pagos se registran UNA SOLA VEZ en la venta, NO en comprobante
 * model VentaPago {
 * id        String @id @default(cuid())
 * ventaId   String
 * metodoPago     String  // EFECTIVO, TARJETA, YAPE, PLIN, TRANSFERENCIA, etc.
 * monto          Decimal @db.Decimal(10, 2)
 * referencia     String? // Número de operación/voucher
 * creadoEn DateTime @default(now())
 * venta Venta @relation(fields: [ventaId], references: [id], onDelete: Cascade)
 * @@index([ventaId])
 * }
 * enum EstadoVenta {
 * BORRADOR       // Venta en proceso de creación
 * COMPLETADA     // Venta finalizada (con o sin comprobante)
 * ANULADA        // Venta cancelada
 * PENDIENTE_PAGO // Venta pendiente de completar pago
 * }
 * // =========================================
 * // 📋 MÓDULO DE COTIZACIONES POR SEDE
 * // =========================================
 * /// Cotizaciones generadas en una sede
 * model Cotizacion {
 * id        String @id @default(cuid())
 * sedeId    String // REQUERIDO: Toda cotización pertenece a una sede
 * empresaId String
 * codigo        String
 * clienteId     String?
 * nombreCliente String
 * // Vendedor
 * vendedorId String
 * // Montos
 * subtotal  Decimal @db.Decimal(10, 2)
 * descuento Decimal @db.Decimal(10, 2) @default(0)
 * impuestos Decimal @db.Decimal(10, 2) @default(0)
 * total     Decimal @db.Decimal(10, 2)
 * // Vigencia
 * fechaEmision    DateTime @default(now())
 * fechaVencimiento DateTime?
 * // Estado
 * estado EstadoCotizacion @default(PENDIENTE)
 * // Observaciones
 * observaciones String?
 * condiciones   String?
 * // Auditoría
 * creadoEn      DateTime @default(now())
 * actualizadoEn DateTime @updatedAt
 * // Relaciones
 * sede     Sede               @relation(fields: [sedeId], references: [id])
 * empresa  Empresa            @relation(fields: [empresaId], references: [id])
 * detalles CotizacionDetalle[]
 * @@unique([sedeId, codigo])
 * @@index([sedeId])
 * @@index([empresaId])
 * @@index([vendedorId])
 * @@index([estado])
 * @@index([creadoEn])
 * }
 * model CotizacionDetalle {
 * id           String @id @default(cuid())
 * cotizacionId String
 * productoId String?
 * varianteId String?
 * descripcion    String
 * cantidad       Decimal @db.Decimal(10, 2)
 * precioUnitario Decimal @db.Decimal(10, 2)
 * descuento      Decimal @db.Decimal(10, 2) @default(0)
 * subtotal       Decimal @db.Decimal(10, 2)
 * cotizacion Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
 * @@index([cotizacionId])
 * }
 * enum EstadoCotizacion {
 * BORRADOR
 * PENDIENTE
 * APROBADA
 * RECHAZADA
 * VENCIDA
 * CONVERTIDA_A_VENTA
 * }
 * // =========================================
 * // 💵 MÓDULO DE CAJA POR SEDE
 * // =========================================
 * /// Cajas registradoras en cada sede
 * model Caja {
 * id     String @id @default(cuid())
 * sedeId String
 * nombre       String // "Caja 1", "Caja Principal"
 * codigo       String
 * descripcion  String?
 * // Estado
 * isActive Boolean @default(true)
 * // Auditoría
 * creadoEn      DateTime @default(now())
 * actualizadoEn DateTime @updatedAt
 * // Relaciones
 * sede      Sede           @relation(fields: [sedeId], references: [id])
 * aperturas AperturaCaja[]
 * @@unique([sedeId, codigo])
 * @@index([sedeId])
 * @@index([isActive])
 * }
 * /// Aperturas y cierres de caja
 * model AperturaCaja {
 * id     String @id @default(cuid())
 * cajaId String
 * sedeId String
 * // Usuario responsable
 * usuarioId String
 * // Montos
 * montoInicial Decimal  @db.Decimal(10, 2)
 * montoFinal   Decimal? @db.Decimal(10, 2)
 * // Fechas
 * fechaApertura DateTime @default(now())
 * fechaCierre   DateTime?
 * // Estado
 * estado EstadoCaja @default(ABIERTA)
 * // Observaciones
 * observacionesApertura String?
 * observacionesCierre   String?
 * caja Caja @relation(fields: [cajaId], references: [id])
 * @@index([cajaId])
 * @@index([sedeId])
 * @@index([usuarioId])
 * @@index([estado])
 * @@index([fechaApertura])
 * }
 * enum EstadoCaja {
 * ABIERTA
 * CERRADA
 * CUADRADA    // Cerrada con cuadre correcto
 * DESCUADRADA // Cerrada con diferencia
 * }
 */
