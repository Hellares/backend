model PagoComprobante {
  id            String                 @id @default(cuid())
  comprobanteId String
  transaccionId String?
  metodoPago    String
  monto         Decimal                @db.Decimal(10, 2)
  moneda        String                 @default("PEN")
  fechaPago     DateTime               @default(now())
  referencia    String?
  estado        String                 @default("COMPLETADO")
  creadoEn      DateTime               @default(now())
  actualizadoEn DateTime               @updatedAt
  comprobante   ComprobanteElectronico @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)
  transaccion   TransaccionPago?       @relation("PagoComprobanteTransaccion", fields: [transaccionId], references: [id])

  @@index([comprobanteId])
  @@index([transaccionId])
  @@index([fechaPago])
