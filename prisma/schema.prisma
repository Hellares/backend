/**
 * // =========================================
 * // 💰 MÓDULO DE VENTAS POR SEDE
 * // =========================================
 * /// Ventas realizadas en una sede específica
 * /// Reemplaza o complementa el módulo de ComprobantesElectronicos
 * /// con contexto de sede para operaciones de caja y punto de venta
 * model Venta {
 * id        String   @id @default(cuid())
 * sedeId    String   // REQUERIDO: Toda venta pertenece a una sede
 * empresaId String
 * // Identificación de la venta
 * codigo           String   // VTA-SEDE001-00001
 * numeroComprobante String?
 * // Cliente
 * clienteId String?
 * nombreCliente String
 * documentoCliente String?
 * // Vendedor y caja
 * vendedorId String // Usuario que realizó la venta
 * cajaId     String? // Caja donde se registró (si aplica)
 * // Montos
 * subtotal  Decimal @db.Decimal(10, 2)
 * descuento Decimal @db.Decimal(10, 2) @default(0)
 * impuestos Decimal @db.Decimal(10, 2) @default(0)
 * total     Decimal @db.Decimal(10, 2)
 * // Estado
 * estado EstadoVenta @default(COMPLETADA)
 * // Auditoría
 * creadoEn      DateTime @default(now())
 * actualizadoEn DateTime @updatedAt
 * // Relaciones
 * sede      Sede             @relation(fields: [sedeId], references: [id])
 * empresa   Empresa          @relation(fields: [empresaId], references: [id])
 * // cliente   Cliente?         @relation(fields: [clienteId], references: [id])
 * // vendedor  Usuario          @relation("VentasRealizadas", fields: [vendedorId], references: [id])
 * // caja      Caja?            @relation(fields: [cajaId], references: [id])
 * detalles  VentaDetalle[]
 * pagos     VentaPago[]
 * @@unique([sedeId, codigo])
 * @@index([sedeId])
 * @@index([empresaId])
 * @@index([vendedorId])
 * @@index([cajaId])
 * @@index([estado])
 * @@index([creadoEn])
 * }
 * /// Detalle de items vendidos
 * model VentaDetalle {
 * id       String @id @default(cuid())
 * ventaId  String
 * // Puede ser producto o variante
 * productoId String?
 * varianteId String?
 * descripcion    String
 * cantidad       Decimal @db.Decimal(10, 2)
 * precioUnitario Decimal @db.Decimal(10, 2)
 * descuento      Decimal @db.Decimal(10, 2) @default(0)
 * subtotal       Decimal @db.Decimal(10, 2)
 * venta Venta @relation(fields: [ventaId], references: [id], onDelete: Cascade)
 * @@index([ventaId])
 * @@index([productoId])
 * @@index([varianteId])
 * }
 * /// Pagos asociados a una venta
 * model VentaPago {
 * id        String @id @default(cuid())
 * ventaId   String
 * metodoPago     String  // EFECTIVO, TARJETA, YAPE, etc.
 * monto          Decimal @db.Decimal(10, 2)
 * referencia     String?
 * creadoEn DateTime @default(now())
 * venta Venta @relation(fields: [ventaId], references: [id], onDelete: Cascade)
 * @@index([ventaId])
 * }
 * enum EstadoVenta {
 * BORRADOR
 * COMPLETADA
 * ANULADA
 * PENDIENTE_PAGO
 * }
 * // =========================================
 * // 📋 MÓDULO DE COTIZACIONES POR SEDE
 * // =========================================
 * /// Cotizaciones generadas en una sede
 * model Cotizacion {
 * id        String @id @default(cuid())
 * sedeId    String // REQUERIDO: Toda cotización pertenece a una sede
 * empresaId String
 * codigo        String
 * clienteId     String?
 * nombreCliente String
 * // Vendedor
 * vendedorId String
 * // Montos
 * subtotal  Decimal @db.Decimal(10, 2)
 * descuento Decimal @db.Decimal(10, 2) @default(0)
 * impuestos Decimal @db.Decimal(10, 2) @default(0)
 * total     Decimal @db.Decimal(10, 2)
 * // Vigencia
 * fechaEmision    DateTime @default(now())
 * fechaVencimiento DateTime?
 * // Estado
 * estado EstadoCotizacion @default(PENDIENTE)
 * // Observaciones
 * observaciones String?
 * condiciones   String?
 * // Auditoría
 * creadoEn      DateTime @default(now())
 * actualizadoEn DateTime @updatedAt
 * // Relaciones
 * sede     Sede               @relation(fields: [sedeId], references: [id])
 * empresa  Empresa            @relation(fields: [empresaId], references: [id])
 * detalles CotizacionDetalle[]
 * @@unique([sedeId, codigo])
 * @@index([sedeId])
 * @@index([empresaId])
 * @@index([vendedorId])
 * @@index([estado])
 * @@index([creadoEn])
 * }
 * model CotizacionDetalle {
 * id           String @id @default(cuid())
 * cotizacionId String
 * productoId String?
 * varianteId String?
 * descripcion    String
 * cantidad       Decimal @db.Decimal(10, 2)
 * precioUnitario Decimal @db.Decimal(10, 2)
 * descuento      Decimal @db.Decimal(10, 2) @default(0)
 * subtotal       Decimal @db.Decimal(10, 2)
 * cotizacion Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
 * @@index([cotizacionId])
 * }
 * enum EstadoCotizacion {
 * BORRADOR
 * PENDIENTE
 * APROBADA
 * RECHAZADA
 * VENCIDA
 * CONVERTIDA_A_VENTA
 * }
 * // =========================================
 * // 📦 MÓDULO DE INVENTARIO POR SEDE
 * // =========================================
 * /// Stock de productos por sede
 * /// Permite gestionar inventario independiente en cada sede
 * model ProductoStock {
 * id         String @id @default(cuid())
 * sedeId     String
 * productoId String?
 * varianteId String?
 * empresaId  String
 * // Stock actual
 * stockActual  Int
 * stockMinimo  Int?
 * stockMaximo  Int?
 * // Ubicación dentro de la sede
 * ubicacion    String? // Pasillo, estante, etc.
 * // Auditoría
 * creadoEn      DateTime @default(now())
 * actualizadoEn DateTime @updatedAt
 * // Relaciones
 * sede      Sede             @relation(fields: [sedeId], references: [id])
 * empresa   Empresa          @relation(fields: [empresaId], references: [id])
 * // producto  Producto?        @relation(fields: [productoId], references: [id])
 * // variante  ProductoVariante? @relation(fields: [varianteId], references: [id])
 * movimientos MovimientoStock[]
 * @@unique([sedeId, productoId, varianteId])
 * @@index([sedeId])
 * @@index([productoId])
 * @@index([varianteId])
 * @@index([stockActual])
 * }
 * /// Registro de movimientos de stock (entradas, salidas, ajustes)
 * model MovimientoStock {
 * id             String @id @default(cuid())
 * sedeId         String
 * productoStockId String
 * empresaId      String
 * // Tipo de movimiento
 * tipo           TipoMovimientoStock
 * tipoDocumento  String? // COMPRA, VENTA, AJUSTE, TRANSFERENCIA, etc.
 * numeroDocumento String?
 * // Cantidades
 * cantidadAnterior Int
 * cantidad         Int // Positivo = entrada, Negativo = salida
 * cantidadNueva    Int
 * // Motivo
 * motivo      String?
 * observaciones String?
 * // Relación con transferencias (si aplica)
 * transferenciaId String?
 * // Usuario responsable
 * usuarioId String
 * // Auditoría
 * creadoEn DateTime @default(now())
 * // Relaciones
 * sede          Sede           @relation(fields: [sedeId], references: [id])
 * productoStock ProductoStock  @relation(fields: [productoStockId], references: [id])
 * // transferencia TransferenciaStock? @relation(fields: [transferenciaId], references: [id])
 * @@index([sedeId])
 * @@index([productoStockId])
 * @@index([tipo])
 * @@index([creadoEn])
 * @@index([transferenciaId])
 * }
 * /// Transferencias de stock entre sedes
 * model TransferenciaStock {
 * id              String @id @default(cuid())
 * empresaId       String
 * sedeOrigenId    String
 * sedeDestinoId   String
 * // Identificación
 * codigo          String @unique
 * // Productos transferidos
 * productoId      String?
 * varianteId      String?
 * cantidad        Int
 * // Estado
 * estado          EstadoTransferencia @default(PENDIENTE)
 * // Usuarios responsables
 * solicitadoPor   String
 * aprobadoPor     String?
 * recibidoPor     String?
 * // Fechas
 * fechaSolicitud  DateTime @default(now())
 * fechaAprobacion DateTime?
 * fechaEnvio      DateTime?
 * fechaRecepcion  DateTime?
 * // Observaciones
 * motivo          String?
 * observaciones   String?
 * // Auditoría
 * creadoEn        DateTime @default(now())
 * actualizadoEn   DateTime @updatedAt
 * // Relaciones
 * empresa      Empresa @relation(fields: [empresaId], references: [id])
 * sedeOrigen   Sede    @relation("TransferenciasOrigen", fields: [sedeOrigenId], references: [id])
 * sedeDestino  Sede    @relation("TransferenciasDestino", fields: [sedeDestinoId], references: [id])
 * @@index([empresaId])
 * @@index([sedeOrigenId])
 * @@index([sedeDestinoId])
 * @@index([estado])
 * @@index([creadoEn])
 * }
 * enum TipoMovimientoStock {
 * ENTRADA_COMPRA      // Entrada por compra
 * ENTRADA_TRANSFERENCIA // Entrada por transferencia de otra sede
 * ENTRADA_AJUSTE      // Ajuste de inventario (entrada)
 * ENTRADA_DEVOLUCION  // Devolución de cliente
 * SALIDA_VENTA        // Salida por venta
 * SALIDA_TRANSFERENCIA // Salida por transferencia a otra sede
 * SALIDA_AJUSTE       // Ajuste de inventario (salida)
 * SALIDA_MERMA        // Merma o pérdida
 * SALIDA_ROBO         // Robo
 * SALIDA_DONACION     // Donación
 * }
 * enum EstadoTransferencia {
 * BORRADOR      // En creación
 * PENDIENTE     // Solicitada, esperando aprobación
 * APROBADA      // Aprobada, lista para envío
 * EN_TRANSITO   // Enviada, en camino
 * RECIBIDA      // Recibida en sede destino
 * RECHAZADA     // Rechazada
 * CANCELADA     // Cancelada
 * }
 * // =========================================
 * // 💵 MÓDULO DE CAJA POR SEDE
 * // =========================================
 * /// Cajas registradoras en cada sede
 * model Caja {
 * id     String @id @default(cuid())
 * sedeId String
 * nombre       String // "Caja 1", "Caja Principal"
 * codigo       String
 * descripcion  String?
 * // Estado
 * isActive Boolean @default(true)
 * // Auditoría
 * creadoEn      DateTime @default(now())
 * actualizadoEn DateTime @updatedAt
 * // Relaciones
 * sede      Sede           @relation(fields: [sedeId], references: [id])
 * aperturas AperturaCaja[]
 * @@unique([sedeId, codigo])
 * @@index([sedeId])
 * @@index([isActive])
 * }
 * /// Aperturas y cierres de caja
 * model AperturaCaja {
 * id     String @id @default(cuid())
 * cajaId String
 * sedeId String
 * // Usuario responsable
 * usuarioId String
 * // Montos
 * montoInicial Decimal  @db.Decimal(10, 2)
 * montoFinal   Decimal? @db.Decimal(10, 2)
 * // Fechas
 * fechaApertura DateTime @default(now())
 * fechaCierre   DateTime?
 * // Estado
 * estado EstadoCaja @default(ABIERTA)
 * // Observaciones
 * observacionesApertura String?
 * observacionesCierre   String?
 * caja Caja @relation(fields: [cajaId], references: [id])
 * @@index([cajaId])
 * @@index([sedeId])
 * @@index([usuarioId])
 * @@index([estado])
 * @@index([fechaApertura])
 * }
 * enum EstadoCaja {
 * ABIERTA
 * CERRADA
 * CUADRADA    // Cerrada con cuadre correcto
 * DESCUADRADA // Cerrada con diferencia
 * }
 */
