generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

model Persona {
  id                String             @id @default(cuid())
  nombres           String
  apellidos         String
  dni               String?
  telefono          String?
  email             String?
  fechaNacimiento   DateTime?
  genero            Genero?
  observaciones     String?
  isActive          Boolean            @default(true)
  deletedAt         DateTime?
  esCliente         Boolean            @default(false)
  esProveedor       Boolean            @default(false)
  esUsuario         Boolean            @default(false)
  creadoEn          DateTime           @default(now())
  actualizadoEn     DateTime           @updatedAt
  direcciones       DireccionPersona[]
  empresasAsociadas EmpresaPersona[]
  usuario           Usuario?

  @@index([isActive])
  @@index([dni])
  @@index([esCliente])
  @@index([esProveedor])
  @@index([esUsuario])
  @@index([deletedAt])
}

model Empresa {
  id                     String            @id @default(cuid())
  nombre                 String
  ruc                    String?           @unique
  subdominio             String?           @unique
  logo                   String?
  rubro                  RubroEmpresa      @default(TECNOLOGIA)
  isActive               Boolean           @default(true)
  deletedAt              DateTime?
  descripcion            String?
  web                    String?
  telefono               String?
  email                  String?
  planSuscripcionId      String?
  fechaInicioSuscripcion DateTime?
  fechaVencimiento       DateTime?
  estadoSuscripcion      EstadoSuscripcion @default(ACTIVA)
  usuariosActuales       Int               @default(0)

  // Campos para Marketplace
  visibleEnMarketplace Boolean @default(true)
  destacadoMarketplace Boolean @default(false)
  ordenMarketplace     Int?
  vistasMarketplace    Int     @default(0)

  // SEO y Metadata
  metaTitle       String?
  metaDescription String?
  keywords        String?

  // Redes Sociales
  facebook  String?
  instagram String?
  twitter   String?
  linkedin  String?

  creadoEn                 DateTime                      @default(now())
  actualizadoEn            DateTime                      @updatedAt
  componentes              Componente[]
  comprobantes             ComprobanteElectronico[]
  configuracionCampos      ConfiguracionCamposServicio[]
  configuracionCodigos     ConfiguracionCodigos?
  configuracionFacturacion ConfiguracionFacturacion?
  planSuscripcion          PlanSuscripcion?              @relation(fields: [planSuscripcionId], references: [id])
  personasAsociadas        EmpresaPersona[]
  usuarios                 EmpresaUsuarioRol[]
  metodosPago              MetodoPago[]
  modelosEquipos           ModeloEquipo[]
  ordenesServicio          OrdenServicio[]
  personalizaciones        PersonalizacionEmpresa[]
  plantillasComprobantes   PlantillaComprobante[]
  productos                Producto[]
  sedes                    Sede[]
  servicios                Servicio[]
  tiposComponentes         TipoComponente[]
  transaccionesRecibidas   TransaccionPago[]
  archivos                 Archivo[]
  empresaCategorias        EmpresaCategoria[]
  empresaMarcas            EmpresaMarca[]
  productoVariantes        ProductoVariante[]
  productoAtributos        ProductoAtributo[]

  @@index([subdominio])
  @@index([isActive])
  @@index([ruc])
  @@index([planSuscripcionId])
  @@index([fechaVencimiento])
  @@index([estadoSuscripcion])
  @@index([deletedAt])
  @@index([visibleEnMarketplace])
  @@index([destacadoMarketplace])
  @@index([ordenMarketplace])
}

model Usuario {
  id                          String              @id @default(cuid())
  personaId                   String              @unique
  email                       String              @unique
  telefono                    String?             @unique
  passwordHash                String?
  isActive                    Boolean             @default(true)
  deletedAt                   DateTime?
  lastLoginAt                 DateTime?
  resetToken                  String?             @unique
  resetTokenExpiracion        DateTime?
  emailVerificationToken      String?             @unique
  emailVerificationExpiracion DateTime?
  emailVerificado             Boolean             @default(false)
  telefonoVerificado          Boolean             @default(false)
  rolGlobal                   Rol?
  creadoEn                    DateTime            @default(now())
  actualizadoEn               DateTime            @updatedAt
  authProviders               AuthProvider[]
  empresas                    EmpresaUsuarioRol[]
  metodosPagoConfigurados     MetodoPago[]        @relation("MetodoPagoUsuario")
  ordenesServicio             OrdenServicio[]
  registrosComoCliente        RegistroCliente[]
  transacciones               TransaccionPago[]
  persona                     Persona             @relation(fields: [personaId], references: [id], onDelete: Restrict)
  sedes                       UsuarioSedeRol[]

  @@index([email])
  @@index([telefono])
  @@index([personaId])
  @@index([isActive])
  @@index([rolGlobal])
  @@index([emailVerificado])
  @@index([telefonoVerificado])
  @@index([resetToken])
  @@index([emailVerificationToken])
  @@index([deletedAt])
}

model AuthProvider {
  id         String           @id @default(cuid())
  userId     String
  provider   AuthProviderType
  providerId String
  email      String
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  usuario    Usuario          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@index([email])
  @@index([provider])
}

model ConfiguracionCodigos {
  id                  String   @id @default(cuid())
  empresaId           String   @unique
  productoCodigo      String   @default("PROD")
  productoSeparador   String   @default("-")
  productoLongitud    Int      @default(6)
  productoIncluirSede Boolean  @default(false)
  servicioCodigo      String   @default("SERV")
  servicioSeparador   String   @default("-")
  servicioLongitud    Int      @default(6)
  servicioIncluirSede Boolean  @default(false)
  facturaCodigo       String   @default("FAC")
  boletaCodigo        String   @default("BOL")
  notaCreditoCodigo   String   @default("NCR")
  notaDebitoCodigo    String   @default("NDB")
  documentoSeparador  String   @default("-")
  documentoLongitud   Int      @default(8)
  ultimoProducto      Int      @default(0)
  ultimoServicio      Int      @default(0)
  ultimoFactura       Int      @default(0)
  ultimaBoleta        Int      @default(0)
  ultimaNotaCredito   Int      @default(0)
  ultimaNotaDebito    Int      @default(0)
  creadoEn            DateTime @default(now())
  actualizadoEn       DateTime @updatedAt
  empresa             Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
}

model EmpresaPersona {
  id              String                   @id @default(cuid())
  personaId       String
  empresaId       String
  rol             RolPersona               @default(CLIENTE)
  isActive        Boolean                  @default(true)
  deletedAt       DateTime?
  creadoEn        DateTime                 @default(now())
  actualizadoEn   DateTime                 @updatedAt
  comprobantes    ComprobanteElectronico[] @relation("ComoCliente")
  empresa         Empresa                  @relation(fields: [empresaId], references: [id])
  persona         Persona                  @relation(fields: [personaId], references: [id])
  ordenesServicio OrdenServicio[]          @relation("OrdenServicioCliente")

  @@unique([personaId, empresaId])
  @@index([empresaId])
  @@index([rol])
  @@index([empresaId, rol])
  @@index([deletedAt])
}

model EmpresaUsuarioRol {
  id                 String                   @id @default(cuid())
  usuarioId          String
  empresaId          String
  rol                Rol
  isActive           Boolean                  @default(true)
  deletedAt          DateTime?
  estado             EstadoCliente            @default(ACTIVO)
  motivoInactivacion MotivoInactivacion?
  notasMotivo        String?
  registradoPor      String?
  fechaAprobacion    DateTime?
  aprobadoPor        String?
  creadoPor          String?
  modificadoPor      String?
  creadoEn           DateTime                 @default(now())
  actualizadoEn      DateTime                 @updatedAt
  empresa            Empresa                  @relation(fields: [empresaId], references: [id])
  usuario            Usuario                  @relation(fields: [usuarioId], references: [id])
  historialEstados   HistorialEstadoCliente[]

  @@unique([usuarioId, empresaId, rol])
  @@index([usuarioId, empresaId])
  @@index([empresaId])
  @@index([rol])
  @@index([estado])
  @@index([empresaId, rol])
  @@index([empresaId, estado])
  @@index([deletedAt])
}

model UsuarioSedeRol {
  id            String    @id @default(cuid())
  usuarioId     String
  sedeId        String
  rol           Rol
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  creadoPor     String?
  modificadoPor String?
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt
  sede          Sede      @relation(fields: [sedeId], references: [id])
  usuario       Usuario   @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, sedeId])
  @@index([sedeId])
  @@index([rol])
  @@index([deletedAt])
}

// ============================================
// CATÁLOGOS MAESTROS (Sistema Global)
// ============================================

model CategoriaMaestra {
  id          String   @id @default(cuid())
  nombre      String   @unique
  slug        String   @unique
  descripcion String?
  icono       String?  // Emoji o URL de icono
  imagen      String?  // Banner/imagen de categoría

  // Jerarquía
  padreId     String?
  nivel       Int      @default(0)

  // Metadata
  orden       Int?
  esPopular   Boolean  @default(false)

  // Auditoría
  isActive    Boolean  @default(true)
  creadoEn    DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // Relaciones jerárquicas
  padre       CategoriaMaestra?  @relation("SubcategoriasMaestras", fields: [padreId], references: [id], onDelete: Restrict)
  hijos       CategoriaMaestra[] @relation("SubcategoriasMaestras")

  // Relación con empresas
  empresaCategorias EmpresaCategoria[]

  @@index([padreId])
  @@index([isActive])
  @@index([esPopular])
  @@index([slug])
}

model MarcaMaestra {
  id          String   @id @default(cuid())
  nombre      String   @unique
  slug        String   @unique
  descripcion String?
  logo        String?
  sitioWeb    String?
  paisOrigen  String?

  // Metadata
  esPopular   Boolean  @default(false)

  // Auditoría
  isActive    Boolean  @default(true)
  creadoEn    DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // Relación con empresas
  empresaMarcas EmpresaMarca[]

  @@index([isActive])
  @@index([esPopular])
  @@index([slug])
}

// ============================================
// RELACIÓN EMPRESA-CATÁLOGO (Activación)
// ============================================

model EmpresaCategoria {
  id                 String   @id @default(cuid())
  empresaId          String
  categoriaMaestraId String?  // NULL = categoría personalizada

  // Campos para categorías PERSONALIZADAS (cuando categoriaMaestraId es NULL)
  nombrePersonalizado       String?
  descripcionPersonalizada  String?
  padreId                   String?

  // Personalización/Override del nombre maestro
  nombreLocal         String?  // Ejemplo: "Electrónica" → "Tech"

  // Configuración por empresa
  orden       Int?
  isVisible   Boolean  @default(true)
  isActive    Boolean  @default(true)
  deletedAt   DateTime?

  // Auditoría
  creadoEn    DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // Relaciones
  empresa            Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  categoriaMaestra   CategoriaMaestra? @relation(fields: [categoriaMaestraId], references: [id], onDelete: Restrict)
  productos          Producto[]
  servicios          Servicio[]

  @@unique([empresaId, categoriaMaestraId])
  @@index([empresaId])
  @@index([categoriaMaestraId])
  @@index([isActive])
  @@index([isVisible])
}

model EmpresaMarca {
  id               String   @id @default(cuid())
  empresaId        String
  marcaMaestraId   String?  // NULL = marca personalizada

  // Campos para marcas PERSONALIZADAS
  nombrePersonalizado       String?
  descripcionPersonalizada  String?
  logoPersonalizado         String?
  sitioWebPersonalizado     String?

  // Personalización
  nombreLocal      String?

  // Configuración
  orden            Int?
  isVisible        Boolean  @default(true)
  isActive         Boolean  @default(true)
  deletedAt        DateTime?

  // Auditoría
  creadoEn         DateTime @default(now())
  actualizadoEn    DateTime @updatedAt

  // Relaciones
  empresa          Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  marcaMaestra     MarcaMaestra? @relation(fields: [marcaMaestraId], references: [id], onDelete: Restrict)
  productos        Producto[]

  @@unique([empresaId, marcaMaestraId])
  @@index([empresaId])
  @@index([marcaMaestraId])
  @@index([isActive])
  @@index([isVisible])
}

model Producto {
  id                 String   @id @default(cuid())
  empresaId          String
  sedeId             String?
  empresaCategoriaId String?
  empresaMarcaId     String?
  codigoEmpresa      String
  codigoSistema      String
  sku                String?
  codigoBarras       String?
  nombre             String
  descripcion        String?
  detalles           Json?
  precio             Decimal  @db.Decimal(10, 2)
  precioCosto        Decimal? @db.Decimal(10, 2)
  stock              Int      @default(0)
  stockMinimo        Int?
  peso               Decimal? @db.Decimal(10, 3)
  dimensiones        Json?
  videoUrl           String?
  impuestoPorcentaje Decimal? @db.Decimal(5, 2)
  descuentoMaximo    Decimal? @db.Decimal(5, 2)

  // Campos para Marketplace
  visibleMarketplace Boolean @default(true)
  destacado          Boolean @default(false)
  ordenMarketplace   Int?

  // Sistema de Ofertas
  enOferta          Boolean   @default(false)
  precioOferta      Decimal?  @db.Decimal(10, 2)
  fechaInicioOferta DateTime?
  fechaFinOferta    DateTime?

  // Sistema de Variantes
  tieneVariantes Boolean @default(false)

  isActive            Boolean                  @default(true)
  deletedAt           DateTime?
  creadoEn            DateTime                 @default(now())
  actualizadoEn       DateTime                 @updatedAt
  detallesComprobante DetalleComprobante[]     @relation("DetalleProducto")
  empresaCategoria    EmpresaCategoria?        @relation(fields: [empresaCategoriaId], references: [id])
  empresaMarca        EmpresaMarca?            @relation(fields: [empresaMarcaId], references: [id])
  empresa             Empresa                  @relation(fields: [empresaId], references: [id])
  sede                Sede?                    @relation(fields: [sedeId], references: [id])
  comprobantes        ComprobanteElectronico[] @relation("ProductoComprobante")
  variantes           ProductoVariante[]

  @@unique([empresaId, codigoEmpresa])
  @@unique([empresaId, sku])
  @@index([empresaId])
  @@index([empresaId, codigoEmpresa])
  @@index([empresaCategoriaId])
  @@index([empresaMarcaId])
  @@index([sedeId])
  @@index([isActive])
  @@index([deletedAt])
  @@index([stock])
  @@index([visibleMarketplace])
  @@index([destacado])
  @@index([ordenMarketplace])
  @@index([enOferta])
  @@index([fechaFinOferta])
}

model Servicio {
  id                    String   @id @default(cuid())
  empresaId             String
  sedeId                String?
  empresaCategoriaId    String?
  codigoEmpresa         String   @unique
  codigoSistema         String   @unique
  nombre                String
  descripcion           String?
  detalles              Json?
  precio                Decimal? @db.Decimal(10, 2)
  precioPorHora         Decimal? @db.Decimal(10, 2)
  duracionMinutos       Int?
  duracionHoras         Decimal? @db.Decimal(5, 2)
  requiereReserva       Boolean  @default(false)
  requiereDeposito      Boolean  @default(false)
  depositoPorcentaje    Decimal? @db.Decimal(5, 2)
  antigenciaMinimaHoras Int?
  videoUrl              String?
  impuestoPorcentaje    Decimal? @db.Decimal(5, 2)
  comisionTecnico       Decimal? @db.Decimal(5, 2)

  // Campos para Marketplace
  visibleMarketplace Boolean @default(true)
  destacado          Boolean @default(false)
  ordenMarketplace   Int?

  // Sistema de Ofertas
  enOferta          Boolean   @default(false)
  precioOferta      Decimal?  @db.Decimal(10, 2)
  fechaInicioOferta DateTime?
  fechaFinOferta    DateTime?

  isActive            Boolean                  @default(true)
  deletedAt           DateTime?
  creadoEn            DateTime                 @default(now())
  actualizadoEn       DateTime                 @updatedAt
  detallesComprobante DetalleComprobante[]     @relation("DetalleServicio")
  empresaCategoria    EmpresaCategoria?        @relation(fields: [empresaCategoriaId], references: [id])
  empresa             Empresa                  @relation(fields: [empresaId], references: [id])
  sede                Sede?                    @relation(fields: [sedeId], references: [id])
  comprobantes        ComprobanteElectronico[] @relation("ServicioComprobante")

  @@unique([empresaId, codigoEmpresa])
  @@index([empresaId])
  @@index([empresaId, codigoEmpresa])
  @@index([empresaCategoriaId])
  @@index([sedeId])
  @@index([isActive])
  @@index([deletedAt])
  @@index([visibleMarketplace])
  @@index([destacado])
  @@index([ordenMarketplace])
  @@index([enOferta])
  @@index([fechaFinOferta])
}

model ConfiguracionCamposServicio {
  id            String            @id @default(cuid())
  empresaId     String
  nombre        String
  tipoCampo     TipoCampoServicio
  categoria     CategoriaCampo?
  descripcion   String?
  placeholder   String?
  esRequerido   Boolean           @default(false)
  defaultValue  String?
  opciones      Json?
  permiteOtro   Boolean           @default(false)
  isActive      Boolean           @default(true)
  orden         Int?
  creadoEn      DateTime          @default(now())
  actualizadoEn DateTime          @updatedAt
  empresa       Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, nombre])
  @@index([empresaId])
  @@index([categoria])
  @@index([isActive])
}

model TipoComponente {
  id                   String              @id @default(cuid())
  empresaId            String?
  nombre               String
  categoria            CategoriaComponente
  descripcion          String?
  datosTecnicos        Json?
  camposPersonalizados Json?
  isActive             Boolean             @default(true)
  esGlobal             Boolean             @default(false)
  creadoEn             DateTime            @default(now())
  actualizadoEn        DateTime            @updatedAt
  componentes          Componente[]
  modelosEquipos       ModeloEquipo[]
  empresa              Empresa?            @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@unique([empresaId, nombre])
  @@index([empresaId])
  @@index([categoria])
  @@index([isActive])
}

model ModeloEquipo {
  id               String          @id @default(cuid())
  empresaId        String?
  tipoComponenteId String
  marca            String
  modelo           String
  especificaciones Json?
  isActive         Boolean         @default(true)
  esGlobal         Boolean         @default(false)
  creadoEn         DateTime        @default(now())
  actualizadoEn    DateTime        @updatedAt
  empresa          Empresa?        @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  tipoComponente   TipoComponente  @relation(fields: [tipoComponenteId], references: [id])
  ordenesServicio  OrdenServicio[]

  @@unique([empresaId, marca, modelo])
  @@index([empresaId])
  @@index([tipoComponenteId])
  @@index([marca])
  @@index([isActive])
}

model Componente {
  id               String               @id @default(cuid())
  empresaId        String
  tipoComponenteId String
  codigo           String               @unique
  marca            String?
  modelo           String?
  numeroSerie      String?              @unique
  especificaciones Json?
  estado           EstadoComponente     @default(INGRESADO)
  ubicacion        String?
  costoCompra      Decimal?             @db.Decimal(10, 2)
  costoReparacion  Decimal?             @db.Decimal(10, 2)
  isActive         Boolean              @default(true)
  deletedAt        DateTime?
  creadoEn         DateTime             @default(now())
  actualizadoEn    DateTime             @updatedAt
  empresa          Empresa              @relation(fields: [empresaId], references: [id])
  tipoComponente   TipoComponente       @relation(fields: [tipoComponenteId], references: [id])
  servicios        ServicioComponente[]

  @@unique([empresaId, codigo])
  @@unique([empresaId, numeroSerie])
  @@index([empresaId])
  @@index([tipoComponenteId])
  @@index([estado])
  @@index([isActive])
  @@index([deletedAt])
}

model OrdenServicio {
  id                  String                  @id @default(cuid())
  empresaId           String
  clienteId           String
  tecnicoId           String?
  sedeId              String?
  codigo              String                  @unique
  tipoServicio        TipoServicio
  prioridad           PrioridadServicio       @default(NORMAL)
  tipoEquipo          String?
  marcaEquipo         String?
  numeroSerie         String?
  modeloEquipoId      String?
  diagnostico         Json?
  descripcionProblema String?
  sintomas            Json?
  presupuesto         Decimal?                @db.Decimal(10, 2)
  tiempoEstimado      Int?
  fechaEntrega        DateTime?
  estado              EstadoOrdenServicio     @default(RECIBIDO)
  estadoDiagnostico   EstadoDiagnostico       @default(PENDIENTE)
  notas               String?
  accesorios          Json?
  condicionEquipo     String?
  comprobanteId       String?
  creadoEn            DateTime                @default(now())
  actualizadoEn       DateTime                @updatedAt
  cliente             EmpresaPersona          @relation("OrdenServicioCliente", fields: [clienteId], references: [id])
  comprobante         ComprobanteElectronico? @relation(fields: [comprobanteId], references: [id])
  empresa             Empresa                 @relation(fields: [empresaId], references: [id])
  modeloEquipo        ModeloEquipo?           @relation(fields: [modeloEquipoId], references: [id])
  tecnico             Usuario?                @relation(fields: [tecnicoId], references: [id])
  componentes         ServicioComponente[]

  @@unique([empresaId, codigo])
  @@index([empresaId])
  @@index([clienteId])
  @@index([tecnicoId])
  @@index([estado])
  @@index([estadoDiagnostico])
  @@index([tipoServicio])
  @@index([fechaEntrega])
}

model ServicioComponente {
  id                String                   @id @default(cuid())
  ordenServicioId   String
  componenteId      String
  tipoAccion        TipoAccionComponente
  estadoComponente  EstadoComponente         @default(INGRESADO)
  descripcionAccion String?
  detallesAccion    Json?
  costoAccion       Decimal?                 @db.Decimal(10, 2)
  tiempoAccion      Int?
  costoRepuestos    Decimal?                 @db.Decimal(10, 2)
  resultadoAccion   String?
  pruebaRealizada   Boolean                  @default(false)
  observaciones     String?
  garantiaMeses     Int?
  fechaGarantia     DateTime?
  creadoEn          DateTime                 @default(now())
  actualizadoEn     DateTime                 @updatedAt
  componente        Componente               @relation(fields: [componenteId], references: [id])
  ordenServicio     OrdenServicio            @relation(fields: [ordenServicioId], references: [id], onDelete: Cascade)
  comprobantes      ComprobanteElectronico[] @relation("ComprobanteComponente")

  @@index([ordenServicioId])
  @@index([componenteId])
  @@index([tipoAccion])
  @@index([estadoComponente])
}

model DireccionPersona {
  id            String        @id @default(cuid())
  personaId     String
  tipo          TipoDireccion
  direccion     String
  referencia    String?
  distrito      String?
  provincia     String?
  departamento  String?
  pais          String?       @default("PERU")
  isActive      Boolean       @default(true)
  deletedAt     DateTime?
  creadoEn      DateTime      @default(now())
  actualizadoEn DateTime      @updatedAt
  persona       Persona       @relation(fields: [personaId], references: [id])

  @@index([personaId])
  @@index([deletedAt])
}

model DireccionSede {
  id            String    @id @default(cuid())
  sedeId        String
  direccion     String
  referencia    String?
  distrito      String?
